    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:narrower com:consejo-educativo ;
    skos:notation "B" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Educación"@es ;
    skos:related com:alcance-b .

com:eficacia-auditoria a skos:Concept ;
    skos:broader com:auditoria-gobierno ;
    skos:inScheme com:esquema ;
    skos:narrower com:auditor-gestion,
        com:responsabilidad-politica ;
    skos:note "Gobierno Municipal"@es ;
    skos:prefLabel "Eficacia"@es .

com:genero a skos:Concept ;
    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:narrower com:oficina-genero ;
    skos:notation "B" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Género"@es ;
    skos:related com:alcance-b .

