        com:garantia-servicios ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Subordinación urbana"@es .

com:transparencia a skos:Concept ;
    skos:broader com:democracia ;
    skos:inScheme com:esquema ;
