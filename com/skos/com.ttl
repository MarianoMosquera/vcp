    skos:narrower com:consejo-concursos,
        com:sindicato ;
    skos:note "Régimen económico financiero"@es ;
    skos:prefLabel "Empleo público"@es .

com:controles-especificos a skos:Concept ;
    skos:broader com:accountability ;
    skos:inScheme com:esquema ;
    skos:narrower com:control-empleo,
        com:control-servicios ;
    skos:prefLabel "Controles específicos"@es .

com:defensor-forma a skos:Concept ;
    skos:broader com:defensor-pueblo ;
    skos:inScheme com:esquema ;
    skos:narrower com:defensor-denuncia,
