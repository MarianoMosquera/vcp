    skos:prefLabel "Audiencia pública"@es ;
    skos:related com:engagement .

com:ciencia-tecnologia-agenda a skos:Concept ;
    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:notation "A" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Ciencia y tecnología"@es ;
    skos:related com:alcance-a,
        com:estado-bienestar .

com:compliance a skos:Concept ;
    skos:broader com:gobernanza ;
    skos:definition """1. Conjunto de estrategias y mecanismos orientados a reducir los riesgos de incumplimiento de los principios y a promover la progresiva adecuación de las prácticas institucionales a los ideales que estos representan.

2. Compromiso de responsabilidad individual e institucional sustentado en la capacidad de implementar las estrategias y mecanismos necesarios para cumplir los principios, reducir los riesgos de incumplimiento y adecuar las prácticas institucionales a los ideales que estos representan.

3. Compromiso de orientar las estrategias y prácticas institucionales hacia el cumplimiento de los principios mediante criterios de eficiencia y eficacia, asegurando la calidad y la oportunidad en función de las circunstancias."""@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:promocion-principios,
        com:reduccion-riesgos ;
    skos:prefLabel "Compliance"@es .

com:concejo-forma a skos:Concept ;
    skos:broader com:concejo-representantes ;
    skos:inScheme com:esquema ;
    skos:narrower com:concejo-denuncia,
        com:concejo-oficio ;
    skos:prefLabel "Forma"@es .

com:concejo-oficio a skos:Concept ;
    skos:broader com:concejo-forma ;
    skos:inScheme com:esquema ;
    skos:narrower com:auditoria-gobierno,
        com:auditorias-especiales ;
    skos:note "Gobierno Municipal"@es ;
    skos:prefLabel "De oficio"@es .

com:control-empleo a skos:Concept ;
