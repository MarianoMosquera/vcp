    skos:prefLabel "Colaboración pública-privada"@es ;
    skos:related com:deporte,
        com:salud,
        com:turismo .

com:carta a skos:Concept ;
    skos:definition "Primera Carta Orgánica Municipal de la ciudad de Villa Carlos Paz, provincia de Córdoba, Argentina, sancionada el 27 de noviembre de 2007 por la Convención Constituyente Municipal, en ejercicio de la autonomía municipal, y vigente desde el 11 de enero de 2008."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:agenda,
        com:gobernanza,
        com:principios ;
    skos:prefLabel "Carta Orgánica Municipal"@es ;
    skos:topConceptOf com:esquema .

com:ciudad-turistica a skos:Concept ;
    skos:broader com:principios ;
    skos:editorialNote "Desde una perspectiva técnico-conceptual, «Ciudad turística» constituye un componente de la agenda municipal antes que un principio propiamente dicho. Sin embargo, la Carta Orgánica Municipal lo identifica expresamente como principio. En el marco de la presente ontología, este concepto funciona como un puente con el principio de sustentabilidad."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:sustentabilidad ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Ciudad turística"@es ;
    skos:related com:etica-politica,
        com:turismo .

com:derechos-humanos a skos:Concept ;
    skos:broader com:etica-politica ;
    skos:definition "Conjunto de derechos fundamentales vinculados con la libertad, la igualdad, la justicia (solidaridad) y la privacidad."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:desarrollo-equilibrado,
        com:estado-bienestar,
        com:municipio-satisfaccion ;
    skos:note "Preámbulo (libertad, igualdad y justicia —solidaridad—). Gobierno municipal (privacidad)."@es ;
    skos:prefLabel "Derechos humanos"@es .

com:desarrollo-urbano-ambiental a skos:Concept ;
    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:narrower com:consejo-planificacion ;
    skos:notation "A",
        "B" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Desarrollo urbano ambiental"@es ;
    skos:related com:alcance-a,
        com:alcance-b .

com:discapacidad a skos:Concept ;
    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:narrower com:area-discapacidad ;
    skos:notation "A",
        "B" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Discapacidad"@es ;
    skos:related com:alcance-a,
        com:alcance-b .

com:gobernanza a skos:Concept ;
    skos:broader com:carta ;
    skos:definition "Conjunto de relaciones y mecanismos de vinculación entre instituciones y actores que permiten organizar y articular el ejercicio del gobierno municipal."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:accountability,
        com:compliance,
        com:engagement ;
    skos:prefLabel "Gobernanza"@es .

com:principios a skos:Concept ;
    skos:broader com:carta ;
    skos:definition "Conjunto de ideales fundamentales que orientan el desarrollo de la comunidad local por intermedio de la organización institucional y el ejercicio del gobierno."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:ciudad-turistica,
        com:democracia,
        com:etica-politica ;
    skos:prefLabel "Principios"@es .

com:seguridad a skos:Concept ;
    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:narrower com:foro ;
    skos:notation "A",
        "B" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Seguridad"@es ;
    skos:related com:alcance-a,
        com:alcance-b .

com:transparencia-activa a skos:Concept ;
    skos:broader com:transparencia ;
    skos:inScheme com:esquema ;
    skos:narrower com:transparencia-justificativa,
        com:transparencia-no-publicitaria,
        com:transparencia-uso ;
    skos:note "Principios de gobierno"@es ;
    skos:prefLabel "Transparencia activa"@es .

com:promocion-principios a skos:Concept ;
    skos:broader com:compliance ;
    skos:inScheme com:esquema ;
    skos:narrower com:competencia-compras,
        com:custodia-informacion,
        com:idoneidad-merito,
        com:pleno-gobierno ;
    skos:prefLabel "Promoción de principios"@es .

com:turismo a skos:Concept ;
    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:narrower com:consejo-politica,
        com:organismo-promocion ;
    skos:notation "C" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Turismo"@es ;
    skos:related com:alcance-c,
        com:ciudad-turistica .

com:democracia a skos:Concept ;
    skos:altLabel "Gobierno de proximidad"@es ;
    skos:broader com:principios ;
    skos:inScheme com:esquema ;
    skos:narrower com:alcance,
        com:descentralizacion,
        com:transparencia ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Democracia participativa y deliberativa"@es ;
    skos:related com:agenda,
        com:etica-politica .

com:etica-politica a skos:Concept ;
    skos:broader com:principios ;
    skos:editorialNote "Se refiere al criterio de considerar de manera equilibrada un conjunto de principios fundamentales."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:derechos-humanos,
        com:identidad,
        com:republica ;
    skos:note "Preámbulo"@es ;
    skos:prefLabel "Ética política"@es ;
    skos:related com:ciudad-turistica,
        com:democracia .

com:alcance-a a skos:Concept ;
    skos:broader com:alcance ;
    skos:inScheme com:esquema ;
    skos:notation "A" ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Ciudadanía o beneficiarios"@es ;
    skos:related com:ciencia-tecnologia-agenda,
        com:cultura,
        com:desarrollo-urbano-ambiental,
        com:discapacidad,
        com:juventud,
        com:seguridad .

com:accountability a skos:Concept ;
    skos:broader com:gobernanza ;
    skos:definition "Conjunto de mecanismos de rendición de cuentas sustentados en procedimientos de control, evaluación y aplicación de sanciones, orientados a garantizar la responsabilidad en el ejercicio del gobierno municipal."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:audiencia-publica,
        com:controles-especificos,
        com:defensor-pueblo,
        com:division-poderes,
        com:indice-desarrollo-local,
        com:presupuesto,
        com:revocatoria ;
    skos:prefLabel "Accountability"@es .

com:estado-bienestar a skos:Concept ;
    skos:broader com:derechos-humanos ;
    skos:editorialNote "Concepto con una fuerte carga ideológica, cuya incorporación a la Carta Orgánica Municipal expresa una determinada orientación sobre la función del Estado en la organización económica y social, particularmente en relación con su responsabilidad en la promoción del bienestar colectivo y su intervención frente a las dinámicas del mercado."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:ciencia-tecnologia-principios,
        com:distorsiones-mercado,
        com:empleo,
        com:productividad-economica,
        com:servicios-publicos-principios ;
    skos:note "Principios de gobierno"@es ;
    skos:prefLabel "Estado de bienestar"@es ;
    skos:related com:ciencia-tecnologia-agenda,
        com:consejo-economico-social-laboral .

com:reduccion-riesgos a skos:Concept ;
    skos:broader com:compliance ;
    skos:inScheme com:esquema ;
    skos:narrower com:abstencion,
        com:declaraciones-patrimoniales,
        com:gastos-reservados,
        com:incompatibilidades,
        com:indelegabilidad,
        com:inhabilidades,
        com:maximo-deuda ;
    skos:prefLabel "Reducción de riesgos"@es .

com:engagement a skos:Concept ;
    skos:broader com:gobernanza ;
    skos:definition "Conjunto de mecanismos de vinculación e interacción entre el gobierno municipal, la ciudadanía y sus diversas expresiones, sustentados en criterios de inclusión y pluralidad."@es ;
    skos:editorialNote "El engagement presenta un carácter predominantemente propositivo, orientado a la generación de iniciativas, a diferencia de los mecanismos de accountability."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:banca-ciudadano,
        com:consulta-no-vinculante,
        com:iniciativa-popular,
        com:plan-riesgo,
        com:planificacion-estrategica,
        com:referendo-vinculante ;
    skos:prefLabel "Engagement"@es ;
    skos:related com:audiencia-publica,
        com:presupuesto .

com:alcance-b a skos:Concept ;
    skos:broader com:alcance ;
    skos:inScheme com:esquema ;
    skos:narrower com:centros-vecinales ;
    skos:notation "B" ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Instituciones"@es ;
    skos:related com:deporte,
        com:desarrollo-economico-social-laboral,
        com:desarrollo-urbano-ambiental,
        com:discapacidad,
        com:educacion,
        com:genero,
        com:seguridad,
        com:vivienda-tierras .

com:agenda a skos:Concept ;
    skos:broader com:carta ;
    skos:definition "Conjunto de temas prioritarios definidos por su especial relevancia para el desarrollo de la comunidad local y su importancia en el marco de la Carta Orgánica Municipal, que se expresan generalmente mediante políticas especiales y pueden estar atravesados por el diseño de instituciones específicas."@es ;
    skos:editorialNote "Este concepto comprende exclusivamente aquellas áreas temáticas de la Carta Orgánica que presentan algún tipo de vinculación con el principio de democracia participativa y deliberativa. Las notaciones A, B y C asignadas a las áreas temáticas de Agenda remiten a las categorías de Alcance definidas en el principio de democracia participativa y deliberativa. Estas notaciones permiten identificar la vinculación de cada área temática con una o más categorías de Alcance de dicho principio. skos:notation identifica esas vinculaciones."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:ciencia-tecnologia-agenda,
        com:cultura,
        com:deporte,
        com:desarrollo-economico-social-laboral,
        com:desarrollo-urbano-ambiental,
        com:discapacidad,
        com:educacion,
        com:genero,
        com:juventud,
        com:salud,
        com:seguridad,
        com:turismo,
        com:vivienda-tierras ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Agenda"@es ;
    skos:related com:democracia .

com:esquema a skos:ConceptScheme ;
    skos:hasTopConcept com:carta ;
    skos:prefLabel "Carta Orgánica Municipal"@es .

