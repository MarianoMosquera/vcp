com:municipio-satisfaccion a skos:Concept ;
    skos:broader com:derechos-humanos ;
    skos:editorialNote "Constituye la única referencia significativa de la Carta Orgánica Municipal a la incorporación de criterios de racionalidad objetiva en la gestión pública. Este enfoque, desarrollado en otros contextos bajo el paradigma de las políticas públicas basadas en evidencia, encuentra en esta disposición su única expresión relevante dentro de la Carta Orgánica."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:censos-sociales ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Municipio como satisfacción de necesidades"@es .

