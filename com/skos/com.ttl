    skos:note "Organismos de control"@es ;
    skos:prefLabel "Defensor del Pueblo"@es .

com:deporte a skos:Concept ;
    skos:broader com:agenda ;
    skos:inScheme com:esquema ;
    skos:notation "B",
        "C" ;
    skos:note "Políticas especiales y para la ciudad"@es ;
    skos:prefLabel "Deporte"@es ;
    skos:related com:alcance-b,
        com:alcance-c .

com:desarrollo-economico-social-laboral a skos:Concept ;
    skos:broader com:agenda ;
    skos:editorialNote "El área temática Desarrollo económico, social y laboral no se encuentra expresamente identificada dentro de las políticas especiales de la Carta Orgánica. Su incorporación en la presente ontología responde a la necesidad de organizar jerárquicamente al Consejo Económico Social y Laboral, institución expresamente contemplada en dicha Carta."@es ;
    skos:inScheme com:esquema ;
    skos:narrower com:consejo-economico-social-laboral ;
    skos:notation "B" ;
    skos:prefLabel "Desarrollo económico, social y laboral"@es ;
    skos:related com:alcance-b .

com:desarrollo-equilibrado a skos:Concept ;
    skos:broader com:derechos-humanos ;
    skos:inScheme com:esquema ;
    skos:narrower com:obras-interes,
        com:zonificacion-regionalizacion ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Desarrollo equilibrado de la ciudad"@es .

com:descentralizacion a skos:Concept ;
    skos:broader com:democracia ;
    skos:inScheme com:esquema ;
    skos:narrower com:eficacia-descentralizacion,
        com:eficiencia-descentralizacion ;
    skos:note "Declaración de principios"@es ;
    skos:prefLabel "Descentralización"@es .

com:distorsiones-mercado a skos:Concept ;
    skos:broader com:estado-bienestar ;
