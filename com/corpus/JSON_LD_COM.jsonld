  ],
  "co:articulos": [
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/1",
      "@type": "co:Articulo",
      "identifier": "1",
      "name": "Artículo 1",
      "position": 1,
      "text": "El Municipio de la Ciudad de Villa Carlos Paz crea su  Carta Orgánica en un todo acorde a los\nlineamientos fijados por la Constitución Nacional, los Tratados Internacionales con rango constitucional y la\nConstitución de la Provincia de Córdoba.  Esta Carta Orgánica y las ordenanzas que en su consecuencia se dicten\nson normas fundamentales del Municipio y prevalecen en caso de competencia concurrente con la Provincia o la\nNación, siempre que las respectivas Constituciones no lo prohíban taxativamente.-\n\n",
      "co:inicioCaracter": 5341,
      "co:finCaracter": 5861,
      "co:inicioTexto": 5353,
      "co:finTexto": 5861,
      "co:caracteresTexto": 508,
      "co:marcadorArticulo": "Artículo 1: ",
      "co:encabezadoPrevioLiteral": "###### PRELACIÓN NORMATIVA\n",
      "co:inicioEncabezado": 5314,
      "co:finEncabezado": 5341,
      "co:epigrafe": "PRELACIÓN NORMATIVA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/2",
      "@type": "co:Articulo",
      "identifier": "2",
      "name": "Artículo 2",
      "position": 2,
      "text": "El Municipio de la Ciudad de Villa Carlos Paz constituye una unidad territorial, poblacional, cultural,\npolítica y jurídica fundada en la convivencia social, con la participación de la sociedad y decisión del gobierno en la\ndefinición y satisfacción de las necesidades del conjunto.-\n\n",
      "co:inicioCaracter": 5879,
      "co:finCaracter": 6176,
      "co:inicioTexto": 5891,
      "co:finTexto": 6176,
      "co:caracteresTexto": 285,
      "co:marcadorArticulo": "Artículo 2: ",
      "co:encabezadoPrevioLiteral": "###### MUNICIPIO.\n",
      "co:inicioEncabezado": 5861,
      "co:finEncabezado": 5879,
      "co:epigrafe": "MUNICIPIO.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/3",
      "@type": "co:Articulo",
      "identifier": "3",
      "name": "Artículo 3",
      "position": 3,
      "text": "El Municipio de la Ciudad de Villa Carlos Paz dicta esta Carta Orgánica en ejercicio de la autonomía que\nle es propia en el orden institucional, político, administrativo, económico y financiero. En el ejercicio de sus\natribuciones, no se sujeta a otro poder y ejerce todas las funciones que le competen de conformidad con su\nnaturaleza y fines.-\n\n",
      "co:inicioCaracter": 6194,
      "co:finCaracter": 6553,
      "co:inicioTexto": 6206,
      "co:finTexto": 6553,
      "co:caracteresTexto": 347,
      "co:marcadorArticulo": "Artículo 3: ",
      "co:encabezadoPrevioLiteral": "###### AUTONOMÍA.\n",
      "co:inicioEncabezado": 6176,
      "co:finEncabezado": 6194,
      "co:epigrafe": "AUTONOMÍA.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/4",
      "@type": "co:Articulo",
      "identifier": "4",
      "name": "Artículo 4",
      "position": 4,
      "text": "El Municipio de la Ciudad de Villa Carlos Paz organiza su gobierno bajo la forma representativa,\nrepublicana y democrática.\n\n",
      "co:inicioCaracter": 6589,
      "co:finCaracter": 6726,
      "co:inicioTexto": 6601,
      "co:finTexto": 6726,
      "co:caracteresTexto": 125,
      "co:marcadorArticulo": "Artículo 4: ",
      "co:encabezadoPrevioLiteral": "###### ORGANIZACIÓN INSTITUCIONAL\n\n\n",
      "co:inicioEncabezado": 6553,
      "co:finEncabezado": 6589,
      "co:epigrafe": "ORGANIZACIÓN INSTITUCIONAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/5",
      "@type": "co:Articulo",
      "identifier": "5",
      "name": "Artículo 5",
      "position": 5,
      "text": "La soberanía reside en el pueblo, quien la ejerce a través de sus representantes y demás autoridades\nlegítimamente constituidas, salvo los supuestos de participación ciudadana que esta Carta Orgánica establece.-\n\n",
      "co:inicioCaracter": 6752,
      "co:finCaracter": 6977,
      "co:inicioTexto": 6764,
      "co:finTexto": 6977,
      "co:caracteresTexto": 213,
      "co:marcadorArticulo": "Artículo 5: ",
      "co:encabezadoPrevioLiteral": "###### SOBERANÍA POPULAR.\n",
      "co:inicioEncabezado": 6726,
      "co:finEncabezado": 6752,
      "co:epigrafe": "SOBERANÍA POPULAR.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/6",
      "@type": "co:Articulo",
      "identifier": "6",
      "name": "Artículo 6",
      "position": 6,
      "text": "La Carta Orgánica no pierde vigencia aun cuando por actos violentos o de cualquier naturaleza se llegue\na interrumpir su observancia. Quienes ordenen, consientan o ejecuten actos de esta índole son considerados infames\ntraidores al orden institucional.\nLos que en este caso ejerzan  las funciones previstas para  las autoridades de  esta Carta Orgánica, de  las\nConstituciones de la Nación y la Provincia, quedan inhabilitados a perpetuidad para ocupar cargos del Municipio.\nCualquier disposición adoptada por las autoridades en presencia o a requerimiento de fuerza armada o actividad\nsediciosa que se atribuya los derechos del pueblo, es insanablemente nula.\nEs deber de todo ciudadano contribuir al restablecimiento de la efectiva vigencia del orden constitucional y de las\nautoridades legítimas; le asiste al pueblo de la ciudad el derecho de resistencia civil, cuando no sea posible otro\nrecurso.-\n\n",
      "co:inicioCaracter": 7013,
      "co:finCaracter": 7929,
      "co:inicioTexto": 7025,
      "co:finTexto": 7929,
      "co:caracteresTexto": 904,
      "co:marcadorArticulo": "Artículo 6: ",
      "co:encabezadoPrevioLiteral": "###### DEFENSA DE LA CARTA ORGÁNICA\n",
      "co:inicioEncabezado": 6977,
      "co:finEncabezado": 7013,
      "co:epigrafe": "DEFENSA DE LA CARTA ORGÁNICA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/7",
      "@type": "co:Articulo",
      "identifier": "7",
      "name": "Artículo 7",
      "position": 7,
      "text": "Las funciones del Municipio son irrenunciables. Ninguna autoridad municipal puede delegar sus\nfunciones en otra persona, ni un departamento de gobierno en otro sus atribuciones, salvo en los casos previstos en\nesta Carta Orgánica. Es insanablemente nulo cualquier acto que se celebre en consecuencia.\n\n",
      "co:inicioCaracter": 7952,
      "co:finCaracter": 8266,
      "co:inicioTexto": 7964,
      "co:finTexto": 8266,
      "co:caracteresTexto": 302,
      "co:marcadorArticulo": "Artículo 7: ",
      "co:encabezadoPrevioLiteral": "###### INDELEGABILIDAD\n",
      "co:inicioEncabezado": 7929,
      "co:finEncabezado": 7952,
      "co:epigrafe": "INDELEGABILIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/8",
      "@type": "co:Articulo",
      "identifier": "8",
      "name": "Artículo 8",
      "position": 8,
      "text": "Se suprimen en los actos y documentos oficiales todos los  títulos honoríficos de los funcionarios y\ncuerpos colegiados.-\n\n",
      "co:inicioCaracter": 8294,
      "co:finCaracter": 8429,
      "co:inicioTexto": 8306,
      "co:finTexto": 8429,
      "co:caracteresTexto": 123,
      "co:marcadorArticulo": "Artículo 8: ",
      "co:encabezadoPrevioLiteral": "###### SUPRESIÓN DE TÍTULOS\n",
      "co:inicioEncabezado": 8266,
      "co:finEncabezado": 8294,
      "co:epigrafe": "SUPRESIÓN DE TÍTULOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/9",
      "@type": "co:Articulo",
      "identifier": "9",
      "name": "Artículo 9",
      "position": 9,
      "text": "En caso de intervención, las obligaciones contraídas solo comprometerán  al Municipio cuando sus\nactos jurídicos se realicen conforme a lo dispuesto por esta   Carta Orgánica. Los nombramientos que se efectúen\nson transitorios y cesan al concluir la intervención.-\n\n",
      "co:inicioCaracter": 8449,
      "co:finCaracter": 8727,
      "co:inicioTexto": 8461,
      "co:finTexto": 8727,
      "co:caracteresTexto": 266,
      "co:marcadorArticulo": "Artículo 9: ",
      "co:encabezadoPrevioLiteral": "###### INTERVENCIÓN\n",
      "co:inicioEncabezado": 8429,
      "co:finEncabezado": 8449,
      "co:epigrafe": "INTERVENCIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/10",
      "@type": "co:Articulo",
      "identifier": "10",
      "name": "Artículo 10",
      "position": 10,
      "text": "El Municipio declara al turismo como una actividad fundamental, estratégica y de vital importancia\npara el desarrollo de la ciudad, asegurando su explotación racional a fin de preservar el ambiente. Define políticas\ndestinadas al sector por sí y en concurrencia con organismos provinciales, nacionales e internacionales.\nComo ciudad turística, el Municipio deberá coordinar sus políticas, planes y gestiones con los municipios de la\nregión, de modo que permita resolver problemas comunes y favorecer el desarrollo equilibrado del conjunto, todo\nello sin perjuicio de las facultades establecidas en la presente Carta Orgánica, de asociarse, concertar y convenir con\notros órganos públicos y privados.\n\n",
      "co:inicioCaracter": 8751,
      "co:finCaracter": 9465,
      "co:inicioTexto": 8764,
      "co:finTexto": 9465,
      "co:caracteresTexto": 701,
      "co:marcadorArticulo": "Artículo 10: ",
      "co:encabezadoPrevioLiteral": "###### CIUDAD TURÍSTICA\n",
      "co:inicioEncabezado": 8727,
      "co:finEncabezado": 8751,
      "co:epigrafe": "CIUDAD TURÍSTICA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/11",
      "@type": "co:Articulo",
      "identifier": "11",
      "name": "Artículo 11",
      "position": 11,
      "text": "El Municipio protege al ambiente contra cualquier forma de depredación, destrucción o contaminación.\nLa prevención del daño ambiental y la recomposición del ambiente dañado por las actividades humanas es deber\nindelegable de aquél.\nEjerce con carácter pleno e  irrenunciable  las acciones relativas a la protección ambiental.\nEl Concejo de Representantes dicta el Código de Medio Ambiente.\n\n",
      "co:inicioCaracter": 9497,
      "co:finCaracter": 9901,
      "co:inicioTexto": 9510,
      "co:finTexto": 9901,
      "co:caracteresTexto": 391,
      "co:marcadorArticulo": "Artículo 11: ",
      "co:encabezadoPrevioLiteral": "###### AMBIENTE - NORMA GENERAL\n",
      "co:inicioEncabezado": 9465,
      "co:finEncabezado": 9497,
      "co:epigrafe": "AMBIENTE - NORMA GENERAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/12",
      "@type": "co:Articulo",
      "identifier": "12",
      "name": "Artículo 12",
      "position": 12,
      "text": "El ambiente es patrimonio de la sociedad. Es obligación del Municipio preservar, conservar y mejorar\nel suelo, el agua, el aire, la flora y la fauna dentro del territorio de su competencia. Las políticas en este sentido se\nsustentan en las necesidades y conveniencias actuales y como expresión de solidaridad activa con las próximas\ngeneraciones.\nSe prohíbe la aprobación o desarrollo de cualquier proyecto urbanístico que no se subordine a estos principios\nambientales, al balance energético de la ciudad y que no contemple la previsión y garantía de los servicios.\n\n\n",
      "co:inicioCaracter": 9930,
      "co:finCaracter": 10512,
      "co:inicioTexto": 9943,
      "co:finTexto": 10512,
      "co:caracteresTexto": 569,
      "co:marcadorArticulo": "Artículo 12: ",
      "co:encabezadoPrevioLiteral": "###### MUNICIPIO SUSTENTABLE\n",
      "co:inicioEncabezado": 9901,
      "co:finEncabezado": 9930,
      "co:epigrafe": "MUNICIPIO SUSTENTABLE",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/13",
      "@type": "co:Articulo",
      "identifier": "13",
      "name": "Artículo 13",
      "position": 13,
      "text": "El Municipio, con la participación permanente de la comunidad y a través de exenciones tributarias,\ninstrumenta acciones tendientes a incentivar la protección del medio ambiente\n\n",
      "co:inicioCaracter": 10528,
      "co:finCaracter": 10720,
      "co:inicioTexto": 10541,
      "co:finTexto": 10720,
      "co:caracteresTexto": 179,
      "co:marcadorArticulo": "Artículo 13: ",
      "co:encabezadoPrevioLiteral": "###### ACCIONES\n",
      "co:inicioEncabezado": 10512,
      "co:finEncabezado": 10528,
      "co:epigrafe": "ACCIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/14",
      "@type": "co:Articulo",
      "identifier": "14",
      "name": "Artículo 14",
      "position": 14,
      "text": "El Municipio de Villa Carlos Paz, ciudad turística serrana, declara que los faldeos de las sierras, los\nbosques autóctonos, las costas del lago,  incluyendo su espejo de agua y los ríos que la atraviesan, constituyen sus\nrecursos naturales y   turísticos y deben ser protegidos  por ordenanzas y por convenios con  Municipios o\nComunas, Provincia y Nación.  El Municipio tiene la obligación de custodiar el ambiente de la cuenca y  laderas de\nlos cordones montañosos y la de no causar e impedir  cualquier perjuicio sensible a sus aguas, lecho, subsuelo y a la\nflora y fauna que en ellas habiten.\n\n",
      "co:inicioCaracter": 10753,
      "co:finCaracter": 11364,
      "co:inicioTexto": 10766,
      "co:finTexto": 11364,
      "co:caracteresTexto": 598,
      "co:marcadorArticulo": "Artículo 14: ",
      "co:encabezadoPrevioLiteral": "###### LADERAS, COSTAS Y RIBERAS\n",
      "co:inicioEncabezado": 10720,
      "co:finEncabezado": 10753,
      "co:epigrafe": "LADERAS, COSTAS Y RIBERAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/15",
      "@type": "co:Articulo",
      "identifier": "15",
      "name": "Artículo 15",
      "position": 15,
      "text": "El Municipio debe preservar y proteger los bosques serranos urbanos y suburbanos, que constituyen\náreas de alto valor ecológico con  potencial de desarrollo recreativo, educativo y turístico, para el esparcimiento y\nbeneficio de la generaciones presentes y futuras.\nCuida los bosques protectores  y permanentes a fin de preservar su calidad de tales. Queda expresamente prohibido\nel uso extractivo de los bosques nativos urbanos y suburbanos.\n\n",
      "co:inicioCaracter": 11395,
      "co:finCaracter": 11852,
      "co:inicioTexto": 11408,
      "co:finTexto": 11852,
      "co:caracteresTexto": 444,
      "co:marcadorArticulo": "Artículo 15: ",
      "co:encabezadoPrevioLiteral": "###### BOSQUES NATIVOS URBANOS\n",
      "co:inicioEncabezado": 11364,
      "co:finEncabezado": 11395,
      "co:epigrafe": "BOSQUES NATIVOS URBANOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/16",
      "@type": "co:Articulo",
      "identifier": "16",
      "name": "Artículo 16",
      "position": 16,
      "text": "El territorio del Municipio es zona protegida. No pueden radicarse en él centrales, reservorios,\nbasureros o industrias nucleares ni de cualquier otro tipo afín; se prohíbe la radicación de cualquier empresa de\nfabricación, fraccionamiento ó depósito de material bélico;  se prohíbe la generación, la manipulación, el uso, la\nproducción o el transporte de sustancias tóxicas, insumos nucleares o residuos peligrosos que pudieren poner en\npeligro la salud y el ecosistema\n\n",
      "co:inicioCaracter": 11874,
      "co:finCaracter": 12359,
      "co:inicioTexto": 11887,
      "co:finTexto": 12359,
      "co:caracteresTexto": 472,
      "co:marcadorArticulo": "Artículo 16: ",
      "co:encabezadoPrevioLiteral": "###### ZONA PROTEGIDA\n",
      "co:inicioEncabezado": 11852,
      "co:finEncabezado": 11874,
      "co:epigrafe": "ZONA PROTEGIDA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/17",
      "@type": "co:Articulo",
      "identifier": "17",
      "name": "Artículo 17",
      "position": 17,
      "text": "El Municipio establece y reconoce ámbitos e instituciones de participación y deliberación con el\npropósito de mejorar la calidad de las decisiones de los representantes y promueve su acceso a todos los ciudadanos,\ninstituciones intermedias y en particular a las de orden vecinal. Todas las disposiciones de esta Carta Orgánica\ndeben interpretarse en un modo favorable a aquéllas.\n\n",
      "co:inicioCaracter": 12406,
      "co:finCaracter": 12800,
      "co:inicioTexto": 12419,
      "co:finTexto": 12800,
      "co:caracteresTexto": 381,
      "co:marcadorArticulo": "Artículo 17: ",
      "co:encabezadoPrevioLiteral": "###### DEMOCRACIA PARTICIPATIVA Y DELIBERATIVA\n",
      "co:inicioEncabezado": 12359,
      "co:finEncabezado": 12406,
      "co:epigrafe": "DEMOCRACIA PARTICIPATIVA Y DELIBERATIVA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/18",
      "@type": "co:Articulo",
      "identifier": "18",
      "name": "Artículo 18",
      "position": 18,
      "text": "La transferencia al Municipio de competencias propias de las jurisdicciones  nacional o provincial,\ndeberá ser acompañada de los recursos necesarios para poder cumplimentar con eficacia social las políticas públicas\ncorrespondientes.-\n\n",
      "co:inicioCaracter": 12841,
      "co:finCaracter": 13090,
      "co:inicioTexto": 12854,
      "co:finTexto": 13090,
      "co:caracteresTexto": 236,
      "co:marcadorArticulo": "Artículo 18: ",
      "co:encabezadoPrevioLiteral": "###### DESCENTRALIZACIÓN DE COMPETENCIAS\n",
      "co:inicioEncabezado": 12800,
      "co:finEncabezado": 12841,
      "co:epigrafe": "DESCENTRALIZACIÓN DE COMPETENCIAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/19",
      "@type": "co:Articulo",
      "identifier": "19",
      "name": "Artículo 19",
      "position": 19,
      "text": "El Municipio es gobernado y administrado coordinando los principios de centralización normativa,\ndescentralización  territorial y desconcentración operativa, con el objeto de promover la participación ciudadana y\nla aplicación de una política municipal igualitaria orientadas a lograr el mayor nivel de eficiencia y eficacia,  la\ncorrección de los desequilibrios y la satisfacción de los intereses de las diferentes zonas y barrios de la ciudad.\n",
      "co:inicioCaracter": 13134,
      "co:finCaracter": 13593,
      "co:inicioTexto": 13147,
      "co:finTexto": 13593,
      "co:caracteresTexto": 446,
      "co:marcadorArticulo": "Artículo 19: ",
      "co:encabezadoPrevioLiteral": "###### DESCENTRALIZACIÓN Y DESCONCENTRACIÓN\n",
      "co:inicioEncabezado": 13090,
      "co:finEncabezado": 13134,
      "co:epigrafe": "DESCENTRALIZACIÓN Y DESCONCENTRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/20",
      "@type": "co:Articulo",
      "identifier": "20",
      "name": "Artículo 20",
      "position": 20,
      "text": "La Carta Orgánica es de aplicación en el territorio de la Ciudad de Villa Carlos Paz, con los límites que\npor ley le corresponden, donde el Municipio ejerce las funciones, atribuciones y finalidades inherentes a su\ncompetencia material.-\n\n",
      "co:inicioCaracter": 13681,
      "co:finCaracter": 13933,
      "co:inicioTexto": 13694,
      "co:finTexto": 13933,
      "co:caracteresTexto": 239,
      "co:marcadorArticulo": "Artículo 20: ",
      "co:encabezadoPrevioLiteral": "###### ÁMBITO DE APLICACIÓN - COMPETENCIAS\n",
      "co:inicioEncabezado": 13638,
      "co:finEncabezado": 13681,
      "co:epigrafe": "ÁMBITO DE APLICACIÓN - COMPETENCIAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/21",
      "@type": "co:Articulo",
      "identifier": "21",
      "name": "Artículo 21",
      "position": 21,
      "text": "Mediante ordenanza aprobada por mayoría agravada y ratificada por ley provincial y referéndum, la\nMunicipalidad podrá fusionarse con otros Municipios o Comunas.-\n\n",
      "co:inicioCaracter": 13974,
      "co:finCaracter": 14150,
      "co:inicioTexto": 13987,
      "co:finTexto": 14150,
      "co:caracteresTexto": 163,
      "co:marcadorArticulo": "Artículo 21: ",
      "co:encabezadoPrevioLiteral": "###### FUSIÓN CON MUNICIPIOS Y/O COMUNAS\n",
      "co:inicioEncabezado": 13933,
      "co:finEncabezado": 13974,
      "co:epigrafe": "FUSIÓN CON MUNICIPIOS Y/O COMUNAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/22",
      "@type": "co:Articulo",
      "identifier": "22",
      "name": "Artículo 22",
      "position": 22,
      "text": "El ejercicio del poder de policía que los Gobiernos Nacional o  Provincial pudieren delegar en el\nMunicipio en  las zonas no  sujetas a su jurisdicción  territorial, se ejerce mediante convenio  ratificado por\nordenanza.\nEn los establecimientos o espacios de jurisdicción Nacional o Provincial que se encuentren en su territorio,  ejerce\nel poder de policía, de imposición y las demás potestades municipales que no interfieran en el cumplimiento de los\nfines específicos de aquéllos.-\n\n",
      "co:inicioCaracter": 14176,
      "co:finCaracter": 14675,
      "co:inicioTexto": 14189,
      "co:finTexto": 14675,
      "co:caracteresTexto": 486,
      "co:marcadorArticulo": "Artículo 22: ",
      "co:encabezadoPrevioLiteral": "###### PODER DE POLICÍA\n\n\n",
      "co:inicioEncabezado": 14150,
      "co:finEncabezado": 14176,
      "co:epigrafe": "PODER DE POLICÍA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/23",
      "@type": "co:Articulo",
      "identifier": "23",
      "name": "Artículo 23",
      "position": 23,
      "text": "El Municipio de la Ciudad de Villa Carlos Paz ejerce todas las funciones, atribuciones y finalidades que\nestablece la Constitución Provincial, esta Carta Orgánica Municipal  y todas las acciones de gobierno que hagan al\nbien común y progreso de la ciudad.-\n\n",
      "co:inicioCaracter": 14703,
      "co:finCaracter": 14974,
      "co:inicioTexto": 14716,
      "co:finTexto": 14974,
      "co:caracteresTexto": 258,
      "co:marcadorArticulo": "Artículo 23: ",
      "co:encabezadoPrevioLiteral": "###### COMPETENCIA MATERIAL\n",
      "co:inicioEncabezado": 14675,
      "co:finEncabezado": 14703,
      "co:epigrafe": "COMPETENCIA MATERIAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/24",
      "@type": "co:Articulo",
      "identifier": "24",
      "name": "Artículo 24",
      "position": 24,
      "text": "El Municipio adopta el nombre Villa Carlos Paz, denominación que deberá ser utilizada en todos los\ndocumentos, instrumentos públicos, actos y monumentos oficiales. Conforme a los antecedentes históricos, reconoce\ncomo fecha de su fundación el día 16 de julio de 1913. El escudo, símbolo que identifica la Ciudad, es de uso\nobligatorio en toda  documentación, papeles oficiales, sellos, vehículos afectados al uso público y en el frente de los\nedificios municipales, prohibiéndose la utilización oficial de cualquier otro símbolo o leyenda. Su descripción es la\nsiguiente: de sinople tres fajas de platas ondeadas y en jefe, dos espadas de su color puestas en sotuer, bordura de\ngules, cargadas de ocho torres de oro, el escudo timbrado de un sol de oro. La forma del escudo es cuadrilonga, con\nla parte inferior redondeada, sus proporciones seis por cinco, de modo tal que la sexta parte de la altura cabe cinco\nveces en el ancho.-\n",
      "co:inicioCaracter": 15015,
      "co:finCaracter": 15960,
      "co:inicioTexto": 15028,
      "co:finTexto": 15960,
      "co:caracteresTexto": 932,
      "co:marcadorArticulo": "Artículo 24: ",
      "co:encabezadoPrevioLiteral": "###### DENOMINACIÓN - FUNDACIÓN - ESCUDO\n",
      "co:inicioEncabezado": 14974,
      "co:finEncabezado": 15015,
      "co:epigrafe": "DENOMINACIÓN - FUNDACIÓN - ESCUDO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/25",
      "@type": "co:Articulo",
      "identifier": "25",
      "name": "Artículo 25",
      "position": 25,
      "text": "Todos los habitantes de la ciudad de Villa Carlos Paz gozan de los derechos y garantías contemplados\nen la Constitución de la Nación Argentina, en los Tratados Internacionales de jerarquía constitucional y en la\nConstitución de la Provincia de Córdoba, sin perjuicio de aquellos expresamente reconocidos y consagrados en la\npresente Carta Orgánica.\n\n",
      "co:inicioCaracter": 16156,
      "co:finCaracter": 16519,
      "co:inicioTexto": 16169,
      "co:finTexto": 16519,
      "co:caracteresTexto": 350,
      "co:marcadorArticulo": "Artículo 25: ",
      "co:encabezadoPrevioLiteral": "###### DERECHOS Y GARANTÍAS\n",
      "co:inicioEncabezado": 16128,
      "co:finEncabezado": 16156,
      "co:epigrafe": "DERECHOS Y GARANTÍAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/26",
      "@type": "co:Articulo",
      "identifier": "26",
      "name": "Artículo 26",
      "position": 26,
      "text": "Todos los habitantes gozan del derecho a la ciudad. Éste comprende el derecho al lugar, al espacio\npúblico, a la monumentalidad, a la dimensión estética, a la identidad colectiva dentro de la ciudad, a la movilidad\nfísica, a la accesibilidad, a la centralidad, a un gobierno de proximidad, a la innovación política, al acceso y uso de\nlas tecnologías de información y comunicación, a un desarrollo urbano equitativo y sustentable, a la intimidad y a la\nelección de los vínculos personales.\n\n",
      "co:inicioCaracter": 16543,
      "co:finCaracter": 17047,
      "co:inicioTexto": 16556,
      "co:finTexto": 17047,
      "co:caracteresTexto": 491,
      "co:marcadorArticulo": "Artículo 26: ",
      "co:encabezadoPrevioLiteral": "###### DERECHOS URBANOS\n",
      "co:inicioEncabezado": 16519,
      "co:finEncabezado": 16543,
      "co:epigrafe": "DERECHOS URBANOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/27",
      "@type": "co:Articulo",
      "identifier": "27",
      "name": "Artículo 27",
      "position": 27,
      "text": "El Municipio reconoce a sus habitantes el derecho de peticionar y a obtener pronta, escrita y fundada\nresolución de sus solicitudes y reclamos.\nLa ordenanza establece el procedimiento para ejercer este derecho, fijando  restricciones para su ejercicio.\n\n",
      "co:inicioCaracter": 17086,
      "co:finCaracter": 17353,
      "co:inicioTexto": 17099,
      "co:finTexto": 17353,
      "co:caracteresTexto": 254,
      "co:marcadorArticulo": "Artículo 27: ",
      "co:encabezadoPrevioLiteral": "###### ACCESO A LA INFORMACIÓN PÚBLICA\n",
      "co:inicioEncabezado": 17047,
      "co:finEncabezado": 17086,
      "co:epigrafe": "ACCESO A LA INFORMACIÓN PÚBLICA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/28",
      "@type": "co:Articulo",
      "identifier": "28",
      "name": "Artículo 28",
      "position": 28,
      "text": "Los  habitantes del Municipio tienen las siguientes obligaciones:\na-      Cumplir con esta Carta Orgánica y las ordenanzas que en su consecuencia se dicten.\nb-      Respetar y defender la ciudad, su integridad territorial y su autonomía municipal.\n\n\nc-       Sufragar y participar en la vida ciudadana; actuar solidariamente en la vida comunitaria.\nd-      Conservar y proteger los intereses y el patrimonio turístico, ambiental, histórico y cultural.\ne-       Contribuir equitativa y proporcionalmente con los gastos y cumplir con los tributos impuestos por el\nMunicipio.\nf-        Preservar el ambiente, evitar su contaminación, participar en la defensa ecológica y  reparar los daños\ncausados.\ng-      Cuidar la salud pública.\nh-       Evitar toda forma de discriminación.\ni-        Prestar servicios civiles por razones de seguridad y solidaridad.\nj-       Colaborar en la concientización turística.\n\n",
      "co:inicioCaracter": 17368,
      "co:finCaracter": 18286,
      "co:inicioTexto": 17381,
      "co:finTexto": 18286,
      "co:caracteresTexto": 905,
      "co:marcadorArticulo": "Artículo 28: ",
      "co:encabezadoPrevioLiteral": "###### DEBERES\n",
      "co:inicioEncabezado": 17353,
      "co:finEncabezado": 17368,
      "co:epigrafe": "DEBERES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/29",
      "@type": "co:Articulo",
      "identifier": "29",
      "name": "Artículo 29",
      "position": 29,
      "text": "Los derechos  y garantías reconocidos en esta Carta Orgánica son de aplicación operativa inmediata,\nsalvo cláusula expresa que indique su reglamentación. No pueden ser negados ni limitados por la omisión de su\nreglamentación. La enumeración de estos derechos y garantías no es entendida como negación de otros que se\nderivan de la forma democrática de gobierno y del principio de soberanía popular.\n",
      "co:inicioCaracter": 18341,
      "co:finCaracter": 18753,
      "co:inicioTexto": 18354,
      "co:finTexto": 18753,
      "co:caracteresTexto": 399,
      "co:marcadorArticulo": "Artículo 29: ",
      "co:encabezadoPrevioLiteral": "###### DERECHOS Y DEBERES NO ENUMERADOS - OPERATIVIDAD\n",
      "co:inicioEncabezado": 18286,
      "co:finEncabezado": 18341,
      "co:epigrafe": "DERECHOS Y DEBERES NO ENUMERADOS - OPERATIVIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/1"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/30",
      "@type": "co:Articulo",
      "identifier": "30",
      "name": "Artículo 30",
      "position": 30,
      "text": "Los  actos de gobierno del Municipio son públicos. Se difunden mediante Boletín Oficial Municipal\ntodas las ordenanzas, decretos, resoluciones,  la memoria anual e informe del Defensor del Pueblo y demás\ndisposiciones, como así también un estado de ingresos y egresos con cuadro de disponibilidades, altas y bajas del\npersonal, el que deberá publicarse al menos una vez por mes. Será puesto a disposición de la población en forma\ngratuita en lugares públicos de la Municipalidad, otros lugares de acceso público e Internet. Anualmente se publicará\nuna memoria sobre la labor desarrollada y una rendición de cuentas del ejercicio. La información pública se realiza\ncon fines informativos, educativos y de prevención y no debe tener finalidad partidaria o electoral.\nQueda prohibida la publicidad oficial de actos de gobierno, durante el período comprendido dentro de los treinta\n(30) días anteriores al acto eleccionario municipal. La ordenanza regula las excepciones fundadas en el interés\ngeneral, siempre que no signifiquen resaltar acciones de gobierno.\n\n",
      "co:inicioCaracter": 18848,
      "co:finCaracter": 19919,
      "co:inicioTexto": 18861,
      "co:finTexto": 19919,
      "co:caracteresTexto": 1058,
      "co:marcadorArticulo": "Artículo 30: ",
      "co:encabezadoPrevioLiteral": "###### PUBLICIDAD DE LOS ACTOS DE GOBIERNO\n",
      "co:inicioEncabezado": 18805,
      "co:finEncabezado": 18848,
      "co:epigrafe": "PUBLICIDAD DE LOS ACTOS DE GOBIERNO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/31",
      "@type": "co:Articulo",
      "identifier": "31",
      "name": "Artículo 31",
      "position": 31,
      "text": "Las ordenanzas, sus reglamentaciones, los reglamentos autónomos, los convenios aprobados y todo\nacto que pueda producir efectos de carácter general son obligatorios a partir de su publicación en el Boletín Oficial\nMunicipal y desde ese momento entran en vigencia, a menos que determinen otra fecha. No tienen efecto\nretroactivo, salvo disposición en contrario y siempre que no afecten derechos y garantías constitucionales.\n\n",
      "co:inicioCaracter": 19954,
      "co:finCaracter": 20392,
      "co:inicioTexto": 19967,
      "co:finTexto": 20392,
      "co:caracteresTexto": 425,
      "co:marcadorArticulo": "Artículo 31: ",
      "co:encabezadoPrevioLiteral": "###### VIGENCIA E IRRETROACTIVIDAD\n",
      "co:inicioEncabezado": 19919,
      "co:finEncabezado": 19954,
      "co:epigrafe": "VIGENCIA E IRRETROACTIVIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/32",
      "@type": "co:Articulo",
      "identifier": "32",
      "name": "Artículo 32",
      "position": 32,
      "text": "El Municipio puede expropiar bienes, previa declaración de utilidad pública hecha por ordenanza e\nindemnización, con arreglo a las leyes que rigen la materia.\n\n",
      "co:inicioCaracter": 20412,
      "co:finCaracter": 20585,
      "co:inicioTexto": 20425,
      "co:finTexto": 20585,
      "co:caracteresTexto": 160,
      "co:marcadorArticulo": "Artículo 32: ",
      "co:encabezadoPrevioLiteral": "###### EXPROPIACIÓN\n",
      "co:inicioEncabezado": 20392,
      "co:finEncabezado": 20412,
      "co:epigrafe": "EXPROPIACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/33",
      "@type": "co:Articulo",
      "identifier": "33",
      "name": "Artículo 33",
      "position": 33,
      "text": "Todos  los funcionarios y empleados son responsables  civil, penal y administrativamente. Los\nfuncionarios sujetos a remoción mediante Juicio Político son, además, responsables políticamente.\nEl Concejo de Representantes sancionará un Código de Ética para el ejercicio de la función pública.\n\n",
      "co:inicioCaracter": 20628,
      "co:finCaracter": 20934,
      "co:inicioTexto": 20641,
      "co:finTexto": 20934,
      "co:caracteresTexto": 293,
      "co:marcadorArticulo": "Artículo 33: ",
      "co:encabezadoPrevioLiteral": "###### RESPONSABILIDAD DE LOS FUNCIONARIOS\n",
      "co:inicioEncabezado": 20585,
      "co:finEncabezado": 20628,
      "co:epigrafe": "RESPONSABILIDAD DE LOS FUNCIONARIOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/34",
      "@type": "co:Articulo",
      "identifier": "34",
      "name": "Artículo 34",
      "position": 34,
      "text": "El Intendente, los Concejales, los miembros del Tribunal de Cuentas y demás funcionarios que\ndetermine una ordenanza especialmente dictada al efecto, al asumir el cargo, prestan juramento de desempeñar\nfielmente sus funciones conforme a las Constituciones de la Nación y de la Provincia y a esta Carta Orgánica.\n\n",
      "co:inicioCaracter": 20951,
      "co:finCaracter": 21277,
      "co:inicioTexto": 20964,
      "co:finTexto": 21277,
      "co:caracteresTexto": 313,
      "co:marcadorArticulo": "Artículo 34: ",
      "co:encabezadoPrevioLiteral": "###### JURAMENTO\n",
      "co:inicioEncabezado": 20934,
      "co:finEncabezado": 20951,
      "co:epigrafe": "JURAMENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/35",
      "@type": "co:Articulo",
      "identifier": "35",
      "name": "Artículo 35",
      "position": 35,
      "text": "Todos los funcionarios municipales electivos o que ocupen cargos calificados como políticos por una\n\n\nordenanza especialmente sancionada al efecto, deberán efectuar Declaración Jurada de su patrimonio, el de su\ncónyuge y el de las personas a su cargo, en la forma, tiempo y modo que establezca la ordenanza reglamentaria;\ndicha declaración deberá actualizarse anualmente  y a la fecha de cesación de sus funciones. El acceso de cualquier\ninteresado al conocimiento de aquélla será posible en las circunstancias que se prevean en la ordenanza. El\nincumplimiento de esta norma será causal de cesantía o juicio político según corresponda.\n\n",
      "co:inicioCaracter": 21308,
      "co:finCaracter": 21958,
      "co:inicioTexto": 21321,
      "co:finTexto": 21958,
      "co:caracteresTexto": 637,
      "co:marcadorArticulo": "Artículo 35: ",
      "co:encabezadoPrevioLiteral": "###### DECLARACIÓN PATRIMONIAL\n",
      "co:inicioEncabezado": 21277,
      "co:finEncabezado": 21308,
      "co:epigrafe": "DECLARACIÓN PATRIMONIAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/36",
      "@type": "co:Articulo",
      "identifier": "36",
      "name": "Artículo 36",
      "position": 36,
      "text": "Al empleo público municipal se ingresa por idoneidad, en base a concurso público de antecedentes y\noposición, que asegure  la igualdad de oportunidades. Se garantiza  la carrera administrativa. Se establecerán\nmecanismos permanentes de capacitación  del personal. Los ascensos y promociones se realizan por eficiencia y\nmérito, con exclusión de toda automaticidad.\n\n",
      "co:inicioCaracter": 21992,
      "co:finCaracter": 22371,
      "co:inicioTexto": 22005,
      "co:finTexto": 22371,
      "co:caracteresTexto": 366,
      "co:marcadorArticulo": "Artículo 36: ",
      "co:encabezadoPrevioLiteral": "###### IDONEIDAD - EMPLEO PÚBLICO\n",
      "co:inicioEncabezado": 21958,
      "co:finEncabezado": 21992,
      "co:epigrafe": "IDONEIDAD - EMPLEO PÚBLICO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/37",
      "@type": "co:Articulo",
      "identifier": "37",
      "name": "Artículo 37",
      "position": 37,
      "text": "Es deber del Municipio promover la planificación integral como un instrumento flexible tendiente a\nestablecer estrategias de desarrollo local que contemplen los intereses propios, provinciales, regionales y nacionales.\nSon sus principales objetivos lograr una Ciudad funcionalmente equilibrada, integrada y articulada con su entorno\nmetropolitano, rural y natural, ambientalmente sustentable, socialmente equitativa y con una participación efectiva\nde sus vecinos.\n\n",
      "co:inicioCaracter": 22392,
      "co:finCaracter": 22871,
      "co:inicioTexto": 22405,
      "co:finTexto": 22871,
      "co:caracteresTexto": 466,
      "co:marcadorArticulo": "Artículo 37: ",
      "co:encabezadoPrevioLiteral": "###### PLANIFICACIÓN\n",
      "co:inicioEncabezado": 22371,
      "co:finEncabezado": 22392,
      "co:epigrafe": "PLANIFICACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/38",
      "@type": "co:Articulo",
      "identifier": "38",
      "name": "Artículo 38",
      "position": 38,
      "text": "Es deber del Municipio promover el desarrollo humano y comunitario, el progreso económico con\njusticia social, la actividad turística en todas sus formas, la productividad de la economía local, la generación de\nempleo, la formación y capacitación de sus trabajadores, la reconversión de la mano de obra, la investigación y el\ndesarrollo científico y tecnológico, su difusión y aprovechamiento, la inclusión social y la accesibilidad de los\nservicios públicos de todos los habitantes del municipio, propendiendo al Estado de Bienestar.\nPromueve el crecimiento armónico de la Ciudad y políticas diferenciadas que tiendan a equilibrar el desigual\ndesarrollo relativo de sus distintos sectores y zonas.\nDesarrolla políticas sociales coordinadas para superar las condiciones de pobreza extrema y exclusión.\n\n",
      "co:inicioCaracter": 22910,
      "co:finCaracter": 23726,
      "co:inicioTexto": 22923,
      "co:finTexto": 23726,
      "co:caracteresTexto": 803,
      "co:marcadorArticulo": "Artículo 38: ",
      "co:encabezadoPrevioLiteral": "###### DESARROLLO HUMANO Y COMUNITARIO\n",
      "co:inicioEncabezado": 22871,
      "co:finEncabezado": 22910,
      "co:epigrafe": "DESARROLLO HUMANO Y COMUNITARIO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/39",
      "@type": "co:Articulo",
      "identifier": "39",
      "name": "Artículo 39",
      "position": 39,
      "text": "Ningún funcionario electivo o político puede otorgar o entregar subvenciones, subsidios o ayuda social\ncon fondos públicos a título individual. La asistencia social se efectúa en forma institucional a través de los\norganismos municipales competentes.\n\n",
      "co:inicioCaracter": 23746,
      "co:finCaracter": 24011,
      "co:inicioTexto": 23759,
      "co:finTexto": 24011,
      "co:caracteresTexto": 252,
      "co:marcadorArticulo": "Artículo 39. ",
      "co:encabezadoPrevioLiteral": "###### SUBVENCIONES\n",
      "co:inicioEncabezado": 23726,
      "co:finEncabezado": 23746,
      "co:epigrafe": "SUBVENCIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/40",
      "@type": "co:Articulo",
      "identifier": "40",
      "name": "Artículo 40",
      "position": 40,
      "text": "Los obsequios que pudieren recibir las autoridades en su carácter de tales y que tengan valor\neconómico,  histórico,  cultural o  artístico, son propiedad exclusiva del Municipio, conforme  lo disponga  la\nOrdenanza respectiva.\n\n",
      "co:inicioCaracter": 24028,
      "co:finCaracter": 24270,
      "co:inicioTexto": 24041,
      "co:finTexto": 24270,
      "co:caracteresTexto": 229,
      "co:marcadorArticulo": "Artículo 40: ",
      "co:encabezadoPrevioLiteral": "###### OBSEQUIOS\n",
      "co:inicioEncabezado": 24011,
      "co:finEncabezado": 24028,
      "co:epigrafe": "OBSEQUIOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/41",
      "@type": "co:Articulo",
      "identifier": "41",
      "name": "Artículo 41",
      "position": 41,
      "text": "El Municipio, en caso de requerir asesoramiento para realizar proyectos, obras o servicios, deberá tener\nen cuenta como consultoras preferenciales a la Universidad Nacional de Córdoba y demás Universidades con\nasiento en la provincia.\n",
      "co:inicioCaracter": 24291,
      "co:finCaracter": 24539,
      "co:inicioTexto": 24304,
      "co:finTexto": 24539,
      "co:caracteresTexto": 235,
      "co:marcadorArticulo": "Artículo 41: ",
      "co:encabezadoPrevioLiteral": "###### ASESORAMIENTO\n",
      "co:inicioEncabezado": 24270,
      "co:finEncabezado": 24291,
      "co:epigrafe": "ASESORAMIENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/2"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/42",
      "@type": "co:Articulo",
      "identifier": "42",
      "name": "Artículo 42",
      "position": 42,
      "text": "El Municipio considera a la cultura como el conjunto de las manifestaciones en que se expresa la vida\nde un pueblo, constituyendo un elemento esencial de su identidad. A los fines de su promoción:\n1.        Facilita el acceso a la práctica y desarrollo de las actividades culturales, asegurando la libertad en su\nexpresión.\n2.       Valora y preserva  las diferentes corrientes que componen  el patrimonio  cultural local y regional,\nfavoreciendo el intercambio de experiencias y manifestaciones culturales.\n\n\n3.      Promueve la consolidación de la identidad cultural de la ciudad y de los lazos de vecindad y arraigo.\n4.      Formula  planes y programas  culturales  priorizando  la  producción,  divulgación y  difusión de  las\nmanifestaciones culturales locales.\n5.      Promueve la cultura cívica y política.\n6.        Facilita la participación de los creadores y trabajadores de la cultura en el diseño y la evaluación de las\npolíticas culturales.\n7.        Propicia la existencia y desarrollo de bibliotecas públicas y el acceso libre y gratuito a los distintos tipos\nde soporte del saber científico, tecnológico y cultural.\n8.      Crea un espacio público apto para el desarrollo de las distintas manifestaciones artísticas y culturales.\n\n",
      "co:inicioCaracter": 24649,
      "co:finCaracter": 25909,
      "co:inicioTexto": 24662,
      "co:finTexto": 25909,
      "co:caracteresTexto": 1247,
      "co:marcadorArticulo": "Artículo 42: ",
      "co:encabezadoPrevioLiteral": "###### CULTURA\n",
      "co:inicioEncabezado": 24634,
      "co:finEncabezado": 24649,
      "co:epigrafe": "CULTURA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/43",
      "@type": "co:Articulo",
      "identifier": "43",
      "name": "Artículo 43",
      "position": 43,
      "text": "Las riquezas antropológicas, históricas, documentales, bibliográficas y edilicias, los valores artísticos y\ncientíficos, así como el paisaje y entorno  natural, cualesquiera fueran sus titulares, forman parte del patrimonio\ncultural de la comunidad. Están bajo tutela del Municipio, conforme a las normas respectivas, dispone las acciones\nque sean necesarias para su defensa. Se prohíbe su  concesión, traslado, privatización o enajenación, cuando estos\nalteren los fines que le dieran origen. El Municipio organiza un registro de su patrimonio cultural a la vez que\nasegura su custodia y atiende a su preservación. Puede establecer relaciones con otros municipios para la protección\nde la cultura regional.\n\n",
      "co:inicioCaracter": 25987,
      "co:finCaracter": 26709,
      "co:inicioTexto": 26000,
      "co:finTexto": 26709,
      "co:caracteresTexto": 709,
      "co:marcadorArticulo": "Artículo 43: ",
      "co:encabezadoPrevioLiteral": "###### PATRIMONIO CULTURAL. (reglamentación anterior: Ordenanzas 3364 y 3965)\n",
      "co:inicioEncabezado": 25909,
      "co:finEncabezado": 25987,
      "co:epigrafe": "PATRIMONIO CULTURAL. (reglamentación anterior: Ordenanzas 3364 y 3965)",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/44",
      "@type": "co:Articulo",
      "identifier": "44",
      "name": "Artículo 44",
      "position": 44,
      "text": "El Municipio considera a la educación como un capital social y cultural, reconociendo a la familia\ncomo su agente natural y primario. Se complementa y coordina con la Provincia y la Nación, promoviendo la\neducación exenta de dogmatismo y garantizando la igualdad de oportunidades a través del acceso gratuito.\nEl Municipio crea salas materno-infantiles y planifica al efecto un proyecto didáctico integral, articulando aspectos\nasistenciales, psicológicos  y psicopedagógicos que prioricen la estimulación temprana.\nGestiona e implementa la incorporación de la enseñanza e investigación de la historia y geografía locales, la\nidentidad cultural y turística de la Ciudad, como materia obligatoria en los planes de estudios de escuelas primarias\ny secundarias.\nAmplía la acción educadora a todas las artes y oficios y desarrolla políticas que atiendan a la educación no formal en\nsus diversas manifestaciones. Facilita la instalación de establecimientos educativos terciarios y universitarios.\n\n",
      "co:inicioCaracter": 26726,
      "co:finCaracter": 27732,
      "co:inicioTexto": 26739,
      "co:finTexto": 27732,
      "co:caracteresTexto": 993,
      "co:marcadorArticulo": "Artículo 44: ",
      "co:encabezadoPrevioLiteral": "###### EDUCACIÓN\n",
      "co:inicioEncabezado": 26709,
      "co:finEncabezado": 26726,
      "co:epigrafe": "EDUCACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/45",
      "@type": "co:Articulo",
      "identifier": "45",
      "name": "Artículo 45",
      "position": 45,
      "text": "El Municipio crea y sostiene   el Consejo Educativo Municipal entendiéndoselo como un espacio de\nopinión, concertación y coordinación institucional que  asegura la participación democrática de la comunidad\neducativa toda en la resolución de los problemas que la afecten. La ordenanza reglamentará su funcionamiento.\n\n",
      "co:inicioCaracter": 27794,
      "co:finCaracter": 28124,
      "co:inicioTexto": 27807,
      "co:finTexto": 28124,
      "co:caracteresTexto": 317,
      "co:marcadorArticulo": "Artículo 45: ",
      "co:encabezadoPrevioLiteral": "###### CONSEJO EDUCATIVO MUNICIPAL  Creado por Ordenanza 5046\n",
      "co:inicioEncabezado": 27732,
      "co:finEncabezado": 27794,
      "co:epigrafe": "CONSEJO EDUCATIVO MUNICIPAL  Creado por Ordenanza 5046",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/46",
      "@type": "co:Articulo",
      "identifier": "46",
      "name": "Artículo 46",
      "position": 46,
      "text": "El Municipio reconoce al deporte como parte de la educación integral de las personas y como recurso\npara la recreación y el esparcimiento, atendiendo a la salud de la población y a su mejor integración social.\nPlanifica y ejecuta políticas y actividades deportivas previendo la interrelación y la participación de asociaciones\nintermedias y de entidades públicas y privadas.  Promociona y estimula el deporte organizado, competitivo y de alto\nrendimiento.\nEl Municipio crea y/o recupera los espacios físicos necesarios para el desarrollo de actividades deportivas y\nrecreativas e implementa acciones para el uso apropiado del tiempo libre.\n\n",
      "co:inicioCaracter": 28152,
      "co:finCaracter": 28806,
      "co:inicioTexto": 28165,
      "co:finTexto": 28806,
      "co:caracteresTexto": 641,
      "co:marcadorArticulo": "Artículo 46: ",
      "co:encabezadoPrevioLiteral": "###### DEPORTE Y RECREACIÓN\n",
      "co:inicioEncabezado": 28124,
      "co:finEncabezado": 28152,
      "co:epigrafe": "DEPORTE Y RECREACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/47",
      "@type": "co:Articulo",
      "identifier": "47",
      "name": "Artículo 47",
      "position": 47,
      "text": "El Municipio protege  la estabilidad y  el afianzamiento de  la familia como fundamento de  la\norganización social y la vida municipal.\nAsegura la protección integral de la niñez, instrumentando las siguientes acciones:\n1.      Las que impliquen el cumplimiento de la Convención Internacional de los Derechos del Niño, ejerciendo el\npoder de policía en el ámbito de su competencia.\n2.      Las que promuevan y ejecuten programas que contengan políticas sociales básicas, asistenciales y de\nprotección, especialmente de menores en situación de riesgo.\n3.      Las que promuevan la integridad de los programas, evitando la fragmentación de la familia.\n\n",
      "co:inicioCaracter": 28830,
      "co:finCaracter": 29494,
      "co:inicioTexto": 28843,
      "co:finTexto": 29494,
      "co:caracteresTexto": 651,
      "co:marcadorArticulo": "Artículo 47: ",
      "co:encabezadoPrevioLiteral": "###### FAMILIA Y NIÑEZ.\n",
      "co:inicioEncabezado": 28806,
      "co:finEncabezado": 28830,
      "co:epigrafe": "FAMILIA Y NIÑEZ.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/48",
      "@type": "co:Articulo",
      "identifier": "48",
      "name": "Artículo 48",
      "position": 48,
      "text": "El Municipio posibilita la participación de la juventud impulsando programas integrales que  hagan\nviable su inserción político-social y el desarrollo de sus aptitudes, afiancen su arraigo sociocultural y fomenten\nactitudes solidarias y conciencia democrática.\n\n",
      "co:inicioCaracter": 29512,
      "co:finCaracter": 29787,
      "co:inicioTexto": 29525,
      "co:finTexto": 29787,
      "co:caracteresTexto": 262,
      "co:marcadorArticulo": "Artículo 48: ",
      "co:encabezadoPrevioLiteral": "###### JUVENTUD\n\n\n",
      "co:inicioEncabezado": 29494,
      "co:finEncabezado": 29512,
      "co:epigrafe": "JUVENTUD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/49",
      "@type": "co:Articulo",
      "identifier": "49",
      "name": "Artículo 49",
      "position": 49,
      "text": "El Municipio crea la Casa de la Juventud, que será un organismo dentro del ámbito del Departamento\nEjecutivo, con competencia en toda actividad relacionada con los jóvenes de la ciudad. Estará a cargo de un\nCoordinador General quien deberá ser mayor de 21 años y menor de 30 años al asumir el cargo. Su organización,\nobjetivos y funcionamiento serán establecidos por ordenanza.\n\n",
      "co:inicioCaracter": 29879,
      "co:finCaracter": 30271,
      "co:inicioTexto": 29892,
      "co:finTexto": 30271,
      "co:caracteresTexto": 379,
      "co:marcadorArticulo": "Artículo 49: ",
      "co:encabezadoPrevioLiteral": "###### CASA DE LA JUVENTUD   (Por Ordenanza 5043 - reglamentaria de la Casa de la Juventud)\n",
      "co:inicioEncabezado": 29787,
      "co:finEncabezado": 29879,
      "co:epigrafe": "CASA DE LA JUVENTUD   (Por Ordenanza 5043 - reglamentaria de la Casa de la Juventud)",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/50",
      "@type": "co:Articulo",
      "identifier": "50",
      "name": "Artículo 50",
      "position": 50,
      "text": "El Municipio promueve políticas para las personas de la tercera edad que atiendan a su protección, su\nintegración social y cultural, su realización personal y la satisfacción de sus necesidades específicas.\nAsegura la atención preferencial de aquéllas en todo trámite que deban realizar en la ciudad.\nGestiona la creación de centros especializados para la asistencia, recreación, alojamiento y atención ambulatoria de\nlas personas mayores.\n\n",
      "co:inicioCaracter": 30292,
      "co:finCaracter": 30746,
      "co:inicioTexto": 30305,
      "co:finTexto": 30746,
      "co:caracteresTexto": 441,
      "co:marcadorArticulo": "Artículo 50: ",
      "co:encabezadoPrevioLiteral": "###### TERCERA EDAD.\n",
      "co:inicioEncabezado": 30271,
      "co:finEncabezado": 30292,
      "co:epigrafe": "TERCERA EDAD.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/51",
      "@type": "co:Articulo",
      "identifier": "51",
      "name": "Artículo 51",
      "position": 51,
      "text": "El Municipio procura la integración de las personas con capacidades diferentes mediante políticas que\ntiendan a su protección, integración, rehabilitación, capacitación, educación e inserción social y laboral. De manera\nespecial, orienta su acción a la concreción de las siguientes políticas:\n1.      Determina actividades culturales, deportivas y sociales.\n2.      Coordina su labor con la Nación, Provincia y Organismos no gubernamentales dedicados a la educación de\nlos niños y jóvenes con capacidades diferentes.\n3.       Instrumenta políticas para la inserción de las personas especiales al mercado laboral de la Ciudad y asegura\ndentro de la planta municipal de empleados el porcentaje reservado a discapacitados por Ley Nacional.\n4.      Gestiona ante los organismos pertinentes  la incorporación de los niños y jóvenes con capacidades\ndiferentes a las instituciones educativas del medio, a través del sistema del docente integrador.\n5.      Crea los medios y/o apoya a  instituciones como hogares diurnos, centros, talleres protegidos y otros,\ndedicadas a la atención de personas que no puedan incorporarse por sus características al mercado laboral.\n6.      Crea un área municipal con competencia en la materia asegurando la necesaria participación de los\ndestinatarios de las políticas públicas.\n7.       Certifica la existencia y grado de discapacidad de la minoridad en riesgo, efectuando relevamientos\nestadísticos.\n8.       Desarrolla programas y dirige la investigación técnica en el área de discapacidad y minoridad.\n9.      Prevé el desarrollo de un hábitat libre de barreras naturales, culturales, lingüísticas, de comunicación,\nsociales, educacionales, urbanísticas, de transporte y de cualquier otro tipo, así como la progresiva eliminación de\nlas existentes.  (La Ordenanza 5151 creó las Plazas Integradoras)\n\n",
      "co:inicioCaracter": 30790,
      "co:finCaracter": 32634,
      "co:inicioTexto": 30803,
      "co:finTexto": 32634,
      "co:caracteresTexto": 1831,
      "co:marcadorArticulo": "Artículo 51: ",
      "co:encabezadoPrevioLiteral": "###### PERSONAS CON CAPACIDADES DIFERENTES.\n",
      "co:inicioEncabezado": 30746,
      "co:finEncabezado": 30790,
      "co:epigrafe": "PERSONAS CON CAPACIDADES DIFERENTES.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/52",
      "@type": "co:Articulo",
      "identifier": "52",
      "name": "Artículo 52",
      "position": 52,
      "text": "El Municipio afirma y garantiza la igualdad de oportunidades y trato entre varones y mujeres en el\nacceso y goce de todos los derechos civiles, políticos, económicos, sociales y culturales a través de acciones\npositivas que permitan su ejercicio efectivo.\nEl Municipio crea y sostiene con carácter permanente una oficina de igualdad de género para el estudio, diseño e\nimplementación  de políticas de género. Asesoramiento y asistencia a la mujer.\n\n",
      "co:inicioCaracter": 32660,
      "co:finCaracter": 33122,
      "co:inicioTexto": 32673,
      "co:finTexto": 33122,
      "co:caracteresTexto": 449,
      "co:marcadorArticulo": "Artículo 52: ",
      "co:encabezadoPrevioLiteral": "###### IGUALDAD DE GÉNERO\n",
      "co:inicioEncabezado": 32634,
      "co:finEncabezado": 32660,
      "co:epigrafe": "IGUALDAD DE GÉNERO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/53",
      "@type": "co:Articulo",
      "identifier": "53",
      "name": "Artículo 53",
      "position": 53,
      "text": "La ciudad incorpora la perspectiva de género en el diseño y ejecución de sus políticas públicas. A esos\nefectos realiza las siguientes acciones:\n1.      Fomenta la plena integración de las mujeres a la actividad productiva, con  acciones positivas que\ngaranticen la paridad en relación con el trabajo remunerado y la eliminación de la segregación y de toda forma de\ndiscriminación por estado civil o maternidad.\n2.       Privilegia el acceso a la vivienda, empleo, al crédito y a los sistemas de cobertura social a las mujeres único\nsostén del hogar.\n3.       Desarrolla políticas respecto del embarazo de niñas adolescentes, amparándolas y   garantizando su\npermanencia en el sistema educativo.\n\n\n4.      Provee a la prevención de violencia física, psicológica y sexual contra las mujeres y brinda servicios\nespecializados de atención.\n5.     Ampara a las víctimas de  explotación sexual y les brinda servicios de atención.\n6.      Fomenta las organizaciones no gubernamentales dedicadas a las temáticas de las mujeres, dándoles\nparticipación en el diseño de políticas públicas.\n\n",
      "co:inicioCaracter": 33165,
      "co:finCaracter": 34259,
      "co:inicioTexto": 33178,
      "co:finTexto": 34259,
      "co:caracteresTexto": 1081,
      "co:marcadorArticulo": "Artículo 53: ",
      "co:encabezadoPrevioLiteral": "###### POLÍTICAS ESPECIALES SOBRE MUJERES.\n",
      "co:inicioEncabezado": 33122,
      "co:finEncabezado": 33165,
      "co:epigrafe": "POLÍTICAS ESPECIALES SOBRE MUJERES.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/54",
      "@type": "co:Articulo",
      "identifier": "54",
      "name": "Artículo 54",
      "position": 54,
      "text": "El Municipio facilita el acceso a la vivienda, salud, educación y trabajo a los veteranos de guerra\nresidentes en la Ciudad.\n\n",
      "co:inicioCaracter": 34287,
      "co:finCaracter": 34426,
      "co:inicioTexto": 34300,
      "co:finTexto": 34426,
      "co:caracteresTexto": 126,
      "co:marcadorArticulo": "Artículo 54: ",
      "co:encabezadoPrevioLiteral": "###### VETERANOS DE GUERRA.\n",
      "co:inicioEncabezado": 34259,
      "co:finEncabezado": 34287,
      "co:epigrafe": "VETERANOS DE GUERRA.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/55",
      "@type": "co:Articulo",
      "identifier": "55",
      "name": "Artículo 55",
      "position": 55,
      "text": "El municipio reconoce la Unión Civil entre personas de igual o distinto sexo que acrediten residencia en\nla Ciudad no menor a cinco  (5)  años, organizándose a  tal  efecto un  Registro que  certifique  el  hecho,\nreglamentándose con ordenanza que se dicte a tal efecto.-\n\n",
      "co:inicioCaracter": 34445,
      "co:finCaracter": 34731,
      "co:inicioTexto": 34458,
      "co:finTexto": 34731,
      "co:caracteresTexto": 273,
      "co:marcadorArticulo": "Artículo 55: ",
      "co:encabezadoPrevioLiteral": "###### UNIÓN CIVIL\n",
      "co:inicioEncabezado": 34426,
      "co:finEncabezado": 34445,
      "co:epigrafe": "UNIÓN CIVIL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/56",
      "@type": "co:Articulo",
      "identifier": "56",
      "name": "Artículo 56",
      "position": 56,
      "text": "El Municipio instrumenta políticas de atención primaria e integral de la salud y asegura su gratuidad\ncon los alcances que se determinen por ordenanza. En especial, instrumenta las siguientes políticas:\n1.       Planifica y ejecuta programas de medicina preventiva, curativa y asistencial.\n2.      Procura condiciones de accesibilidad a los medicamentos a los sectores carenciados.\n3.      Promueve la maternidad y la paternidad responsable.\n4.       Garantiza la descentralización del servicio de salud para asegurar su prestación equitativa.\n5.      Coordina acciones entre los sectores públicos y privados, tendiendo a un sistema local de salud.\n6.       Ejerce su poder de policía sobre la salud e higiene en el ámbito público y en el privado.\n7.       Establece normas higiénico-sanitarias y bromatológicas para la elaboración, comercialización, circulación y\ntransporte de alimentos.\n8.       Controla los factores socio-biológicos y ambientales a fin de reducir y/o evitar riesgos de enfermedad a la\npoblación.\n\n",
      "co:inicioCaracter": 34744,
      "co:finCaracter": 35776,
      "co:inicioTexto": 34757,
      "co:finTexto": 35776,
      "co:caracteresTexto": 1019,
      "co:marcadorArticulo": "Artículo 56: ",
      "co:encabezadoPrevioLiteral": "###### SALUD\n",
      "co:inicioEncabezado": 34731,
      "co:finEncabezado": 34744,
      "co:epigrafe": "SALUD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/57",
      "@type": "co:Articulo",
      "identifier": "57",
      "name": "Artículo 57",
      "position": 57,
      "text": "El Municipio desarrolla programas de prevención y tratamiento del consumo de sustancias o elementos\ngeneradores de dependencia.\n",
      "co:inicioCaracter": 35794,
      "co:finCaracter": 35935,
      "co:inicioTexto": 35807,
      "co:finTexto": 35935,
      "co:caracteresTexto": 128,
      "co:marcadorArticulo": "Artículo 57: ",
      "co:encabezadoPrevioLiteral": "###### ADICCIONES\n",
      "co:inicioEncabezado": 35776,
      "co:finEncabezado": 35794,
      "co:epigrafe": "ADICCIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/3"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/58",
      "@type": "co:Articulo",
      "identifier": "58",
      "name": "Artículo 58",
      "position": 58,
      "text": "El Municipio organiza y coordina la Defensa Civil para la prevención y asistencia en situaciones\ncalificadas como de emergencia o catástrofe. En estos casos, los organismos municipales designados al efecto tienen\nfacultades para utilizar bienes públicos y/o privados.-\n\n",
      "co:inicioCaracter": 36004,
      "co:finCaracter": 36287,
      "co:inicioTexto": 36017,
      "co:finTexto": 36287,
      "co:caracteresTexto": 270,
      "co:marcadorArticulo": "Artículo 58: ",
      "co:encabezadoPrevioLiteral": "###### DEFENSA CIVIL\n",
      "co:inicioEncabezado": 35983,
      "co:finEncabezado": 36004,
      "co:epigrafe": "DEFENSA CIVIL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/59",
      "@type": "co:Articulo",
      "identifier": "59",
      "name": "Artículo 59",
      "position": 59,
      "text": "El Municipio planifica y ejecuta políticas destinadas a promover la seguridad y protección de los\nhabitantes. Desarrolla estrategias multidisciplinarias, en coordinación con entidades estatales y no gubernamentales,\npara la prevención del delito, la violencia y la asistencia a las víctimas.\nFacilita canales de participación comunitaria a través de la creación del Foro Municipal de Seguridad, cuya\nintegración y regulación serán establecidas por Ordenanza.\n\n",
      "co:inicioCaracter": 36312,
      "co:finCaracter": 36785,
      "co:inicioTexto": 36325,
      "co:finTexto": 36785,
      "co:caracteresTexto": 460,
      "co:marcadorArticulo": "Artículo 59: ",
      "co:encabezadoPrevioLiteral": "###### SEGURIDAD PÚBLICA\n",
      "co:inicioEncabezado": 36287,
      "co:finEncabezado": 36312,
      "co:epigrafe": "SEGURIDAD PÚBLICA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/60",
      "@type": "co:Articulo",
      "identifier": "60",
      "name": "Artículo 60",
      "position": 60,
      "text": "El Municipio elabora el Plan de Riesgo de la ciudad diseñado por quienes interactúan en el control,\nprevención y primera respuesta en situaciones de emergencia: Policía, Cuerpo de Bomberos Voluntarios de Villa\nCarlos Paz, autoridades judiciales, el Departamento Ejecutivo como cabeza de Defensa Civil y demás organismos\nque correspondiere.\nEste Plan debe ser considerado previamente a toda planificación urbana.\n\n",
      "co:inicioCaracter": 36807,
      "co:finCaracter": 37233,
      "co:inicioTexto": 36820,
      "co:finTexto": 37233,
      "co:caracteresTexto": 413,
      "co:marcadorArticulo": "Artículo 60: ",
      "co:encabezadoPrevioLiteral": "###### PLAN DE RIESGO\n",
      "co:inicioEncabezado": 36785,
      "co:finEncabezado": 36807,
      "co:epigrafe": "PLAN DE RIESGO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/61",
      "@type": "co:Articulo",
      "identifier": "61",
      "name": "Artículo 61",
      "position": 61,
      "text": "El Municipio garantiza, dentro de sus políticas de Estado en lo referente a la seguridad pública, el\nmantenimiento de la operatividad integral del Cuerpo de Bomberos Voluntarios de Villa Carlos Paz implementando\nuna partida al efecto en el presupuesto anual, determinada en base a las necesidades de la institución.\n\n",
      "co:inicioCaracter": 37293,
      "co:finCaracter": 37623,
      "co:inicioTexto": 37306,
      "co:finTexto": 37623,
      "co:caracteresTexto": 317,
      "co:marcadorArticulo": "Artículo 61: ",
      "co:encabezadoPrevioLiteral": "###### CUERPO DE BOMBEROS VOLUNTARIOS DE VILLA CARLOS PAZ\n\n\n",
      "co:inicioEncabezado": 37233,
      "co:finEncabezado": 37293,
      "co:epigrafe": "CUERPO DE BOMBEROS VOLUNTARIOS DE VILLA CARLOS PAZ",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/62",
      "@type": "co:Articulo",
      "identifier": "62",
      "name": "Artículo 62",
      "position": 62,
      "text": "El Municipio reconoce la importancia de la ciencia y la tecnología como instrumentos adecuados para\nla promoción humana, el desarrollo sostenible y el mejoramiento de la calidad de vida. Organiza, ejecuta y difunde\nacciones de aplicación  científico-tecnológicas y asegura  la  participación comunitaria en  el conocimiento y\nevaluación de sus riesgos y beneficios.\nPromueve acciones tendientes al desarrollo de la ciencia, la tecnología y la innovación productiva como medio para\nmejorar la calidad de vida de los ciudadanos.\nPropende a lograr  que dentro del ejido la población acceda libremente a Internet.\n\n",
      "co:inicioCaracter": 37651,
      "co:finCaracter": 38275,
      "co:inicioTexto": 37664,
      "co:finTexto": 38275,
      "co:caracteresTexto": 611,
      "co:marcadorArticulo": "Artículo 62: ",
      "co:encabezadoPrevioLiteral": "###### CIENCIA Y TECNOLOGÍA\n",
      "co:inicioEncabezado": 37623,
      "co:finEncabezado": 37651,
      "co:epigrafe": "CIENCIA Y TECNOLOGÍA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/63",
      "@type": "co:Articulo",
      "identifier": "63",
      "name": "Artículo 63",
      "position": 63,
      "text": "El Municipio provee a la protección de los derechos e intereses económicos de los consumidores y\nusuarios de bienes y servicios, contra la distorsión de los mercados, y el control de los monopolios que los afecten.\nPromueve la educación para el consumo.\nProtege la salud y la seguridad, garantizándoles trato equitativo, libertad de elección y acceso a la información\ntransparente, adecuada, veraz y oportuna, contra los mensajes publicitarios que distorsionen su voluntad mediante\ntécnicas que la ley determine como inadecuadas.\nLos usuarios participan en el control de la prestación de los servicios públicos, según lo establecen las ordenanzas\nrespectivas.\n\n",
      "co:inicioCaracter": 38306,
      "co:finCaracter": 38980,
      "co:inicioTexto": 38319,
      "co:finTexto": 38980,
      "co:caracteresTexto": 661,
      "co:marcadorArticulo": "Artículo 63: ",
      "co:encabezadoPrevioLiteral": "###### CONSUMIDORES Y USUARIOS\n",
      "co:inicioEncabezado": 38275,
      "co:finEncabezado": 38306,
      "co:epigrafe": "CONSUMIDORES Y USUARIOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/64",
      "@type": "co:Articulo",
      "identifier": "64",
      "name": "Artículo 64",
      "position": 64,
      "text": "El Municipio formula planes integrales y permanentes de asistencia social a través de los organismos\ncompetentes, realizando a tales fines censos permanentes de necesidades individuales, familiares y sociales, y\nreglamentando por ordenanza el procedimiento de verificación y control de las prestaciones asistenciales.\n\n",
      "co:inicioCaracter": 39005,
      "co:finCaracter": 39337,
      "co:inicioTexto": 39018,
      "co:finTexto": 39337,
      "co:caracteresTexto": 319,
      "co:marcadorArticulo": "Artículo 64: ",
      "co:encabezadoPrevioLiteral": "###### DESARROLLO SOCIAL\n",
      "co:inicioEncabezado": 38980,
      "co:finEncabezado": 39005,
      "co:epigrafe": "DESARROLLO SOCIAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/65",
      "@type": "co:Articulo",
      "identifier": "65",
      "name": "Artículo 65",
      "position": 65,
      "text": "La lucha contra la pobreza e indigencia constituye una política de estado y una obligación ética del\nMunicipio. El presupuesto municipal debe contemplar las partidas necesarias para lograr el objetivo de reducirlas.\n\n",
      "co:inicioCaracter": 39368,
      "co:finCaracter": 39598,
      "co:inicioTexto": 39381,
      "co:finTexto": 39598,
      "co:caracteresTexto": 217,
      "co:marcadorArticulo": "Artículo 65: ",
      "co:encabezadoPrevioLiteral": "###### LUCHA CONTRA LA POBREZA\n",
      "co:inicioEncabezado": 39337,
      "co:finEncabezado": 39368,
      "co:epigrafe": "LUCHA CONTRA LA POBREZA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/66",
      "@type": "co:Articulo",
      "identifier": "66",
      "name": "Artículo 66",
      "position": 66,
      "text": "El Municipio promueve políticas de Estado para la actividad turística con el   objetivo de:\n1.       Aplicar modelos de gestión turística de servicios, recursos e inversiones, actualizados, consensuados y con\nparticipación de sectores relacionados.\n2.       Preservar y aprovechar los recursos y atractivos turísticos.\n3.      Mejorar la calidad de las prestaciones de servicios y recursos como destino turístico.\n4.       Ejecutar acciones de fiscalización y regulación de la calidad y funcionamiento de los servicios turísticos, de\nestablecimientos y  organismos públicos y privados vinculados al sector.\n5.       Proteger y respetar  al turista.\n6.      Generar acciones para  la concientización y vocación turística de  los vecinos, difundiendo el patrimonio\nturístico de la Ciudad.\n7.      Fomentar y gestionar  la incorporación  del turismo en los programas de estudio de las escuelas de los\ndistintos niveles.\n8.      Fomentar y gestionar  inversiones y obras públicas turísticas.\n9.      Coordinar  y ejecutar acciones de promoción turística.\n10.      Facilitar el desarrollo de  prensa turística especializada.\n11.      Establecer y coordinar un calendario anual de eventos.\n12.      Establecer mecanismos de participación de los sectores público y privado relacionados a la actividad.\n13.     Coordinar sus políticas, planes y gestiones con los municipios de la región.\n14.      Asociarse, concertar y convenir con otros organismos públicos y privados.\n15.      Participar en planes de desarrollo integral de la ciudad\n16.     Resguardar el desarrollo sustentable, armónico, sostenido y competitivo de Villa Carlos Paz como destino\nturístico.\n\n\nPara el logro de los objetivos deberá:\n1.      Adherir y/o    integrar   a   leyes,  políticas, programas o planes de carácter internacional, nacional,\nregional, provincial, que sean de interés y beneficien las políticas locales.  (Por Ordenanza 1942 y 5191 se adhirió a\nLey Pcial. de Turismo)\n2.      Coordinar acciones con otras áreas del gobierno municipal, con incidencia  en actividades del turismo,\npara facilitar y complementar  políticas del área.\n3.      Crear un Consejo  de Política Turística, con carácter honorario y temporario, con el fin de dictar una\npolítica turística de mediano y largo plazo, integrando al  sector público y privado. Una ordenanza especial regulará\nsu integración, duración, períodos y funciones.       (Ordenanza 5095 de Creación del Consejo de Política\nTurística)\n4.      Crear un Organismo de Promoción Turística con carácter permanente, con el objetivo de impulsar,\ndesarrollar, incentivar  y ejecutar planes, programas, campañas  y estrategias de promoción del turismo con las\nformas en que se desarrollan  y nuevas a desarrollarse, integrando al sector público y privado. Se creó CA.P.TUR.\npor Ordenanza 5179\nContará con los siguientes recursos:\na)     La tasa de promoción de turismo.\nb)      Aportes públicos y privados por auspicio y organización  de eventos.\nc)       Ingresos  por acciones  en el cumplimiento de sus objetivos.\nd)      Otros tributos a crearse que tengan por destino la promoción turística.\nTendrá un presupuesto anual  propio, incluido  en el presupuesto del  Municipio.\nUna ordenanza especial regulará la integración, duración, períodos, funciones, disposición y uso  de recursos de\neste Organismo.\n\n",
      "co:inicioCaracter": 39613,
      "co:finCaracter": 42947,
      "co:inicioTexto": 39626,
      "co:finTexto": 42947,
      "co:caracteresTexto": 3321,
      "co:marcadorArticulo": "Artículo 66: ",
      "co:encabezadoPrevioLiteral": "###### TURISMO\n",
      "co:inicioEncabezado": 39598,
      "co:finEncabezado": 39613,
      "co:epigrafe": "TURISMO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/67",
      "@type": "co:Articulo",
      "identifier": "67",
      "name": "Artículo 67",
      "position": 67,
      "text": "La Secretaría de Turismo o el organismo que en el futuro la remplace es la autoridad de aplicación de la\npolítica de turismo, y dependen de ella el Consejo de Política Turística y el Organismo de Promoción Turística.\n\n",
      "co:inicioCaracter": 42978,
      "co:finCaracter": 43209,
      "co:inicioTexto": 42991,
      "co:finTexto": 43209,
      "co:caracteresTexto": 218,
      "co:marcadorArticulo": "Artículo 67: ",
      "co:encabezadoPrevioLiteral": "###### AUTORIDAD DE APLICACIÓN\n",
      "co:inicioEncabezado": 42947,
      "co:finEncabezado": 42978,
      "co:epigrafe": "AUTORIDAD DE APLICACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/68",
      "@type": "co:Articulo",
      "identifier": "68",
      "name": "Artículo 68",
      "position": 68,
      "text": "El Municipio impulsa y coordina, a través de sus organismos pertinentes, la educación cooperativa y\nmutualista. Promueve y apoya la constitución de cooperativas y mutuales como medio de alentar la economía. Les\nreconoce estructura jurídica idónea para la ejecución de obras y prestación de servicios.\n\n",
      "co:inicioCaracter": 43244,
      "co:finCaracter": 43559,
      "co:inicioTexto": 43257,
      "co:finTexto": 43559,
      "co:caracteresTexto": 302,
      "co:marcadorArticulo": "Artículo 68: ",
      "co:encabezadoPrevioLiteral": "###### COOPERATIVISMO y MUTUALISMO\n",
      "co:inicioEncabezado": 43209,
      "co:finEncabezado": 43244,
      "co:epigrafe": "COOPERATIVISMO y MUTUALISMO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/69",
      "@type": "co:Articulo",
      "identifier": "69",
      "name": "Artículo 69",
      "position": 69,
      "text": "El Municipio garantiza la prestación de los servicios públicos necesarios y asegura las condiciones de\nregularidad, continuidad, generalidad, accesibilidad y mantenimiento para los usuarios. Los servicios públicos se\nprestan directamente por la Municipalidad o por terceros, según criterios de eficiencia y calidad, conforme lo\nreglamenten las ordenanzas. Los servicios de saneamiento sólo podrán ser prestados por el Estado, Cooperativas de\nUsuarios o Empresas de Gestión  Social.\nEn las concesiones se otorga prioridad, en igualdad de condiciones, a las cooperativas de usuarios.\n\n",
      "co:inicioCaracter": 43585,
      "co:finCaracter": 44181,
      "co:inicioTexto": 43598,
      "co:finTexto": 44181,
      "co:caracteresTexto": 583,
      "co:marcadorArticulo": "Artículo 69: ",
      "co:encabezadoPrevioLiteral": "###### SERVICIOS PÚBLICOS\n",
      "co:inicioEncabezado": 43559,
      "co:finEncabezado": 43585,
      "co:epigrafe": "SERVICIOS PÚBLICOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/70",
      "@type": "co:Articulo",
      "identifier": "70",
      "name": "Artículo 70",
      "position": 70,
      "text": "Declarase al agua potable y a su saneamiento un bien público y un derecho humano no sujeto a\nprivatización en el ámbito de la ciudad, quedando reservada la gestión integral del servicio al Municipio o a\ncooperativas locales de usuarios.\n\n",
      "co:inicioCaracter": 44201,
      "co:finCaracter": 44452,
      "co:inicioTexto": 44214,
      "co:finTexto": 44452,
      "co:caracteresTexto": 238,
      "co:marcadorArticulo": "Artículo 70: ",
      "co:encabezadoPrevioLiteral": "###### AGUA POTABLE\n",
      "co:inicioEncabezado": 44181,
      "co:finEncabezado": 44201,
      "co:epigrafe": "AGUA POTABLE",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/71",
      "@type": "co:Articulo",
      "identifier": "71",
      "name": "Artículo 71",
      "position": 71,
      "text": "El Municipio planifica en forma estratégica su desarrollo; a tal fin convoca a ciudadanos e instituciones\na participar en la elaboración del plan. En él se definen diagnóstico, modelo de desarrollo, objetivos generales,\nparticulares y proyectos, que deberán expresarse en compromisos públicos de cumplimiento y que deben ser tratados\ny resueltos por el Concejo de Representantes.\n\n",
      "co:inicioCaracter": 44485,
      "co:finCaracter": 44879,
      "co:inicioTexto": 44498,
      "co:finTexto": 44879,
      "co:caracteresTexto": 381,
      "co:marcadorArticulo": "Artículo 71: ",
      "co:encabezadoPrevioLiteral": "###### PLANIFICACIÓN ESTRATÉGICA\n",
      "co:inicioEncabezado": 44452,
      "co:finEncabezado": 44485,
      "co:epigrafe": "PLANIFICACIÓN ESTRATÉGICA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/72",
      "@type": "co:Articulo",
      "identifier": "72",
      "name": "Artículo 72",
      "position": 72,
      "text": "El Municipio confecciona cada dos años un índice de desarrollo local, como instrumento de gestión y a\nlos fines de evaluar las políticas públicas. En él se miden capital físico, gestión de los recursos financieros, actividad\neconómica, transparencia, capital humano, capacidad institucional, participación política y capital social.\n\n\n",
      "co:inicioCaracter": 44913,
      "co:finCaracter": 45261,
      "co:inicioTexto": 44926,
      "co:finTexto": 45261,
      "co:caracteresTexto": 335,
      "co:marcadorArticulo": "Artículo 72: ",
      "co:encabezadoPrevioLiteral": "###### ÍNDICE DE DESARROLLO LOCAL\n",
      "co:inicioEncabezado": 44879,
      "co:finEncabezado": 44913,
      "co:epigrafe": "ÍNDICE DE DESARROLLO LOCAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/73",
      "@type": "co:Articulo",
      "identifier": "73",
      "name": "Artículo 73",
      "position": 73,
      "text": "El Municipio planifica y ejecuta  políticas de vivienda social, favoreciendo el acceso a la vivienda\npropia a las familias sin recursos. Gestiona, coordina y concierta programas con la Nación, la Provincia y otros\norganismos internacionales e instituciones sociales, respetando los siguientes principios:\n1. Uso racional del suelo.\n2. Adecuación a la planificación urbana vigente.\n3. Calidad de vida.\n4. Respeto a las pautas culturales de los moradores.\nEl Municipio desalienta la especulación inmobiliaria, utilizando para ello los recursos a su alcance.\n\n",
      "co:inicioCaracter": 45288,
      "co:finCaracter": 45858,
      "co:inicioTexto": 45301,
      "co:finTexto": 45858,
      "co:caracteresTexto": 557,
      "co:marcadorArticulo": "Artículo 73: ",
      "co:encabezadoPrevioLiteral": "###### VIVIENDAS Y TIERRAS\n",
      "co:inicioEncabezado": 45261,
      "co:finEncabezado": 45288,
      "co:epigrafe": "VIVIENDAS Y TIERRAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/74",
      "@type": "co:Articulo",
      "identifier": "74",
      "name": "Artículo 74",
      "position": 74,
      "text": "La Municipalidad regula, a través de su Código de Edificación y Desarrollo Urbano Ambiental, los\nfactores de ocupación, alturas y cantidad de unidades de vivienda por lote dentro del ejido actual de la ciudad de\nVilla Carlos Paz, no pudiendo aumentarse para ninguna de las zonas edilicias existentes en la ciudad, los vigentes a\nla fecha de sanción de la presente Carta Orgánica, establecidos en el actual Código y hasta tanto se sancione el\nnuevo.\nLa Ordenanza que regule los factores de ocupación, alturas y unidades de vivienda deberá ser sancionada dentro de\nun año de entrada en vigencia de esta Carta Orgánica.\n\n",
      "co:inicioCaracter": 45899,
      "co:finCaracter": 46530,
      "co:inicioTexto": 45912,
      "co:finTexto": 46530,
      "co:caracteresTexto": 618,
      "co:marcadorArticulo": "Artículo 74: ",
      "co:encabezadoPrevioLiteral": "###### CÓDIGO DE EDIFICACIÓN Y URBANISMO\n",
      "co:inicioEncabezado": 45858,
      "co:finEncabezado": 45899,
      "co:epigrafe": "CÓDIGO DE EDIFICACIÓN Y URBANISMO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/75",
      "@type": "co:Articulo",
      "identifier": "75",
      "name": "Artículo 75",
      "position": 75,
      "text": "El Municipio regula el uso del suelo de los terrenos incorporados al ejido municipal como ampliación\nde éste, en el término de un año a partir de la vigencia de la presente Carta Orgánica, a través del Plan de Desarrollo\nUrbano Ambiental, el que es elaborado por el Consejo de Planificación Urbana y aprobado por el Concejo de\nRepresentantes  mediante ordenanza sancionada por  el procedimiento de doble lectura y Audiencia Pública.\n(Consejo creado por Ordenanza 4951 y modificatorias)\nHasta tanto se apruebe el referido plan, las zonas de ampliación del ejido no se incorporarán a la calificada por la\nreglamentación vigente como zona \"a\" de prestación de servicios. Tampoco se autorizará uso alguno que suponga\nmodificación del estado actual, ya sean construcciones, nuevos usos del suelo o modificaciones del fraccionamiento\nexistente.\n\n",
      "co:inicioCaracter": 46576,
      "co:finCaracter": 47429,
      "co:inicioTexto": 46589,
      "co:finTexto": 47429,
      "co:caracteresTexto": 840,
      "co:marcadorArticulo": "Artículo 75: ",
      "co:encabezadoPrevioLiteral": "###### USO DEL SUELO DE TERRENOS INCORPORADOS\n",
      "co:inicioEncabezado": 46530,
      "co:finEncabezado": 46576,
      "co:epigrafe": "USO DEL SUELO DE TERRENOS INCORPORADOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/76",
      "@type": "co:Articulo",
      "identifier": "76",
      "name": "Artículo 76",
      "position": 76,
      "text": "El Municipio prohíbe la creación de barrios o urbanizaciones cerradas.\n\n",
      "co:inicioCaracter": 47448,
      "co:finCaracter": 47533,
      "co:inicioTexto": 47461,
      "co:finTexto": 47533,
      "co:caracteresTexto": 72,
      "co:marcadorArticulo": "Artículo 76: ",
      "co:encabezadoPrevioLiteral": "###### PROHIBICIÓN\n",
      "co:inicioEncabezado": 47429,
      "co:finEncabezado": 47448,
      "co:epigrafe": "PROHIBICIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/77",
      "@type": "co:Articulo",
      "identifier": "77",
      "name": "Artículo 77",
      "position": 77,
      "text": "El Municipio planifica su desarrollo urbano ambiental en forma participativa, a los fines de darle una\nimpronta de ciudad turística moderna, en base a las siguientes pautas:\n1.       Planificar su desarrollo urbano, rural y ambiental en forma participativa, atendiendo a las necesidades de\nlos vecinos y a la integración de las diferentes actividades, en un marco de equidad social.\n2.       Preservar y defender el ambiente, en resguardo de las generaciones presentes y futuras.\n3.      Reglamentar  la zonificación de  la ciudad, elaborando y coordinando planes urbanísticos y edilicios\ntendientes a regular un desarrollo y crecimiento del Municipio integrado y articulado con su entorno local y\nregional, preservando el medio ambiente.\n4.      Regular el uso del suelo y su utilización especifica, evitando y controlando contaminaciones de cualquier\ntipo.\n5.      Determinar nuevas  zonas, ampliar el ejido urbano y autorizar nuevos  barrios y loteos, regulando el uso\ndel suelo, su utilización y normativas.\n6.       Preservar y renovar las áreas y componentes del patrimonio histórico, urbano, arquitectónico, arqueológico,\nturístico y paisajístico, reconociendo su carácter de patrimonio colectivo de la comunidad.\n7.       Proyectar y ejecutar las obras de infraestructura, equipamientos y servicios públicos en concordancia con\nlos planes de desarrollo urbano, rural, social y ambiental, coordinando su accionar con la Provincia, la Nación y los\norganismos nacionales e internacionales.\n8.      Implementar la participación, mediante concursos abiertos, para la elaboración de ideas y proyectos en\nobras municipales y acciones de significación urbana.\n9.      Promover políticas de tránsito, mediante principios de circulación de peatones y   vehículos basados en la\nfluidez, la seguridad vial, la salud humana, la calidad y la eficiencia, preservando el medio ambiente y respetando\nlos planes de riesgos existentes o a crearse.\n\n\n10.     Determinar criterios restrictivos de utilización del suelo en laderas.\n11.      Autorizar y controlar las construcciones, conjuntamente con las instituciones de profesionales habilitadas a\ntales fines, reservándose el poder de policía.\n12.     Previo a toda autorización de loteo o construcción de cualquier tipo, deberán garantizarse los servicios y las\nempresas prestadoras están obligadas a otorgar su factibilidad.\n\n",
      "co:inicioCaracter": 47568,
      "co:finCaracter": 49948,
      "co:inicioTexto": 47581,
      "co:finTexto": 49948,
      "co:caracteresTexto": 2367,
      "co:marcadorArticulo": "Artículo 77: ",
      "co:encabezadoPrevioLiteral": "###### DESARROLLO URBANO AMBIENTAL\n",
      "co:inicioEncabezado": 47533,
      "co:finEncabezado": 47568,
      "co:epigrafe": "DESARROLLO URBANO AMBIENTAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/78",
      "@type": "co:Articulo",
      "identifier": "78",
      "name": "Artículo 78",
      "position": 78,
      "text": "Para el logro de estos objetivos se crea el Consejo de Planificación Urbano Ambiental, de carácter\npermanente y honorario, integrado por el Departamento Ejecutivo,  el Concejo de Representantes e  instituciones\nespecializadas en  el tema.\nEste Consejo proporcionará las pautas para el dictado del Código de Edificación y Desarrollo Urbano Ambiental y\nsus eventuales modificaciones. Deberá zonificar la Ciudad a los fines de un crecimiento armónico acorde con una\nciudad turística moderna, contemplando tanto el equipamiento  de la ciudad como el necesario para el desarrollo\nde un turismo sustentable. Deberá asegurar los servicios esenciales de manera acorde a la densidad poblacional,\nmediante su uso racional, preservando los necesarios para las generaciones futuras e  imprimiéndole a cada barrio\nuna característica propia y a la ciudad una clara imagen de ciudad  turística. La ordenanza  determinará su\nconformación, funciones y procedimiento al que deberá ajustarse.\n.Este Consejo  creará  un ámbito de trabajo con los centros vecinales y demás instituciones que crea necesario, para\nuna conclusión integral y participativa.\nContará con presupuesto propio, un sitio físico debidamente equipado donde realizar sus actividades y personal\nadministrativo.\nLa totalidad de reglamentaciones sobre urbanismo y ambiente deberán formar parte del Código que se dicte y\nadaptarse a él.\nEl Código de Edificación y Desarrollo Urbano Ambiental a dictarse podrá ser objeto de aprobaciones parciales\ncuando el Consejo de Planificación lo considere oportuno.  El Concejo de Representantes debe darle a estos\nproyectos tratamiento de urgencia. Para su modificación, se requiere mayoría agravada y doble lectura, previo\ndictamen del Consejo de Planificación Urbano Ambiental. Ningún tema contemplado en el Código podrá ser objeto\nde modificación por ordenanza de excepción.\n",
      "co:inicioCaracter": 50058,
      "co:finCaracter": 51933,
      "co:inicioTexto": 50071,
      "co:finTexto": 51933,
      "co:caracteresTexto": 1862,
      "co:marcadorArticulo": "Artículo 78: ",
      "co:encabezadoPrevioLiteral": "###### CONSEJO DE PLANIFICACIÓN URBANO-AMBIENTAL    (Consejo  creado  por  Ordenanza  4951  y\nmodificatorias)\n",
      "co:inicioEncabezado": 49948,
      "co:finEncabezado": 50058,
      "co:epigrafe": "CONSEJO DE PLANIFICACIÓN URBANO-AMBIENTAL    (Consejo  creado  por  Ordenanza  4951  y\nmodificatorias)",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/79",
      "@type": "co:Articulo",
      "identifier": "79",
      "name": "Artículo 79",
      "position": 79,
      "text": "El Concejo de Representantes deberá, en el término de sesenta (60) días, dictar la ordenanza para la\nconformación del Consejo de Planificación Urbano Ambiental.\nDentro de los doscientos cuarenta (240) días posteriores a su conformación, el Consejo de Planificación Urbano\nAmbiental deberá proporcionar pautas para el dictado de normas sobre alturas, factores de ocupación y unidades de\nviviendas por lotes.\n El Concejo de Representantes deberá dar tratamiento a estos lineamientos dentro de los sesenta (60) días de haber\nsido elevados.\n",
      "co:inicioCaracter": 51947,
      "co:finCaracter": 52497,
      "co:inicioTexto": 51960,
      "co:finTexto": 52497,
      "co:caracteresTexto": 537,
      "co:marcadorArticulo": "Artículo 79: ",
      "co:encabezadoPrevioLiteral": "###### PLAZOS\n",
      "co:inicioEncabezado": 51933,
      "co:finEncabezado": 51947,
      "co:epigrafe": "PLAZOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/4"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/80",
      "@type": "co:Articulo",
      "identifier": "80",
      "name": "Artículo 80",
      "position": 80,
      "text": "El Municipio favorece y promueve la radicación de industrias y unidades productivas no contaminantes\ny el desarrollo de las existentes, en particular aquellas afines al turismo.\nSostiene y apoya planes especiales de promoción económica, pudiendo establecer regímenes impositivos de\nexcepción y celebrar convenios interjurisdiccionales.\n\n",
      "co:inicioCaracter": 52572,
      "co:finCaracter": 52922,
      "co:inicioTexto": 52585,
      "co:finTexto": 52922,
      "co:caracteresTexto": 337,
      "co:marcadorArticulo": "Artículo 80: ",
      "co:encabezadoPrevioLiteral": "###### PRODUCCIÓN.\n",
      "co:inicioEncabezado": 52553,
      "co:finEncabezado": 52572,
      "co:epigrafe": "PRODUCCIÓN.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/5"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/5"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/81",
      "@type": "co:Articulo",
      "identifier": "81",
      "name": "Artículo 81",
      "position": 81,
      "text": "El Municipio coordina políticas públicas con la Provincia, la Nación, organismos nacionales y/o\ninternacionales.\n",
      "co:inicioCaracter": 52964,
      "co:finCaracter": 53090,
      "co:inicioTexto": 52977,
      "co:finTexto": 53090,
      "co:caracteresTexto": 113,
      "co:marcadorArticulo": "Artículo 81: ",
      "co:encabezadoPrevioLiteral": "###### COORDINACIÓN DE POLÍTICAS PÚBLICAS\n",
      "co:inicioEncabezado": 52922,
      "co:finEncabezado": 52964,
      "co:epigrafe": "COORDINACIÓN DE POLÍTICAS PÚBLICAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/5"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/5"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/82",
      "@type": "co:Articulo",
      "identifier": "82",
      "name": "Artículo 82",
      "position": 82,
      "text": "El municipio planifica su gestión de manera anual y plurianual, con  la   participación de los\nfuncionarios del Departamento Ejecutivo, el Concejo de Representantes y los vecinos. A tal fin, adopta el método de\nPresupuesto por programas y participativo.\n\n",
      "co:inicioCaracter": 53238,
      "co:finCaracter": 53506,
      "co:inicioTexto": 53251,
      "co:finTexto": 53506,
      "co:caracteresTexto": 255,
      "co:marcadorArticulo": "Artículo 82: ",
      "co:encabezadoPrevioLiteral": "###### ASPECTOS GENERALES\n",
      "co:inicioEncabezado": 53212,
      "co:finEncabezado": 53238,
      "co:epigrafe": "ASPECTOS GENERALES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/83",
      "@type": "co:Articulo",
      "identifier": "83",
      "name": "Artículo 83",
      "position": 83,
      "text": "Se define como participativo al Presupuesto elaborado de acuerdo con los lineamientos establecidos en\nel artículo 93  denominado: \"De los lineamientos generales\".\n",
      "co:inicioCaracter": 53576,
      "co:finCaracter": 53752,
      "co:inicioTexto": 53589,
      "co:finTexto": 53752,
      "co:caracteresTexto": 163,
      "co:marcadorArticulo": "Artículo 83: ",
      "co:encabezadoPrevioLiteral": "###### PRESUPUESTO PARTICIPATIVO    Reglamentado por Ordenanza 4950 -\n",
      "co:inicioEncabezado": 53506,
      "co:finEncabezado": 53576,
      "co:epigrafe": "PRESUPUESTO PARTICIPATIVO    Reglamentado por Ordenanza 4950 -",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/84",
      "@type": "co:Articulo",
      "identifier": "84",
      "name": "Artículo 84",
      "position": 84,
      "text": "El ejercicio financiero coincide con el año calendario. Comienza el 1 de  Enero y finaliza el 31 de\nDiciembre de cada año.\n\n",
      "co:inicioCaracter": 53780,
      "co:finCaracter": 53917,
      "co:inicioTexto": 53793,
      "co:finTexto": 53917,
      "co:caracteresTexto": 124,
      "co:marcadorArticulo": "Artículo 84: ",
      "co:encabezadoPrevioLiteral": "###### EJERCICIO FINANCIERO\n",
      "co:inicioEncabezado": 53752,
      "co:finEncabezado": 53780,
      "co:epigrafe": "EJERCICIO FINANCIERO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/85",
      "@type": "co:Articulo",
      "identifier": "85",
      "name": "Artículo 85",
      "position": 85,
      "text": "Son recursos municipales los provenientes de:\n1.      Las rentas de sus bienes propios, de la actividad económica que realiza y de los servicios que presta.\n2.     La recaudación por tributos, derechos, precios públicos y cualquier otro gravamen creado o a crearse para\nel cumplimiento de los fines y actividades propias.\n3.       Multas.\n4.      Los empréstitos, operaciones de créditos, donaciones, legados, subsidios y aportes provenientes de los\nconvenios especiales que no sean reintegrables.\n5.      Las coparticipaciones provinciales y federales.\n6.      Los excedentes o superávit de los ejercicios anteriores, debidamente certificados al momento de su\ninclusión presupuestaria.\n7.     Todo otro ingreso de capital originado por actos de disposición, administración o explotación de su\npatrimonio.\n\n",
      "co:inicioCaracter": 53933,
      "co:finCaracter": 54753,
      "co:inicioTexto": 53946,
      "co:finTexto": 54753,
      "co:caracteresTexto": 807,
      "co:marcadorArticulo": "Artículo 85: ",
      "co:encabezadoPrevioLiteral": "###### RECURSOS\n",
      "co:inicioEncabezado": 53917,
      "co:finEncabezado": 53933,
      "co:epigrafe": "RECURSOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/86",
      "@type": "co:Articulo",
      "identifier": "86",
      "name": "Artículo 86",
      "position": 86,
      "text": "Las obras públicas que se declaren de interés municipal se pueden financiar con gravámenes comunes a\ntodos los contribuyentes del Municipio, sean o no directamente beneficiados por ellas.\nLas contribuciones especiales o generales, así como la afectación de los recursos obtenidos, se reglamentan por\nordenanza.\n\n",
      "co:inicioCaracter": 54787,
      "co:finCaracter": 55112,
      "co:inicioTexto": 54800,
      "co:finTexto": 55112,
      "co:caracteresTexto": 312,
      "co:marcadorArticulo": "Artículo 86: ",
      "co:encabezadoPrevioLiteral": "###### OBRAS DE INTERÉS MUNICIPAL\n",
      "co:inicioEncabezado": 54753,
      "co:finEncabezado": 54787,
      "co:epigrafe": "OBRAS DE INTERÉS MUNICIPAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/87",
      "@type": "co:Articulo",
      "identifier": "87",
      "name": "Artículo 87",
      "position": 87,
      "text": "El Municipio establece el sistema de cooperación, fiscalización y administración en forma armonizada\ncon la Provincia  y la Nación para fijar gravámenes, sin vulnerar la autonomía municipal.\n\n",
      "co:inicioCaracter": 55132,
      "co:finCaracter": 55337,
      "co:inicioTexto": 55145,
      "co:finTexto": 55337,
      "co:caracteresTexto": 192,
      "co:marcadorArticulo": "Artículo 87: ",
      "co:encabezadoPrevioLiteral": "###### ARMONIZACIÓN\n",
      "co:inicioEncabezado": 55112,
      "co:finEncabezado": 55132,
      "co:epigrafe": "ARMONIZACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/88",
      "@type": "co:Articulo",
      "identifier": "88",
      "name": "Artículo 88",
      "position": 88,
      "text": "Ninguna disposición legal podrá disminuir el monto de los tributos una vez que hayan vencido los\ntérminos generales para su pago, en beneficio de los morosos o evasores de las obligaciones fiscales.\n\n",
      "co:inicioCaracter": 55356,
      "co:finCaracter": 55569,
      "co:inicioTexto": 55369,
      "co:finTexto": 55569,
      "co:caracteresTexto": 200,
      "co:marcadorArticulo": "Artículo 88: ",
      "co:encabezadoPrevioLiteral": "###### PROHIBICIÓN\n",
      "co:inicioEncabezado": 55337,
      "co:finEncabezado": 55356,
      "co:epigrafe": "PROHIBICIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/89",
      "@type": "co:Articulo",
      "identifier": "89",
      "name": "Artículo 89",
      "position": 89,
      "text": "El Municipio puede contraer créditos o empréstitos, con afectación específica para obras públicas,\nadquisición  de bienes, conversión de  la deuda existente, atención de situaciones o gastos excepcionales e\nimpostergables o de emergencia pública. En ningún caso podrá aplicarse para financiar gastos corrientes o para\ncancelar o disminuir déficit.\nEl pago de la amortización del capital e intereses de la totalidad de los créditos o empréstitos, corrientes y no\ncorrientes, no debe comprometer más de la quinta parte de los recursos del ejercicio, excluido el derivado del crédito\ny la contratación de empréstitos.\nEn todos los supuestos se destina un fondo de amortización de ampliación específica.\nEn todos los casos se requiere informe técnico emitido por el área competente del Departamento Ejecutivo\nMunicipal,  del que debe  surgir:  el  destino de  los  fondos, debidamente fundamentado;  la  afectación  del\nendeudamiento en los recursos ordinarios; el flujo de los fondos a comprometer por amortización de capital e\nintereses en los ejercicios que se afecten; el análisis de conveniencia de tasas,\nplazos y condiciones.\nEn caso que el financiamiento afecte a más de un ejercicio financiero, se requerirá autorización previa del Concejo\nde Representantes mediante ordenanza aprobada por mayoría agravada. En caso que no se respeten los supuestos\n\n\nprecedentes, se considerará mal desempeño.\n\n",
      "co:inicioCaracter": 55588,
      "co:finCaracter": 57001,
      "co:inicioTexto": 55601,
      "co:finTexto": 57001,
      "co:caracteresTexto": 1400,
      "co:marcadorArticulo": "Artículo 89: ",
      "co:encabezadoPrevioLiteral": "###### EMPRÉSTITOS\n",
      "co:inicioEncabezado": 55569,
      "co:finEncabezado": 55588,
      "co:epigrafe": "EMPRÉSTITOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/90",
      "@type": "co:Articulo",
      "identifier": "90",
      "name": "Artículo 90",
      "position": 90,
      "text": "El presupuesto es  el instrumento financiero del programa de gobierno y de su control. Puede\nproyectarse por más de un ejercicio, sin exceder el término del mandato del titular del Departamento Ejecutivo,\nsalvo el período restante al año calendario en curso al momento de cambio de mandato.  Prevé los recursos\npertinentes, autoriza  las inversiones y gastos,  fija  el número de personal de planta permanente, contratada,\ntransitoria, de gabinete y sujeto a locaciones de servicios y explicita los objetivos que deben ser cuantificados,\ncuando su naturaleza lo permita.\nEl presupuesto debe ser analítico, programático, participativo y comprender la totalidad de los gastos y recursos,\nclasificados de tal forma que pueda determinarse con precisión y claridad su naturaleza, origen, monto y jurisdicción\na la que fueron asignados.\nLas empresas y entes autárquicos municipales se rigen por sus propios presupuestos, en las condiciones y plazos\nestablecidos en esta Carta Orgánica y las correspondientes ordenanzas.\nEl Concejo de Representantes no puede sancionar ordenanzas que importen gastos sin establecer los recursos\nnecesarios para satisfacerlos, cuando no existan fondos disponibles asignados dentro del presupuesto general. Es\nnula toda ordenanza sancionada en violación de esta norma.\nDurante la ejecución del presupuesto no pueden comprometerse afectaciones futuras, salvo en aquellos casos\nespecificados en las ordenanzas respectivas.\nEn caso de situación de crisis económico-financiera se implementa, a solicitud y previa emisión de informe del\nDepartamento Ejecutivo Municipal, a través de la ordenanza respectiva, un plan de saneamiento de corto, mediano y\nlargo plazo, previa declaración de emergencia, en salvaguarda del bien común. El Departamento Ejecutivo\nMunicipal deberá comunicarlo  al Concejo de Representantes en un plazo máximo de  tres (3) días hábiles\nadministrativos de haberlo realizado. Estas autorizaciones, así dispuestas, se incorporarán al presupuesto general.\n\n",
      "co:inicioCaracter": 57020,
      "co:finCaracter": 59028,
      "co:inicioTexto": 57033,
      "co:finTexto": 59028,
      "co:caracteresTexto": 1995,
      "co:marcadorArticulo": "Artículo 90: ",
      "co:encabezadoPrevioLiteral": "###### PRESUPUESTO\n",
      "co:inicioEncabezado": 57001,
      "co:finEncabezado": 57020,
      "co:epigrafe": "PRESUPUESTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/91",
      "@type": "co:Articulo",
      "identifier": "91",
      "name": "Artículo 91",
      "position": 91,
      "text": "Si al uno (1) de diciembre el presupuesto no ha sido aprobado por el Concejo de Representantes se le\nimpone en forma automática el trámite de urgencia, debiendo el Cuerpo sancionarlo en un plazo de treinta (30) días\ncorridos. Dicho trámite de urgencia no puede ser rechazado por el Concejo de Representantes.\nSi al treinta y uno (31) de diciembre no se hubiera producido la sanción de la ordenanza respectiva, sólo se permitirá\nla reconducción presupuestaria para atender los gastos inherentes a los servicios públicos esenciales, al pago de los\nsueldos del personal de planta permanente, contratada, transitoria y de gabinete, y planes sociales.\n\n",
      "co:inicioCaracter": 59043,
      "co:finCaracter": 59704,
      "co:inicioTexto": 59056,
      "co:finTexto": 59704,
      "co:caracteresTexto": 648,
      "co:marcadorArticulo": "Artículo 91: ",
      "co:encabezadoPrevioLiteral": "###### TRÁMITE\n",
      "co:inicioEncabezado": 59028,
      "co:finEncabezado": 59043,
      "co:epigrafe": "TRÁMITE",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/92",
      "@type": "co:Articulo",
      "identifier": "92",
      "name": "Artículo 92",
      "position": 92,
      "text": "El presupuesto debe exteriorizar el nivel general de endeudamiento del Municipio y no puede incluir\npartida alguna destinada a gastos sobre los que no deba rendirse cuenta.\n\n",
      "co:inicioCaracter": 59723,
      "co:finCaracter": 59910,
      "co:inicioTexto": 59736,
      "co:finTexto": 59910,
      "co:caracteresTexto": 174,
      "co:marcadorArticulo": "Artículo 92: ",
      "co:encabezadoPrevioLiteral": "###### IMPEDIMENTO\n",
      "co:inicioEncabezado": 59704,
      "co:finEncabezado": 59723,
      "co:epigrafe": "IMPEDIMENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/93",
      "@type": "co:Articulo",
      "identifier": "93",
      "name": "Artículo 93",
      "position": 93,
      "text": "El Departamento Ejecutivo fija anualmente los lineamientos generales para la formulación del proyecto\nde Ordenanza de Presupuesto General. Con una antelación no menor a tres meses de su remisión al Concejo de\nRepresentantes, invita de manera fehaciente a las distintas áreas que componen el Municipio, al Concejo de\nRepresentantes y a los vecinos a remitir las propuestas de presupuesto, en relación a su área, respetando los\nobjetivos fijados en conjunto entre el Concejo de Representantes y  el Departamento Ejecutivo, estableciendo un\nplazo límite para la recepción de aquellas. Las proposiciones deben ser fundadas y asignar responsabilidad a los\nfuncionarios que corresponda.\n\n",
      "co:inicioCaracter": 59940,
      "co:finCaracter": 60635,
      "co:inicioTexto": 59953,
      "co:finTexto": 60635,
      "co:caracteresTexto": 682,
      "co:marcadorArticulo": "Artículo 93: ",
      "co:encabezadoPrevioLiteral": "###### LINEAMIENTOS GENERALES\n",
      "co:inicioEncabezado": 59910,
      "co:finEncabezado": 59940,
      "co:epigrafe": "LINEAMIENTOS GENERALES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/94",
      "@type": "co:Articulo",
      "identifier": "94",
      "name": "Artículo 94",
      "position": 94,
      "text": "Sobre la base de las propuestas recibidas por las distintas dependencias municipales, el Concejo de\nRepresentantes y los vecinos, y con los ajustes que resulte necesario introducir,  el Departamento Ejecutivo\nconfecciona el proyecto de Presupuesto general, que debe contener al menos las siguientes informaciones:\n1.       Presupuesto de recursos de la Administración Municipal;\n2.       Presupuesto de gastos de cada una de las dependencias municipales, identificando la producción y los\ncréditos presupuestarios;\n3.       Créditos presupuestarios asignados a cada uno de los programas que se prevean ejecutar;\n4.      Resultados de las cuentas corriente y de capital para la Administración municipal.\nEl Reglamento establece en forma detallada otras informaciones a ser presentadas al Concejo de Representantes.\n\n\n",
      "co:inicioCaracter": 60674,
      "co:finCaracter": 61503,
      "co:inicioTexto": 60687,
      "co:finTexto": 61503,
      "co:caracteresTexto": 816,
      "co:marcadorArticulo": "Artículo 94: ",
      "co:encabezadoPrevioLiteral": "###### PROYECTO DE PRESUPUESTO GENERAL\n",
      "co:inicioEncabezado": 60635,
      "co:finEncabezado": 60674,
      "co:epigrafe": "PROYECTO DE PRESUPUESTO GENERAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/95",
      "@type": "co:Articulo",
      "identifier": "95",
      "name": "Artículo 95",
      "position": 95,
      "text": "El Departamento Ejecutivo eleva el proyecto de Ordenanza de Presupuesto General al Concejo de\nRepresentantes, antes del 30 de octubre del año inmediato anterior. Debe acompañarlo de un mensaje explicativo\nque contenga los fundamentos de sus términos económicos-financieros, del programa de gobierno y las propuestas\nelaboradas por cada una de las áreas, así como las demás informaciones y elementos de juicio que estime oportuno.\n\n",
      "co:inicioCaracter": 61520,
      "co:finCaracter": 61964,
      "co:inicioTexto": 61533,
      "co:finTexto": 61964,
      "co:caracteresTexto": 431,
      "co:marcadorArticulo": "Artículo 95: ",
      "co:encabezadoPrevioLiteral": "###### ELEVACIÓN\n",
      "co:inicioEncabezado": 61503,
      "co:finEncabezado": 61520,
      "co:epigrafe": "ELEVACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/96",
      "@type": "co:Articulo",
      "identifier": "96",
      "name": "Artículo 96",
      "position": 96,
      "text": "El Concejo de Representantes dicta una ordenanza que regule el mecanismo de autorización de gastos\nno previstos en el Presupuesto Anual.\n\n",
      "co:inicioCaracter": 61991,
      "co:finCaracter": 62142,
      "co:inicioTexto": 62004,
      "co:finTexto": 62142,
      "co:caracteresTexto": 138,
      "co:marcadorArticulo": "Artículo 96: ",
      "co:encabezadoPrevioLiteral": "###### GASTOS NO PREVISTOS\n",
      "co:inicioEncabezado": 61964,
      "co:finEncabezado": 61991,
      "co:epigrafe": "GASTOS NO PREVISTOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/97",
      "@type": "co:Articulo",
      "identifier": "97",
      "name": "Artículo 97",
      "position": 97,
      "text": "Los créditos del presupuesto de gastos, con los niveles de desagregación que haya aprobado el Concejo\nde Representantes, constituyen el límite máximo  de las autorizaciones disponibles para gastar. El crédito asignado\na cada concepto sólo puede ser aplicado para atender las erogaciones previstas. La Ordenanza de Presupuesto\ndetermina el grado de flexibilidad para compensar partidas de acuerdo al nomenclador en vigencia. Puede incluir\ncréditos de refuerzo calculados sobre la base de previsiones estimadas, que podrán  ser rectificadas durante el\nejercicio. Del  total de  los recursos propios estimados, debe  asignar, como mínimo,  los porcentajes que a\ncontinuación se detallan, destinándolos a cada una de las siguientes políticas especiales:\n1.       Cultura: uno (1) por ciento.\n2.      Deporte y Recreación : dos (2) por ciento.\n3.      Personas con capacidades diferentes: cero con cincuenta centésimos (0,50) por ciento.\n4.       Tercera edad: cero con cincuenta centésimos (0,50) por ciento.\n5.      Lucha contra la pobreza: uno (1) por ciento.\n\n",
      "co:inicioCaracter": 62172,
      "co:finCaracter": 63244,
      "co:inicioTexto": 62185,
      "co:finTexto": 63244,
      "co:caracteresTexto": 1059,
      "co:marcadorArticulo": "Artículo 97: ",
      "co:encabezadoPrevioLiteral": "###### ASIGNACIÓN DEL CRÉDITO\n",
      "co:inicioEncabezado": 62142,
      "co:finEncabezado": 62172,
      "co:epigrafe": "ASIGNACIÓN DEL CRÉDITO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/98",
      "@type": "co:Articulo",
      "identifier": "98",
      "name": "Artículo 98",
      "position": 98,
      "text": "No pueden comprometerse erogaciones que representen afectaciones de créditos de presupuestos para\nejercicios futuros, excepto en los siguientes casos:\n1.      Para obras públicas a efectuarse en más de un ejercicio financiero.\n2.      Para operaciones de crédito o financiamiento especial destinadas a adquisiciones, obras y trabajos.\n3.      Para las provisiones y locaciones  de obras y servicios.\n4.      Para la locación o adquisición de muebles e inmuebles.\nEn cualquiera de los supuestos anteriores, será necesaria la confección del presupuesto plurianual.\n\n",
      "co:inicioCaracter": 63298,
      "co:finCaracter": 63875,
      "co:inicioTexto": 63311,
      "co:finTexto": 63875,
      "co:caracteresTexto": 564,
      "co:marcadorArticulo": "Artículo 98: ",
      "co:encabezadoPrevioLiteral": "###### AFECTACIÓN DE CRÉDITOS PARA EJERCICIOS FUTUROS\n",
      "co:inicioEncabezado": 63244,
      "co:finEncabezado": 63298,
      "co:epigrafe": "AFECTACIÓN DE CRÉDITOS PARA EJERCICIOS FUTUROS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/99",
      "@type": "co:Articulo",
      "identifier": "99",
      "name": "Artículo 99",
      "position": 99,
      "text": "No se podrán adquirir compromisos para los cuales no queden saldos disponibles de créditos\npresupuestarios, ni disponer de los créditos  para una finalidad distinta de la prevista, salvo los supuestos especiales\nestablecidos en esta Carta Orgánica.\n\n",
      "co:inicioCaracter": 63894,
      "co:finCaracter": 64157,
      "co:inicioTexto": 63907,
      "co:finTexto": 64157,
      "co:caracteresTexto": 250,
      "co:marcadorArticulo": "Artículo 99: ",
      "co:encabezadoPrevioLiteral": "###### PROHIBICIÓN\n",
      "co:inicioEncabezado": 63875,
      "co:finEncabezado": 63894,
      "co:epigrafe": "PROHIBICIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/100",
      "@type": "co:Articulo",
      "identifier": "100",
      "name": "Artículo 100",
      "position": 100,
      "text": "Las cuentas del presupuesto de recursos y gastos se cierran el 31 de diciembre de cada año. Después\nde esa fecha, los recursos que se recauden se consideran parte del presupuesto vigente en el momento, con\nindependencia de la fecha en que se hubiere originado  la obligación de pago o la liquidación de ellos.\nCon  posterioridad al 31 de diciembre de cada año no podrán asumirse compromisos ni devengarse gastos con\ncargo al ejercicio que se cierra en esa fecha.\n\n",
      "co:inicioCaracter": 64186,
      "co:finCaracter": 64664,
      "co:inicioTexto": 64200,
      "co:finTexto": 64664,
      "co:caracteresTexto": 464,
      "co:marcadorArticulo": "Artículo 100: ",
      "co:encabezadoPrevioLiteral": "###### DEL CIERRE DE CUENTAS\n",
      "co:inicioEncabezado": 64157,
      "co:finEncabezado": 64186,
      "co:epigrafe": "DEL CIERRE DE CUENTAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/101",
      "@type": "co:Articulo",
      "identifier": "101",
      "name": "Artículo 101",
      "position": 101,
      "text": "Los gastos devengados y no pagados al 31 de diciembre de cada año se cancelan durante el año\nsiguiente, con cargo a las disponibilidades en caja y bancos existentes a la fecha señalada.\nLos gastos comprometidos y no devengados al 31 de diciembre de cada año, se afectan automáticamente al ejercicio\nsiguiente, imputándoselos a los créditos disponibles para ese ejercicio.\nLa reglamentación que a tal efecto dicte el Concejo de Representantes dispondrá los plazos y mecanismos para la\naplicación de estas disposiciones.\n\n",
      "co:inicioCaracter": 64689,
      "co:finCaracter": 65223,
      "co:inicioTexto": 64703,
      "co:finTexto": 65223,
      "co:caracteresTexto": 520,
      "co:marcadorArticulo": "Artículo 101: ",
      "co:encabezadoPrevioLiteral": "###### GASTOS DEVENGADOS\n",
      "co:inicioEncabezado": 64664,
      "co:finEncabezado": 64689,
      "co:epigrafe": "GASTOS DEVENGADOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/102",
      "@type": "co:Articulo",
      "identifier": "102",
      "name": "Artículo 102",
      "position": 102,
      "text": "Toda enajenación, adquisición, otorgamiento de concesiones y cualquier otro contrato que celebre el\n\n\nMunicipio, se efectúa de acuerdo a las ordenanzas que al efecto se dicten, las que aseguran un procedimiento de\nselección que garantice  la razonabilidad del precio,  la imparcialidad y la igualdad de oportunidades de los\ninteresados.\nSerá nula toda contratación que no respete los principios precedentemente expuestos y el funcionario que la realice,\nautorice o consienta incurrirá en falta grave y debe ser denunciado ante el Tribunal competente.\n",
      "co:inicioCaracter": 65245,
      "co:finCaracter": 65810,
      "co:inicioTexto": 65259,
      "co:finTexto": 65810,
      "co:caracteresTexto": 551,
      "co:marcadorArticulo": "Artículo 102: ",
      "co:encabezadoPrevioLiteral": "###### CONTRATACIONES\n",
      "co:inicioEncabezado": 65223,
      "co:finEncabezado": 65245,
      "co:epigrafe": "CONTRATACIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/6"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/103",
      "@type": "co:Articulo",
      "identifier": "103",
      "name": "Artículo 103",
      "position": 103,
      "text": "El régimen de empleo municipal debe contener y hacer respetar los derechos consagrados en las\nnormas laborales vigentes. Regirá para sus agentes en todas las modalidades laborales.\nEl ingreso a la planta permanente de la administración pública municipal se realiza mediante concurso público, que\nasegure igualdad de oportunidades. En él se asignará un puntaje significativo a aquellos postulantes que acrediten\ncapacidad y experiencia en la función. El Sindicato de Empleados Municipales está facultado para fiscalizar dicho\nconcurso.\nQuedan establecidas cuatro categorías de empleo municipal:\n1. Personal Permanente.\n2.       Personal Contratado.\n3.       Personal Transitorio.\n4.       Personal de Gabinete.\nLos agentes municipales Permanentes tienen estabilidad y no pueden ser removidos de sus cargos sin causa fundada\ny sin sumario administrativo previo. Son responsables civil, penal y administrativamente de sus actos.\nEl Concejo de Representantes asigna anualmente en el presupuesto la cantidad de cargos a concursar para ingresar a\nla planta Permanente. Las vacantes que se produzcan entre los Contratados serán cubiertas por la planta Transitoria,\nsi la hubiere, en mérito a la antigüedad. La planta Transitoria solo podrá ser aumentada con acuerdo de la mayoría\nagravada del Concejo de Representantes\nEl personal de Gabinete ingresa a la administración pública con los funcionarios y se retira con ellos, gozando de los\nmismos derechos y obligaciones que el personal contratado.\nQueda prohibida cualquier contratación laboral fuera de este régimen, excepto los profesionales, quienes a su\nsolicitud podrán ser contratados por medio de locaciones de servicios.\n\n",
      "co:inicioCaracter": 65899,
      "co:finCaracter": 67585,
      "co:inicioTexto": 65913,
      "co:finTexto": 67585,
      "co:caracteresTexto": 1672,
      "co:marcadorArticulo": "Artículo 103: ",
      "co:encabezadoPrevioLiteral": "###### FORMAS DEL EMPLEO PÚBLICO MUNICIPAL\n",
      "co:inicioEncabezado": 65856,
      "co:finEncabezado": 65899,
      "co:epigrafe": "FORMAS DEL EMPLEO PÚBLICO MUNICIPAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/7"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/7"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/104",
      "@type": "co:Articulo",
      "identifier": "104",
      "name": "Artículo 104",
      "position": 104,
      "text": "El Gobierno Municipal crea una Escuela de Administración Pública con el propósito de formar y\ncapacitar, con carácter obligatorio, a funcionarios y agentes municipales. En éste último caso, resulta condición para\nlos ascensos en la carrera administrativa. El sindicato de agentes municipales participa en la dirección de la Escuela,\nen la forma y con los alcances que establezca la ordenanza que especialmente se dicta al efecto.\n\n",
      "co:inicioCaracter": 67626,
      "co:finCaracter": 68071,
      "co:inicioTexto": 67640,
      "co:finTexto": 68071,
      "co:caracteresTexto": 431,
      "co:marcadorArticulo": "Artículo 104: ",
      "co:encabezadoPrevioLiteral": "###### ESCUELA DE ADMINISTRACIÓN PÚBLICA\n",
      "co:inicioEncabezado": 67585,
      "co:finEncabezado": 67626,
      "co:epigrafe": "ESCUELA DE ADMINISTRACIÓN PÚBLICA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/7"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/7"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/105",
      "@type": "co:Articulo",
      "identifier": "105",
      "name": "Artículo 105",
      "position": 105,
      "text": "El Gobierno Municipal  garantiza  la  carrera  administrativa,  los mecanismos permanentes de\ncapacitación del personal y los sistemas de promoción que garanticen la eficiencia y el mérito como base de los\nascensos. Esta carrera será auditada y observada por el sindicato de empleados municipales.\n",
      "co:inicioCaracter": 68101,
      "co:finCaracter": 68413,
      "co:inicioTexto": 68115,
      "co:finTexto": 68413,
      "co:caracteresTexto": 298,
      "co:marcadorArticulo": "Artículo 105: ",
      "co:encabezadoPrevioLiteral": "###### CARRERA ADMINISTRATIVA\n",
      "co:inicioEncabezado": 68071,
      "co:finEncabezado": 68101,
      "co:epigrafe": "CARRERA ADMINISTRATIVA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/7"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/1"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/7"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/106",
      "@type": "co:Articulo",
      "identifier": "106",
      "name": "Artículo 106",
      "position": 106,
      "text": "El Gobierno del Municipio de Villa Carlos Paz, está integrado por un Concejo de Representantes y un\nDepartamento Ejecutivo.\n\n",
      "co:inicioCaracter": 68574,
      "co:finCaracter": 68713,
      "co:inicioTexto": 68588,
      "co:finTexto": 68713,
      "co:caracteresTexto": 125,
      "co:marcadorArticulo": "Artículo 106: ",
      "co:encabezadoPrevioLiteral": "###### COMPOSICIÓN\n",
      "co:inicioEncabezado": 68555,
      "co:finEncabezado": 68574,
      "co:epigrafe": "COMPOSICIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/5"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/5"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/107",
      "@type": "co:Articulo",
      "identifier": "107",
      "name": "Artículo 107",
      "position": 107,
      "text": "El Concejo de Representantes, el Intendente y los Secretarios del Departamento Ejecutivo Municipal\nse reunirán una vez cada tres meses  durante el período de sesiones ordinarias, en el recinto del Concejo de\nRepresentantes, con  el propósito de: intercambiar información sobre  la marcha del gobierno, dialogar sobre\nproyectos con estado legislativo, explicar propuestas de gestión y coordinar y cooperar sobre acciones de gobierno.\n",
      "co:inicioCaracter": 68738,
      "co:finCaracter": 69185,
      "co:inicioTexto": 68752,
      "co:finTexto": 69185,
      "co:caracteresTexto": 433,
      "co:marcadorArticulo": "Artículo 107: ",
      "co:encabezadoPrevioLiteral": "###### PLENO DE GOBIERNO\n",
      "co:inicioEncabezado": 68713,
      "co:finEncabezado": 68738,
      "co:epigrafe": "PLENO DE GOBIERNO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/5"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/5"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/108",
      "@type": "co:Articulo",
      "identifier": "108",
      "name": "Artículo 108",
      "position": 108,
      "text": "El Concejo de Representantes se compone de once (11) miembros. Este número se aumentará en la\ncantidad de uno (1) por cada diez mil (10.000) habitantes que se sumaren en el futuro, hasta un máximo de veinte\n(20) Concejales. A estos fines, deberán computarse los resultados que arroje el último informe del Registro Civil de\nla Ciudad de Villa Carlos Paz.\n\n",
      "co:inicioCaracter": 69302,
      "co:finCaracter": 69672,
      "co:inicioTexto": 69316,
      "co:finTexto": 69672,
      "co:caracteresTexto": 356,
      "co:marcadorArticulo": "Artículo 108: ",
      "co:encabezadoPrevioLiteral": "###### INTEGRACIÓN\n",
      "co:inicioEncabezado": 69283,
      "co:finEncabezado": 69302,
      "co:epigrafe": "INTEGRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/109",
      "@type": "co:Articulo",
      "identifier": "109",
      "name": "Artículo 109",
      "position": 109,
      "text": "Para ser Concejal se requiere:\n1.      Ser argentino, o extranjero con residencia legal en el país.\n2.      Ser mayor de edad.\n3.      Tener seis (6) años de residencia continua e inmediata anterior a la elección en el Municipio, no causando\ninterrupción la ausencia motivada por la prestación de servicios a la Nación, Provincia o Municipio u organismos\ninternacionales de los que la Nación forma parte, o por la realización de estudios de nivel terciario, universitario o\nde posgrado, o por razones de salud.\n4.      Haber votado en la elección municipal anterior o acreditado causales eximentes de esa obligación.\n\n",
      "co:inicioCaracter": 69690,
      "co:finCaracter": 70322,
      "co:inicioTexto": 69704,
      "co:finTexto": 70322,
      "co:caracteresTexto": 618,
      "co:marcadorArticulo": "Artículo 109: ",
      "co:encabezadoPrevioLiteral": "###### REQUISITOS\n",
      "co:inicioEncabezado": 69672,
      "co:finEncabezado": 69690,
      "co:epigrafe": "REQUISITOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/110",
      "@type": "co:Articulo",
      "identifier": "110",
      "name": "Artículo 110",
      "position": 110,
      "text": "Los Concejales duran cuatro años en su función. Pueden ser reelectos por una vez de manera\nconsecutiva, debiendo transcurrir un periodo completo para una nueva elección. El mandato de los Concejales cesa\nal expirar el plazo establecido, sin que evento alguno que lo haya interrumpido sea motivo para que se complete más\ntarde.\n\n",
      "co:inicioCaracter": 70361,
      "co:finCaracter": 70703,
      "co:inicioTexto": 70375,
      "co:finTexto": 70703,
      "co:caracteresTexto": 328,
      "co:marcadorArticulo": "Artículo 110: ",
      "co:encabezadoPrevioLiteral": "###### DURACIÓN DE MANDATO Y REELECIÓN\n",
      "co:inicioEncabezado": 70322,
      "co:finEncabezado": 70361,
      "co:epigrafe": "DURACIÓN DE MANDATO Y REELECIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/111",
      "@type": "co:Articulo",
      "identifier": "111",
      "name": "Artículo 111",
      "position": 111,
      "text": "El Concejo de Representantes es juez exclusivo de la validez de los títulos, calidades y derechos de\nsus miembros, de acuerdo a los antecedentes expedidos por las autoridades electorales competentes.\n\n",
      "co:inicioCaracter": 70725,
      "co:finCaracter": 70940,
      "co:inicioTexto": 70739,
      "co:finTexto": 70940,
      "co:caracteresTexto": 201,
      "co:marcadorArticulo": "Artículo 111: ",
      "co:encabezadoPrevioLiteral": "###### JUEZ EXCLUSIVO\n",
      "co:inicioEncabezado": 70703,
      "co:finEncabezado": 70725,
      "co:epigrafe": "JUEZ EXCLUSIVO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/112",
      "@type": "co:Articulo",
      "identifier": "112",
      "name": "Artículo 112",
      "position": 112,
      "text": "No pueden ser miembros del Concejo de Representantes:\n1.      Los candidatos a Intendente u otro cargo electivo municipal, provincial y/o nacional en el mismo acto\nelectoral.\n2.      Los inhabilitados para el desempeño de cargos públicos.\n3.      Los deudores del Municipio, la Provincia o la Nación que, condenados por sentencia firme, no paguen sus\ndeudas.\n4.      Los que hayan cesado en sus funciones en virtud del procedimiento de revocatoria, para el siguiente\nperíodo electoral.\n5.      Los quebrados culpables o fraudulentos que hayan sido inhabilitados por leyes nacionales y/o provinciales,\nmientras dure su inhabilitación.\n6.      Los que hayan incurrido en las previsiones establecidas en el artículo 6 (defensa de la Carta Orgánica).\n7.      Los penados por delitos dolosos, mediante sentencia firme, por un período igual al doble de su condena.\n\n\n8.      Los declarados incapaces judicialmente.-\n9.      Los deudores alimentarios condenados con sentencia firme.\n10.     Los que no pueden ser electores.\n\n",
      "co:inicioCaracter": 70961,
      "co:finCaracter": 71993,
      "co:inicioTexto": 70975,
      "co:finTexto": 71993,
      "co:caracteresTexto": 1018,
      "co:marcadorArticulo": "Artículo 112: ",
      "co:encabezadoPrevioLiteral": "###### INHABILIDADES\n",
      "co:inicioEncabezado": 70940,
      "co:finEncabezado": 70961,
      "co:epigrafe": "INHABILIDADES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/113",
      "@type": "co:Articulo",
      "identifier": "113",
      "name": "Artículo 113",
      "position": 113,
      "text": "Es  incompatible con el cargo de Concejal:\n1.       Ejercer otro cargo público electivo, salvo  el de Convencional Constituyente Nacional, Provincial o\nMunicipal.\n2.       Ejercer función o empleo remunerados en los Gobiernos nacional, provincial o municipal, excepto la\ndocencia.\n3.      Ser propietario o ejercer funciones directivas o de representación en empresas o sociedades públicas,\nprivadas o mixtas, vinculadas con el Municipio por contrato a título oneroso. Esta incompatibilidad comprende\ntambién a quienes ejercen funciones directivas o sean miembros del consejo de administración de cooperativas y/o\nde personas jurídicas de Derecho Público no estatal. Estas incompatibilidades no comprenden a los simples socios\nde sociedades por acciones o cooperativas.\n4.       Ejercer funciones directivas en instituciones intermedias.\n       Los miembros del Concejo de Representantes que por razones sobrevinientes a su elección quedan incursos\nen las causales de inhabilidad e incompatibilidad cesarán en sus funciones en la primera sesión del Cuerpo. La\ndecisión al respecto deberá ser aprobada con el voto favorable de la mayoría agravada\n\n",
      "co:inicioCaracter": 72019,
      "co:finCaracter": 73180,
      "co:inicioTexto": 72033,
      "co:finTexto": 73180,
      "co:caracteresTexto": 1147,
      "co:marcadorArticulo": "Artículo 113: ",
      "co:encabezadoPrevioLiteral": "###### INCOMPATIBILIDADES\n",
      "co:inicioEncabezado": 71993,
      "co:finEncabezado": 72019,
      "co:epigrafe": "INCOMPATIBILIDADES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/114",
      "@type": "co:Articulo",
      "identifier": "114",
      "name": "Artículo 114",
      "position": 114,
      "text": "Los Concejales percibirán durante el desempeño de su mandato una remuneración que ellos mismos\nfijarán, que deberá ser inferior  a la del Intendente. En el concepto de remuneración queda incluida toda suma de\ndinero o asignación en especie, cualquiera sea la denominación con que se la mencione.\n\n",
      "co:inicioCaracter": 73200,
      "co:finCaracter": 73511,
      "co:inicioTexto": 73214,
      "co:finTexto": 73511,
      "co:caracteresTexto": 297,
      "co:marcadorArticulo": "Artículo 114: ",
      "co:encabezadoPrevioLiteral": "###### REMUNERACIÓN\n",
      "co:inicioEncabezado": 73180,
      "co:finEncabezado": 73200,
      "co:epigrafe": "REMUNERACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/115",
      "@type": "co:Articulo",
      "identifier": "115",
      "name": "Artículo 115",
      "position": 115,
      "text": "El Concejo de Representantes reglamenta la estructura de la planta de personal que garantice su\nfuncionamiento, respetando las normas que regulan el empleo público. El personal dependiente de los Concejales y\nde los bloques políticos carece de estabilidad y cesará en cualquier circunstancia por decisión del Concejal y en\nforma automática, cuando cesen los mandatos de los Concejales que los hayan designado.-\n\n",
      "co:inicioCaracter": 73527,
      "co:finCaracter": 73952,
      "co:inicioTexto": 73540,
      "co:finTexto": 73952,
      "co:caracteresTexto": 412,
      "co:marcadorArticulo": "Artículo115: ",
      "co:encabezadoPrevioLiteral": "###### PERSONAL\n",
      "co:inicioEncabezado": 73511,
      "co:finEncabezado": 73527,
      "co:epigrafe": "PERSONAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/116",
      "@type": "co:Articulo",
      "identifier": "116",
      "name": "Artículo 116",
      "position": 116,
      "text": "El Presidente del Concejo de Representantes es un Concejal electo por los miembros del Cuerpo.\n\n",
      "co:inicioCaracter": 74000,
      "co:finCaracter": 74110,
      "co:inicioTexto": 74014,
      "co:finTexto": 74110,
      "co:caracteresTexto": 96,
      "co:marcadorArticulo": "Artículo 116: ",
      "co:encabezadoPrevioLiteral": "###### PRESIDENTE DEL CONCEJO DE REPRESENTANTES\n",
      "co:inicioEncabezado": 73952,
      "co:finEncabezado": 74000,
      "co:epigrafe": "PRESIDENTE DEL CONCEJO DE REPRESENTANTES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/117",
      "@type": "co:Articulo",
      "identifier": "117",
      "name": "Artículo 117",
      "position": 117,
      "text": "Los bloques políticos se conforman con los representantes de cada una de las listas de los partidos.\nEntre sus pares eligen su presidente.\n\n",
      "co:inicioCaracter": 74135,
      "co:finCaracter": 74289,
      "co:inicioTexto": 74149,
      "co:finTexto": 74289,
      "co:caracteresTexto": 140,
      "co:marcadorArticulo": "Artículo 117: ",
      "co:encabezadoPrevioLiteral": "###### BLOQUES POLÍTICOS\n",
      "co:inicioEncabezado": 74110,
      "co:finEncabezado": 74135,
      "co:epigrafe": "BLOQUES POLÍTICOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/118",
      "@type": "co:Articulo",
      "identifier": "118",
      "name": "Artículo 118",
      "position": 118,
      "text": "El Concejo de Representantes se reúne en Sesiones Preparatorias todos los años, con anterioridad  a\nlas Ordinarias, oportunidad en la que se elige el Presidente y demás autoridades.\nEn el caso en que corresponda, el Cuerpo se constituye después de proclamados los Concejales electos y antes que\ncesen en su mandato los salientes, a los fines de tomar juramento, juzgar los títulos de los electos y nombrar sus\nautoridades. Esta primera sesión será presidida por el Concejal  de mayor edad.\nLas Sesiones Ordinarias se realizan desde el primero de agosto hasta el treinta de junio de cada año.\nLas Sesiones Extraordinarias son convocadas por el Departamento Ejecutivo o por el Presidente del Concejo de\nRepresentantes, en este caso a pedido de un tercio de los miembros, con especificación de motivo. En ellas sólo se\ntratan los asuntos objeto de la convocatoria.\nLas sesiones son públicas, salvo los casos en que el reglamento disponga lo contrario.\n\n",
      "co:inicioCaracter": 74305,
      "co:finCaracter": 75269,
      "co:inicioTexto": 74319,
      "co:finTexto": 75269,
      "co:caracteresTexto": 950,
      "co:marcadorArticulo": "Artículo 118: ",
      "co:encabezadoPrevioLiteral": "###### SESIONES\n",
      "co:inicioEncabezado": 74289,
      "co:finEncabezado": 74305,
      "co:epigrafe": "SESIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/119",
      "@type": "co:Articulo",
      "identifier": "119",
      "name": "Artículo 119",
      "position": 119,
      "text": "Para formar quórum es necesaria la presencia de más de la mitad del número total de Concejales. El\nCuerpo puede reunirse en minoría con el objeto de conminar a los inasistentes. Si luego de dos (2) citaciones\nconsecutivas esto no se consigue, la minoría puede imponer las sanciones establecidas en su Reglamento interno.\n\n",
      "co:inicioCaracter": 75283,
      "co:finCaracter": 75619,
      "co:inicioTexto": 75297,
      "co:finTexto": 75619,
      "co:caracteresTexto": 322,
      "co:marcadorArticulo": "Artículo 119: ",
      "co:encabezadoPrevioLiteral": "###### QUÓRUM\n",
      "co:inicioEncabezado": 75269,
      "co:finEncabezado": 75283,
      "co:epigrafe": "QUÓRUM",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/120",
      "@type": "co:Articulo",
      "identifier": "120",
      "name": "Artículo 120",
      "position": 120,
      "text": "El Concejo de Representantes toma sus resoluciones por simple mayoría, con excepción de los casos\nque disponga esta Carta Orgánica o el Reglamento interno del Cuerpo. Quien ejerza la función de Presidente del\nConcejo emite su voto como miembro del Cuerpo. En caso de empate se reitera la votación y si éste subsiste, decide\nquien ejerza la Presidencia.\nSe entiende por mayoría simple el voto de más de la mitad de los miembros presentes; por mayoría absoluta más de\nla mitad del total de los miembros del Cuerpo;  por mayoría agravada a los dos tercios del total de los miembros del\nCuerpo y por mayoría extraordinaria a los cuatro quintos del total de los miembros del Cuerpo.\nEn las votaciones los Concejales no podrán abstenerse.\n\n",
      "co:inicioCaracter": 75637,
      "co:finCaracter": 76385,
      "co:inicioTexto": 75651,
      "co:finTexto": 76385,
      "co:caracteresTexto": 734,
      "co:marcadorArticulo": "Artículo 120: ",
      "co:encabezadoPrevioLiteral": "###### MAYORÍAS\n\n\n",
      "co:inicioEncabezado": 75619,
      "co:finEncabezado": 75637,
      "co:epigrafe": "MAYORÍAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/121",
      "@type": "co:Articulo",
      "identifier": "121",
      "name": "Artículo 121",
      "position": 121,
      "text": "Son atribuciones del Concejo de Representantes:\n1.       Dictar su Reglamento interno y   sancionar ordenanzas sobre materias inherentes a  la competencia\nmunicipal.\n2.      Aprobar el presupuesto municipal de gastos y el cálculo de recursos, que se elabora conjuntamente con el\nDepartamento Ejecutivo. Se confecciona entre el primero de agosto y el treinta de septiembre de cada año. Se\nrealizan reuniones conjuntas con asistencia obligatoria de los Concejales, Intendente y Secretarios, acompañados por\nlos funcionarios y/o personal que aquéllos designen, con la finalidad de debatir la orientación de las acciones de\ngobierno, la prioridad en el gasto, la redistribución de recursos y los proyectos particulares de gestión. Durante esta\netapa se incluyen las prioridades establecidas por los vecinos a través del presupuesto participativo. Concluidas las\nreuniones, el Departamento Ejecutivo presenta el presupuesto y cálculo de recursos al Concejo de Representantes\nantes del treinta de octubre del año correspondiente. Si al treinta y uno de diciembre no se hubiera producido la\nsanción de la ordenanza correspondiente, serán de aplicación las previsiones contenidas en el artículo 91 de la\npresente Carta Orgánica.\nEl incumplimiento del tratamiento y aprobación del presupuesto constituye seria irregularidad.\n3.        Fijar los impuestos, tasas y contribuciones de conformidad con esta Carta Orgánica y dictar la Ordenanza\nImpositiva General y la Ordenanza Tarifaria Anual.\n4.     Tomar juramento al Intendente, acordar sus licencias y aceptar su renuncia.\n5.        Fijar la remuneración del Intendente, Secretarios, funcionarios y empleados. Establecer el escalafón y los\nconceptos que integran el régimen de remuneración de los empleados.\n6.       Prestar acuerdo para las designaciones y remociones que esta Carta Orgánica determina.\n7.      Nombrar, remover y solicitar rendición de cuentas a los funcionarios que integren sociedades en las que\ntenga participación el municipio, de acuerdo a las normas que establece esta Carta Orgánica.\n8.      Nombrar de su seno comisiones de investigación, al solo efecto del cumplimiento de sus fines, las que\ndeben respetar los derechos y garantías personales y la competencia del Poder Judicial. En todos los casos las\ncomisiones tienen que expedirse en cuanto al resultado de lo investigado.\n9.       Auditar, por medio de una comisión nombrada de su seno, al Tribunal de Cuentas, conforme a mecanismos\nque se reglamenten por ordenanza.\n10.     Convocar a elecciones en caso que no lo haya hecho el Intendente en tiempo y forma.\n11.     Reglamentar la instalación y funcionamiento de salas de espectáculos públicos, entretenimientos y otros\nestablecimientos o espacios de acceso público.\n12.      Autorizar al Departamento Ejecutivo a efectuar adquisiciones, aceptar o repudiar donaciones y legados con\ncargo y a enajenar bienes del dominio privado municipal o constituir gravámenes sobre ellos.\n13.      Autorizar concesiones o permisos de uso de los bienes del dominio público municipal.\n14.      Autorizar la desafectación de bienes de dominio público municipal; en caso que se trate de desafectar\ntierras, se necesitará mayoría extraordinaria  de los miembros del Concejo de Representantes.\n15.      Establecer límites y restricciones al dominio, y calificar los casos de expropiación por utilidad pública, con\narreglo a las leyes que rigen la materia.\n16.      Dictar normas en materia urbanística, edilicia y de espacios públicos.\n17.     Sancionar la Ordenanza de Organización y Funcionamiento de la Administración Pública y de todos los\nservicios municipales.\n18.     Sancionar las ordenanzas de contabilidad, contrataciones de obras y servicios públicos, y las que regulen el\nrégimen jurídico de los organismos descentralizados, autárquicos, empresas o sociedades de economía mixta y\nmunicipalizaciones, en un todo de acuerdo con esta Carta Orgánica.\n19.     Aprobar los pliegos de bases y condiciones de contrataciones, previo dictamen jurídico y económico.\n20.     Regular las tarifas de los servicios públicos municipales.\n\n\n21.     Examinar, aprobar o rechazar la Cuenta General del Ejercicio, previo dictamen del Tribunal de Cuentas,\ndentro de los treinta (30) días hábiles administrativos de recibida, la cual se tiene por aprobada si no es observada.\nLa falta de tratamiento configura seria irregularidad.\n22.      Autorizar, con el voto de la mayoría agravada, la contratación de empréstitos. El servicio de la totalidad de\nlas amortizaciones de capital e intereses no deberá comprometer más de la quinta parte de la renta municipal anual.\nSe entiende por renta municipal todo ingreso afectado a un fin específico.\n23.      Autorizar el uso del crédito público.\n24.     Aprobar o rechazar, antes de su celebración, los convenios o tratados propuestos por el Departamento\nEjecutivo con la Nación, Provincias, Municipios, Comunas, Entes públicos o privados provinciales y nacionales, así\ncomo los instrumentos a celebrar con Estados extranjeros, Entes públicos o privados extranjeros u Organizaciones\nInternacionales.\n25.      Solicitar al Tribunal de Cuentas la realización de auditorías de contenido económico financiero. Por\nmayoría absoluta del Cuerpo se puede solicitar auditoría de las empresas concesionarias de servicios públicos. El\nConcejo de Representantes  establece la modalidad de la auditoría solicitada.\n26.     Dar nombres a las calles, plazas, paseos y, en general, a cualquier lugar o establecimiento del dominio\npúblico municipal, previa realización de Audiencia Pública. No se pueden erigir estatuas ni monumentos a personas\nvivientes, ni dar el nombre de ellas a calles, paseos, ni a lugares o establecimientos públicos, hasta un (1) año\nposterior a su fallecimiento, período que puede reducirse con la aprobación de la mayoría agravada del Concejo.\n27.      Dictar los siguientes códigos: a) de la Carrera Administrativa y Régimen del Empleo Publico; b) de\nEspectáculos Públicos; c) Municipal de Faltas; e) Tributario Municipal; f) de Edificación y Desarrollo Urbano\nAmbiental; g) de Tránsito; h) de Bromatología y Zoonosis; i) de Administración Financiera; j) Electoral Municipal;\nk) de Procedimiento Administrativo y Contable; l) de Ética para la Función Pública; m) de Convivencia; n) todo otro\ncuerpo orgánico normativo en materias de competencia municipal.\n28.     Reglamentar sobre  la ubicación y funcionamiento de depósitos de materiales explosivos, tóxicos y\ncualquier otro que pueda atentar contra la seguridad y/o salud pública.\n29.     Auditar cualquier organismo municipal en el momento que lo considere necesario.\n30.      Solicitar informes por escrito al Departamento Ejecutivo, los que deberán ser respondidos en el término que\nfije  el Cuerpo. El incumplimiento de  esta  obligación por  parte  del  Intendente Municipal  configura  seria\nirregularidad. Cuando dichos informes no sean solicitados por el Cuerpo y hayan sido pedidos por un  número no\nmenor de tres (3) miembros deben ser contestados en un plazo no mayor a treinta (30) días; estos deberán tratar\nsobre temas puntuales y sin exceder de un pedido de informe por mes.\n31.     Convocar o interpelar, según el caso y cuando lo juzgue oportuno, al Intendente, a los funcionarios\npolíticos del Gabinete, miembros del Tribunal de Cuentas, Directores de Empresas del Estado, y/o directivos de\nempresas concesionarias de la Municipalidad y demás funcionarios que correspondan según lo establecido por la\npresente Carta Orgánica y demás normas que se dicten en consecuencia.  Los requeridos deberán concurrir\nobligatoriamente al recinto del Concejo de Representantes o a las comisiones, según corresponda, con el objeto de\nsuministrar informes. La citación debe hacerse conteniendo los puntos a tratar y con cinco (5) días hábiles de\nanticipación, excepto que se trate de un asunto o asuntos de extrema gravedad o urgencia y así lo disponga el\nConcejo. El incumplimiento de  esta obligación, por  parte de  los funcionarios convocados, configura  seria\nirregularidad funcional, por lo que el Concejo de Representantes podrá someterlos a Juicio Político o removerlos de\nsu cargo, según el caso, por el voto de la mayoría agravada.\n32.      Contestar fundadamente la aprobación o rechazo de los gastos efectuados, con posterioridad a haber sido\nvisados con reserva por el Tribunal de Cuentas, en forma obligatoria y dentro de los treinta (30) días hábiles\nadministrativos de recibidos.\n33.      Asistir a la presentación anual de la memoria e informe del Defensor del Pueblo.\n34.      Ejercer cualquier otra función o atribución de interés municipal que no esté prohibida por la Constitución\nNacional o Provincial y no sea incompatible con las funciones de los poderes del Estado y todas aquellas que no han\nsido conferidas al Departamento Ejecutivo o a los órganos de control.\n\n",
      "co:inicioCaracter": 76416,
      "co:finCaracter": 85272,
      "co:inicioTexto": 76430,
      "co:finTexto": 85272,
      "co:caracteresTexto": 8842,
      "co:marcadorArticulo": "Artículo 121: ",
      "co:encabezadoPrevioLiteral": "###### ATRIBUCIONES Y DEBERES\n\n",
      "co:inicioEncabezado": 76385,
      "co:finEncabezado": 76416,
      "co:epigrafe": "ATRIBUCIONES Y DEBERES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/122",
      "@type": "co:Articulo",
      "identifier": "122",
      "name": "Artículo 122",
      "position": 122,
      "text": "El Concejo de Representantes, para considerar las solicitudes de excepción, deberá contar con el voto\nde la mayoría extraordinaria. El tema o temas de la excepción deberán ser tratados en Audiencia Pública convocada\nal efecto con una antelación no inferior a quince (15) días entre la primera y segunda lectura. La aprobación en\nsegunda lectura deberá contar con la mayoría extraordinaria.\n\n",
      "co:inicioCaracter": 85291,
      "co:finCaracter": 85696,
      "co:inicioTexto": 85305,
      "co:finTexto": 85696,
      "co:caracteresTexto": 391,
      "co:marcadorArticulo": "Artículo 122: ",
      "co:encabezadoPrevioLiteral": "###### EXCEPCIONES\n",
      "co:inicioEncabezado": 85272,
      "co:finEncabezado": 85291,
      "co:epigrafe": "EXCEPCIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/123",
      "@type": "co:Articulo",
      "identifier": "123",
      "name": "Artículo 123",
      "position": 123,
      "text": "Queda prohibida la delegación legislativa en el Departamento Ejecutivo, salvo en caso de emergencia\npública, por el plazo fijado para su ejercicio y dentro de las bases que el Concejo de Representantes establezca.\n\n",
      "co:inicioCaracter": 85721,
      "co:finCaracter": 85950,
      "co:inicioTexto": 85735,
      "co:finTexto": 85950,
      "co:caracteresTexto": 215,
      "co:marcadorArticulo": "Artículo 123: ",
      "co:encabezadoPrevioLiteral": "###### INDELEGABILIDAD\n\n\n",
      "co:inicioEncabezado": 85696,
      "co:finEncabezado": 85721,
      "co:epigrafe": "INDELEGABILIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/124",
      "@type": "co:Articulo",
      "identifier": "124",
      "name": "Artículo 124",
      "position": 124,
      "text": "Los integrantes titulares de la lista de candidatos propuestos que no hayan resultado electos, serán\nconsiderados suplentes para el caso de vacancia. Producida una vacante, se cubrirá en forma inmediata por el\ncandidato que le sigue, de acuerdo al orden establecido en la lista partidaria, respetando el género y las normas\nelectorales aplicables, y completará el periodo del Concejal que se reemplaza. A los fines de la reelección, respecto\ndel suplente, sólo se considerará como un período a aquel que exceda los seis meses. Agotada la lista de titulares\nelectos, se continuará con el orden de los suplentes, que en igual número integrarán las listas respectivas.\nEn caso de que por razones extraordinarias y aun habiendo incorporado los suplentes de las listas correspondientes,\nse produjera vacancia de carácter permanente en el Concejo de Representantes, en número tal que impida alcanzar el\nquórum, el Intendente convocará a elecciones extraordinarias para cubrir las vacantes hasta completar el período.\n\n",
      "co:inicioCaracter": 85991,
      "co:finCaracter": 87017,
      "co:inicioTexto": 86005,
      "co:finTexto": 87017,
      "co:caracteresTexto": 1012,
      "co:marcadorArticulo": "Artículo 124: ",
      "co:encabezadoPrevioLiteral": "###### SUPLENTES Y COBERTURA DE VACANTES\n",
      "co:inicioEncabezado": 85950,
      "co:finEncabezado": 85991,
      "co:epigrafe": "SUPLENTES Y COBERTURA DE VACANTES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/125",
      "@type": "co:Articulo",
      "identifier": "125",
      "name": "Artículo 125",
      "position": 125,
      "text": "El Concejo de Representantes puede excluir del recinto, con auxilio de la fuerza pública si fuere\nnecesario, a personas ajenas a su seno que promuevan desorden en sus sesiones o que falten el respeto debido al\nCuerpo.\n\n",
      "co:inicioCaracter": 87046,
      "co:finCaracter": 87279,
      "co:inicioTexto": 87060,
      "co:finTexto": 87279,
      "co:caracteresTexto": 219,
      "co:marcadorArticulo": "Artículo 125: ",
      "co:encabezadoPrevioLiteral": "###### EXCLUSIÓN DE TERCEROS\n",
      "co:inicioEncabezado": 87017,
      "co:finEncabezado": 87046,
      "co:epigrafe": "EXCLUSIÓN DE TERCEROS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/126",
      "@type": "co:Articulo",
      "identifier": "126",
      "name": "Artículo 126",
      "position": 126,
      "text": "El Concejo de Representantes  puede, con el voto de la mayoría agravada, excluir del recinto o\nsuspender temporariamente de su seno a cualquiera de sus miembros por desorden en el ejercicio y desempeño de\nsus funciones. Con igual mayoría  podrá excluir de su seno a cualquiera de ellos por razones de inhabilidad,\nincompatibilidad o incapacidad sobreviniente. Deberá en todos los casos asegurar la defensa del acusado y la\nresolución deberá ser fundada.\n\n",
      "co:inicioCaracter": 87325,
      "co:finCaracter": 87794,
      "co:inicioTexto": 87339,
      "co:finTexto": 87794,
      "co:caracteresTexto": 455,
      "co:marcadorArticulo": "Artículo 126: ",
      "co:encabezadoPrevioLiteral": "###### CORRECCIÓN Y EXCLUSIÓN DE SUS MIEMBROS\n",
      "co:inicioEncabezado": 87279,
      "co:finEncabezado": 87325,
      "co:epigrafe": "CORRECCIÓN Y EXCLUSIÓN DE SUS MIEMBROS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/127",
      "@type": "co:Articulo",
      "identifier": "127",
      "name": "Artículo 127",
      "position": 127,
      "text": "El Concejo de Representantes debe, por mayoría simple, decidir sobre la renuncia presentada por un\nConcejal.\n",
      "co:inicioCaracter": 87810,
      "co:finCaracter": 87933,
      "co:inicioTexto": 87824,
      "co:finTexto": 87933,
      "co:caracteresTexto": 109,
      "co:marcadorArticulo": "Artículo 127: ",
      "co:encabezadoPrevioLiteral": "###### RENUNCIA\n",
      "co:inicioEncabezado": 87794,
      "co:finEncabezado": 87810,
      "co:epigrafe": "RENUNCIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/128",
      "@type": "co:Articulo",
      "identifier": "128",
      "name": "Artículo 128",
      "position": 128,
      "text": "Los proyectos de ordenanza pueden ser presentados por miembros del Concejo de Representantes, por\nel Departamento Ejecutivo, por el Tribunal de Cuentas, por el Defensor del Pueblo, por los ciudadanos de manera\nindividual o colectiva o por Iniciativa Popular. Para que los proyectos iniciados por particulares adquieran estado\nparlamentario deben ser presentados por algún Concejal.\n\n",
      "co:inicioCaracter": 88010,
      "co:finCaracter": 88407,
      "co:inicioTexto": 88024,
      "co:finTexto": 88407,
      "co:caracteresTexto": 383,
      "co:marcadorArticulo": "Artículo 128: ",
      "co:encabezadoPrevioLiteral": "###### INICIATIVA\n",
      "co:inicioEncabezado": 87992,
      "co:finEncabezado": 88010,
      "co:epigrafe": "INICIATIVA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/129",
      "@type": "co:Articulo",
      "identifier": "129",
      "name": "Artículo 129",
      "position": 129,
      "text": "Todo asunto que promueva un Concejal debe ser presentado en forma de proyecto. Los proyectos son\nde ordenanza, decreto, resolución, declaración o comunicación. Son presentados por escrito, deben contener la parte\ndispositiva, sus fundamentos y la firma de su autor o autores. Cada uno de los proyectos ingresados al Concejo de\nRepresentantes, cuando conlleve erogación, debe determinar a qué partida presupuestaria corresponde el gasto para\nsu desarrollo.\n\n",
      "co:inicioCaracter": 88456,
      "co:finCaracter": 88927,
      "co:inicioTexto": 88470,
      "co:finTexto": 88927,
      "co:caracteresTexto": 457,
      "co:marcadorArticulo": "Artículo 129: ",
      "co:encabezadoPrevioLiteral": "###### PRESENTACIÓN Y REDACCIÓN DE LOS PROYECTOS\n",
      "co:inicioEncabezado": 88407,
      "co:finEncabezado": 88456,
      "co:epigrafe": "PRESENTACIÓN Y REDACCIÓN DE LOS PROYECTOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/130",
      "@type": "co:Articulo",
      "identifier": "130",
      "name": "Artículo 130",
      "position": 130,
      "text": "Aprobado un proyecto de ordenanza por el Concejo de Representantes, pasa al Departamento\nEjecutivo para su promulgación, protocolización y publicación. Se considera promulgado todo proyecto no vetado\nen el plazo de diez días hábiles administrativos. Vetado total o parcialmente un proyecto, el Departamento Ejecutivo\nlo remitirá el mismo día de su firma, con las observaciones formuladas, al Concejo de Representantes. Si luego el\nConcejo de Representantes lo confirma por la mayoría absoluta, el proyecto queda aprobado y pasa al Departamento\nEjecutivo para su promulgación, protocolización y publicación. Vetado en parte un proyecto de ordenanza por el\nDepartamento Ejecutivo, éste sólo puede promulgar la parte no vetada si ella tiene autonomía normativa y no afecta\nla unidad del proyecto, previa decisión favorable del Concejo de Representantes.\n\n",
      "co:inicioCaracter": 88939,
      "co:finCaracter": 89805,
      "co:inicioTexto": 88953,
      "co:finTexto": 89805,
      "co:caracteresTexto": 852,
      "co:marcadorArticulo": "Artículo 130: ",
      "co:encabezadoPrevioLiteral": "###### VETO\n",
      "co:inicioEncabezado": 88927,
      "co:finEncabezado": 88939,
      "co:epigrafe": "VETO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/131",
      "@type": "co:Articulo",
      "identifier": "131",
      "name": "Artículo 131",
      "position": 131,
      "text": "Los proyectos de ordenanza que ingresen al Concejo de Representantes deben ser aprobados o\nrechazados en el término de cuarenta y cinco días hábiles administrativos, cuando provengan del Departamento\nEjecutivo, del propio Cuerpo o del Tribunal de Cuentas y de noventa días hábiles administrativos cuando tengan\notro origen. Por mayoría absoluta y por razones fundadas, el Concejo de Representantes puede decidir prorrogar\nestos plazos.\n\n",
      "co:inicioCaracter": 89840,
      "co:finCaracter": 90291,
      "co:inicioTexto": 89854,
      "co:finTexto": 90291,
      "co:caracteresTexto": 437,
      "co:marcadorArticulo": "Artículo 131: ",
      "co:encabezadoPrevioLiteral": "###### OBLIGACIÓN DE TRATAMIENTO\n\n\n",
      "co:inicioEncabezado": 89805,
      "co:finEncabezado": 89840,
      "co:epigrafe": "OBLIGACIÓN DE TRATAMIENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/132",
      "@type": "co:Articulo",
      "identifier": "132",
      "name": "Artículo 132",
      "position": 132,
      "text": "Sancionada, promulgada y protocolizada una ordenanza, se transcribe en un libro especial que se lleva\nal efecto y se publica en el Boletín Oficial Municipal dentro de los seis días hábiles de su promulgación. En caso de\nincumplimiento, el Presidente del Concejo de Representantes ordena la publicación. Las ordenanzas son obligatorias\ndesde su publicación o desde el momento que ellas determinen\n\n",
      "co:inicioCaracter": 90332,
      "co:finCaracter": 90743,
      "co:inicioTexto": 90346,
      "co:finTexto": 90743,
      "co:caracteresTexto": 397,
      "co:marcadorArticulo": "Artículo 132: ",
      "co:encabezadoPrevioLiteral": "###### PUBLICACIÓN Y ENTRADA EN VIGENCIA\n",
      "co:inicioEncabezado": 90291,
      "co:finEncabezado": 90332,
      "co:epigrafe": "PUBLICACIÓN Y ENTRADA EN VIGENCIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/133",
      "@type": "co:Articulo",
      "identifier": "133",
      "name": "Artículo 133",
      "position": 133,
      "text": "En  cualquier  período de  sesiones  el Departamento  Ejecutivo puede  enviar  al Concejo de\nRepresentantes proyectos que no requieran ser aprobados por el procedimiento de doble lectura, con pedido de\nurgente tratamiento, los que deben ser considerados dentro de los treinta días corridos de su recepción por el Cuerpo.\nLa solicitud de tratamiento de urgencia de un proyecto puede ser hecha aún después de la remisión y en cualquier\netapa de su trámite. En este caso, los términos corren a partir de la recepción de la solicitud. Se tiene por aprobado\naquel proyecto que dentro del plazo establecido no sea expresamente rechazado. El Concejo de Representantes está\nfacultado para dejar sin efecto el procedimiento de urgencia si así lo resuelve por mayoría absoluta, en cuyo caso se\naplica a partir de ese momento el trámite ordinario, debiendo notificar sus razones al Departamento Ejecutivo.\n\n",
      "co:inicioCaracter": 90774,
      "co:finCaracter": 91685,
      "co:inicioTexto": 90789,
      "co:finTexto": 91685,
      "co:caracteresTexto": 896,
      "co:marcadorArticulo": "Artículo  133: ",
      "co:encabezadoPrevioLiteral": "###### TRATAMIENTO DE URGENCIA\n",
      "co:inicioEncabezado": 90743,
      "co:finEncabezado": 90774,
      "co:epigrafe": "TRATAMIENTO DE URGENCIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/134",
      "@type": "co:Articulo",
      "identifier": "134",
      "name": "Artículo 134",
      "position": 134,
      "text": "Se requiere doble lectura para las ordenanzas que dispongan:\n1.       Privatizar obras, servicios y funciones del Municipio.\n2.       Municipalizar servicios.\n3.      Otorgar el uso continuado y exclusivo de bienes de dominio público del Municipio.\n4.      Crear entidades descentralizadas autárquicas.\n5.      Crear empresas municipales de economía mixta, empresas o sociedades integradas por el Municipio y/o la\nProvincia o la Nación, bajo formas o tipos jurídicos públicos o privados.\n6.       Contraer empréstitos y créditos.\n7.       Desafectar bienes del Dominio Público Municipal.\n8.      Aprobar los pliegos de bases y condiciones de concesiones de obras y servicios públicos, como así también\nsu otorgamiento. Cuando el plazo de la concesión supere los quince (15) años, se deberá convocar a referéndum.\n9.      Crear nuevos tributos o aumentar los existentes.\n10.      Sancionar el Presupuesto Municipal de gastos y recursos y sus modificaciones; aprobar la Cuenta General\ndel Ejercicio.\n11.       Dictar o modificar el régimen electoral y de los Partidos Políticos.\n12.      Incrementar tarifas de los servicios públicos.\n13.      Excepciones a las ordenanzas.\nEntre la primera y segunda lectura debe mediar un plazo no menor de quince (15) días corridos, en el que el Concejo\nde Representantes debe dar amplia difusión al proyecto y realizar al menos una Audiencia Pública, teniendo especial\ncuidado de invitar personas y entidades interesadas directamente en su discusión. En los casos mencionados en los\nincisos 1 al 8 se requiere el voto de mayoría agravada, tanto en la primera como en la segunda lectura. En los incisos\n9, 10, 11 y 12 se necesita mayoría absoluta en ambas lecturas. En el inciso 13 se necesita mayoría extraordinaria en\nlas dos lecturas.\n\n\n",
      "co:inicioCaracter": 91706,
      "co:finCaracter": 93494,
      "co:inicioTexto": 91720,
      "co:finTexto": 93494,
      "co:caracteresTexto": 1774,
      "co:marcadorArticulo": "Artículo 134: ",
      "co:encabezadoPrevioLiteral": "###### DOBLE LECTURA\n",
      "co:inicioEncabezado": 91685,
      "co:finEncabezado": 91706,
      "co:epigrafe": "DOBLE LECTURA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/135",
      "@type": "co:Articulo",
      "identifier": "135",
      "name": "Artículo 135",
      "position": 135,
      "text": "En la sanción de las ordenanzas se usa la siguiente fórmula: \"El Concejo de Representantes del\nMunicipio de Villa Carlos Paz sanciona con fuerza de Ordenanza\".\n",
      "co:inicioCaracter": 93509,
      "co:finCaracter": 93682,
      "co:inicioTexto": 93522,
      "co:finTexto": 93682,
      "co:caracteresTexto": 160,
      "co:marcadorArticulo": "Artículo135: ",
      "co:encabezadoPrevioLiteral": "###### FÓRMULA\n",
      "co:inicioEncabezado": 93494,
      "co:finEncabezado": 93509,
      "co:epigrafe": "FÓRMULA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/136",
      "@type": "co:Articulo",
      "identifier": "136",
      "name": "Artículo 136",
      "position": 136,
      "text": "El Concejo de Representantes designa con mayoría agravada a un Auditor de Gestión, como órgano\ntécnico auxiliar,  a propuesta de los bloques legislativos y  que se desempeña durante el mandato del Cuerpo. El\nAuditor deberá ser profesional de Ciencias Económicas y tener cuatro (4) años de residencia continua en la Ciudad.\nEs removido por mayoría agravada sin necesidad de expresión de causa.\n\n",
      "co:inicioCaracter": 93789,
      "co:finCaracter": 94197,
      "co:inicioTexto": 93803,
      "co:finTexto": 94197,
      "co:caracteresTexto": 394,
      "co:marcadorArticulo": "Artículo 136: ",
      "co:encabezadoPrevioLiteral": "###### AUDITORÍA DE GESTION   -  (Creada por Ordenanza 4952)\n\n\n",
      "co:inicioEncabezado": 93726,
      "co:finEncabezado": 93789,
      "co:epigrafe": "AUDITORÍA DE GESTION   -  (Creada por Ordenanza 4952)",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/10"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/10"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/137",
      "@type": "co:Articulo",
      "identifier": "137",
      "name": "Artículo 137",
      "position": 137,
      "text": "El Auditor de Gestión analiza técnicamente la ejecución de los proyectos y programas expresados en\nel Presupuesto y Cálculo de Recursos en todos los órganos y organismos de gobierno, a los fines de que el Concejo\nde Representantes pueda evaluar el cumplimiento de los objetivos de gobierno.\nLa Ordenanza regula los requisitos, incompatibilidades, funciones y procedimientos, debiendo incluir entre sus\nfunciones el dictamen acerca de las órdenes de pago observadas por el Tribunal de Cuentas.\n",
      "co:inicioCaracter": 94217,
      "co:finCaracter": 94724,
      "co:inicioTexto": 94231,
      "co:finTexto": 94724,
      "co:caracteresTexto": 493,
      "co:marcadorArticulo": "Artículo 137: ",
      "co:encabezadoPrevioLiteral": "###### ATRIBUCIONES\n",
      "co:inicioEncabezado": 94197,
      "co:finEncabezado": 94217,
      "co:epigrafe": "ATRIBUCIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/10"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/10"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/138",
      "@type": "co:Articulo",
      "identifier": "138",
      "name": "Artículo 138",
      "position": 138,
      "text": "El Departamento Ejecutivo está a cargo de un ciudadano con el título de Intendente Municipal, elegido\nen forma directa, a simple pluralidad de sufragios.\n\n",
      "co:inicioCaracter": 94848,
      "co:finCaracter": 95017,
      "co:inicioTexto": 94862,
      "co:finTexto": 95017,
      "co:caracteresTexto": 155,
      "co:marcadorArticulo": "Artículo 138: ",
      "co:encabezadoPrevioLiteral": "###### INTENDENTE MUNICIPAL\n",
      "co:inicioEncabezado": 94820,
      "co:finEncabezado": 94848,
      "co:epigrafe": "INTENDENTE MUNICIPAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/139",
      "@type": "co:Articulo",
      "identifier": "139",
      "name": "Artículo 139",
      "position": 139,
      "text": "Para ser Intendente se requiere:\n1.      Ser argentino.\n2.      Haber cumplido veinticinco (25) años de edad al tiempo de su elección.\n3.      Tener ocho (8) años de residencia continua e inmediata anterior a la elección en el Municipio, no causando\ninterrupción la ausencia motivada por la prestación de servicios a la Nación, Provincia o Municipio u Organismos\nInternacionales de los que la Nación forme parte o por la realización de estudios de nivel terciario, universitarios o\nde posgrado o por razones de salud.\n4.      Haber votado en la última elección municipal o haber justificado la omisión de ese deber.\n\n",
      "co:inicioCaracter": 95035,
      "co:finCaracter": 95666,
      "co:inicioTexto": 95049,
      "co:finTexto": 95666,
      "co:caracteresTexto": 617,
      "co:marcadorArticulo": "Artículo 139: ",
      "co:encabezadoPrevioLiteral": "###### REQUISITOS\n",
      "co:inicioEncabezado": 95017,
      "co:finEncabezado": 95035,
      "co:epigrafe": "REQUISITOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/140",
      "@type": "co:Articulo",
      "identifier": "140",
      "name": "Artículo 140",
      "position": 140,
      "text": "Respecto del Intendente, rigen  las mismas inhabilidades e   incompatibilidades  que para los\nConcejales, excepto el inciso 1. del artículo  referido a  Inhabilidades.\n\n",
      "co:inicioCaracter": 95708,
      "co:finCaracter": 95891,
      "co:inicioTexto": 95722,
      "co:finTexto": 95891,
      "co:caracteresTexto": 169,
      "co:marcadorArticulo": "Artículo 140: ",
      "co:encabezadoPrevioLiteral": "###### INHABILIDADES - INCOMPATIBILIDADES\n",
      "co:inicioEncabezado": 95666,
      "co:finEncabezado": 95708,
      "co:epigrafe": "INHABILIDADES - INCOMPATIBILIDADES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/141",
      "@type": "co:Articulo",
      "identifier": "141",
      "name": "Artículo 141",
      "position": 141,
      "text": "El Intendente dura cuatro años en sus funciones. Puede ser reelecto por una vez consecutiva, debiendo\ntranscurrir un período completo para una nueva elección. El mandato del Intendente cesa al expirar el plazo\nestablecido, sin que evento alguno que lo haya interrumpido sea motivo para que se complete más tarde.\n\n",
      "co:inicioCaracter": 95919,
      "co:finCaracter": 96247,
      "co:inicioTexto": 95933,
      "co:finTexto": 96247,
      "co:caracteresTexto": 314,
      "co:marcadorArticulo": "Artículo 141: ",
      "co:encabezadoPrevioLiteral": "###### MANDATO Y REELECCIÓN\n",
      "co:inicioEncabezado": 95891,
      "co:finEncabezado": 95919,
      "co:epigrafe": "MANDATO Y REELECCIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/142",
      "@type": "co:Articulo",
      "identifier": "142",
      "name": "Artículo 142",
      "position": 142,
      "text": "El Intendente no puede ausentarse del Municipio por más de siete días hábiles sin previa autorización\ndel Concejo de Representantes. Si éste se encuentra en receso, se le da cuenta oportunamente.\n\n",
      "co:inicioCaracter": 96263,
      "co:finCaracter": 96474,
      "co:inicioTexto": 96277,
      "co:finTexto": 96474,
      "co:caracteresTexto": 197,
      "co:marcadorArticulo": "Artículo 142: ",
      "co:encabezadoPrevioLiteral": "###### AUSENCIA\n",
      "co:inicioEncabezado": 96247,
      "co:finEncabezado": 96263,
      "co:epigrafe": "AUSENCIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/143",
      "@type": "co:Articulo",
      "identifier": "143",
      "name": "Artículo 143",
      "position": 143,
      "text": "El Intendente percibirá una remuneración que fijará el Concejo de Representantes, siendo ésta la más\nalta que se establezca.\n\n",
      "co:inicioCaracter": 96494,
      "co:finCaracter": 96634,
      "co:inicioTexto": 96508,
      "co:finTexto": 96634,
      "co:caracteresTexto": 126,
      "co:marcadorArticulo": "Artículo 143: ",
      "co:encabezadoPrevioLiteral": "###### REMUNERACIÓN\n",
      "co:inicioEncabezado": 96474,
      "co:finEncabezado": 96494,
      "co:epigrafe": "REMUNERACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/144",
      "@type": "co:Articulo",
      "identifier": "144",
      "name": "Artículo 144",
      "position": 144,
      "text": "Son atribuciones y deberes del Intendente Municipal:\n1.      Ser el jefe del gobierno y de la administración del Municipio, al que representa.\n2.      Promulgar, protocolizar, publicar y ejecutar las ordenanzas y reglamentarlas cuando sea necesario, sin\nalterar su espíritu.\n\n\n3.       Ejercer el derecho de veto y promulgación parcial en la forma prevista en esta Carta Orgánica.\n4.        Iniciar proyectos de nuevas ordenanzas, proponer  la modificación o derogación de las existentes e\nimprimirles trámites de urgencia.-\n5.      Responder por sí o por intermedio de sus Secretarios, en forma oral o escrita, los informes solicitados por el\nConcejo de Representantes en los plazos fijados por éste. Concurrir a las sesiones cuando sea convocado a tal fin o\npor propia determinación, pudiendo tomar parte en los debates pero no votar. Informar ante el Concejo de\nRepresentantes, en la primera sesión ordinaria de cada año, sobre la ejecución del presupuesto anterior, el estado de\nlas cuentas públicas y de los planes de gobierno para el ejercicio en curso.\n6.        Solicitar la prórroga de las sesiones ordinarias del Concejo de Representantes y convocar a sesiones\nextraordinarias con determinación precisa del temario de la convocatoria.-\n7.      Convocar a elecciones municipales según lo establecido por esta Carta Orgánica.\n8.       Celebrar convenios previamente autorizados por  el Concejo de Representantes, con  la Nación,  las\nProvincias, los Municipios, las Comunas, Entes Públicos o Privados Nacionales, Provinciales o Municipales que\ntengan como fin desarrollar actividades de interés para la comunidad.\n9.       Celebrar convenios previamente autorizados por el Concejo de Representantes con Estados extranjeros,\nEntes públicos o privados extranjeros y Organizaciones Internacionales, e impulsar negociaciones con ellas, sin\nafectar la política exterior a cargo del Gobierno Nacional ni interferir con las competencias propias de la Provincia.\n10.     Nombrar, promover y remover a los funcionarios y agentes de la administración a su cargo, conforme a los\nprincipios de esta Carta Orgánica y las ordenanzas que en su consecuencia se dicten. Llevar un registro del personal\ndel municipio.\n11.      Dirigir toda reforma administrativa tendiente a satisfacer las necesidades de la comunidad, con eficiencia,\neficacia, economía y oportunidad. Promover estudios e investigaciones sobre dicha reforma y la institucionalización\nde los mecanismos necesarios para la capacitación y perfeccionamiento permanente de los funcionarios y empleados\nmunicipales.\n12.     Desconcentrar, delimitada, en forma expresa y delimitada determinadas funciones administrativas, las que\npuede reasumir en cualquier momento.\n13.     Organizar el Registro del Estado Civil y Capacidad de las Personas, el Catastro Municipal, Archivo\nMunicipal, y velar por la conservación de documentos y expedientes, hacer publicar el Boletín Oficial Municipal y\nllevar un protocolo de ordenanzas, decretos, resoluciones y convenios. Disponer la edición actualizada del Digesto\nMunicipal, que recopile las disposiciones vigentes. Asegurar la debida supervisión, asistencia técnica y archivo de\nlos recursos documentales del Municipio, para garantizar su conservación, su seguridad y el respaldo de la función y\nde la gestión de gobierno y administración.\n14.     Administrar los bienes municipales.\n15.      Realizar obras públicas conforme a las normativas vigentes.\n16.     Enviar al Concejo de Representantes el proyecto de presupuesto, según lo establecido en esta Carta\nOrgánica.\n17.     Celebrar  contratos o  convenios de acuerdo con  las  autorizaciones  expedidas  por  el Concejo de\nRepresentantes en los casos expresamente establecidos.-\n18.     Remitir  al Tribunal de Cuentas el estado de  la ejecución presupuestaria y el estado y la situación\npatrimonial del ejercicio vencido, dentro de los noventa (90) días de terminado el ejercicio. La falta de remisión\nconfigura mal desempeño.\n19.      Publicar en el Boletín Oficial Municipal o por separado, antes del treinta y uno de mayo y del treinta y uno\nde octubre de cada año, un estado de evolución de la ejecución del presupuesto y cálculo de recursos acumulados al\nmes de abril y septiembre respectivamente y un estado del movimiento de personal de planta permanente y\ntransitoria.\n20.     Recaudar los tributos y rentas, y expedir órdenes de pago.\n21.     Representar al Municipio en procesos judiciales.\n22.     Asegurar y controlar la prestación de los servicios públicos municipales por administración o a través de\nterceros.\n23.     Aceptar o rechazar las donaciones y legados sin cargo efectuados al Municipio ad referéndum del Concejo\nde Representantes.\n24.     Adoptar, en caso de catástrofe o grave peligro público, las medidas necesarias, urgentes y convenientes,\ncon oportuno conocimiento del Concejo de Representantes.\n25.     Formular las bases y condiciones de las licitaciones, aprobar o desechar las propuestas conforme a las\nnormativas vigentes.\n26.      Ejercer el poder de policía con sujeción a los principios de legalidad, igualdad, razonabilidad y respeto a la\n\n\nlibertad  e  intimidad de  las  personas.  Tiene  facultades  para imponer  multas,  disponer  la  demolición de\nconstrucciones, clausurar y desalojar inmuebles, disponer secuestros y decomisos; en su caso, solicitar el auxilio de\nla fuerza pública y recabar órdenes judiciales de allanamiento y lanzamiento.\n27.     Requerir al Concejo de Representantes los acuerdos para la designación y la remoción de funcionarios que\nesta Carga Orgánica establece.\n28.      Realizar a la finalización de su mandato un informe completo de los recursos humanos y patrimoniales con\nque cuenta el Municipio, incluyendo todo proyecto o planificación en ejecución o pendiente de realización.\n29.     Implementar las políticas especiales que establece esta Carta Orgánica, de  conformidad con lo que\ndispusieren las ordenanzas respectivas.\n30.      Realizar censos de cualquier naturaleza, conforme a las ordenanzas que al efecto se dicten.\n31.      Asistir a la presentación anual de la memoria e informe del Defensor del Pueblo.\n32.      Ejercer las demás facultades otorgadas por la presente Carta Orgánica, que hagan a las funciones ejecutivas\nde gestión municipal  y toda otra atribuida por la Constitución de la Provincia.\n\n",
      "co:inicioCaracter": 96665,
      "co:finCaracter": 103016,
      "co:inicioTexto": 96679,
      "co:finTexto": 103016,
      "co:caracteresTexto": 6337,
      "co:marcadorArticulo": "Artículo 144: ",
      "co:encabezadoPrevioLiteral": "###### ATRIBUCIONES Y DEBERES\n\n",
      "co:inicioEncabezado": 96634,
      "co:finEncabezado": 96665,
      "co:epigrafe": "ATRIBUCIONES Y DEBERES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/145",
      "@type": "co:Articulo",
      "identifier": "145",
      "name": "Artículo 145",
      "position": 145,
      "text": "Los Secretarios, cuyo número y competencia serán establecidos por una Ordenanza especial, son\nnombrados por el Intendente, no pudiendo recaer la designación en su cónyuge ni en pariente consanguíneo o afín\nen primer grado. Tienen a su cargo el despacho de los asuntos de competencia del Departamento Ejecutivo,\nrefrendan y legalizan los actos de éste en el ámbito respectivo por medio de su firma, sin cuyo requisito carecen de\neficacia.\nCada Secretario es responsable de los actos que legaliza y solidariamente responsable con los que acuerde con sus\npares  y tiene el deber de excusarse en todo asunto que fuere parte interesada.\nDeben concurrir obligatoriamente a las citaciones que le realice el Concejo de Representantes. Por sí solos, pueden\ntomar  las resoluciones que  las ordenanzas autoricen, en atención a su competencia y en aquellas materias\nadministrativas que el Intendente les delegue.-\nEn el momento de asumir el cargo, prestan juramento y compromiso de desempeñar debidamente sus funciones y de\nobrar en un todo de conformidad a lo que prescribe la Constitución de la Nación, la Constitución de la Provincia y\nesta Carta Orgánica.\nLos Secretarios cesan en sus funciones cuando lo haga el Intendente que los designó.\n\n",
      "co:inicioCaracter": 103035,
      "co:finCaracter": 104284,
      "co:inicioTexto": 103049,
      "co:finTexto": 104284,
      "co:caracteresTexto": 1235,
      "co:marcadorArticulo": "Artículo 145: ",
      "co:encabezadoPrevioLiteral": "###### SECRETARIOS\n",
      "co:inicioEncabezado": 103016,
      "co:finEncabezado": 103035,
      "co:epigrafe": "SECRETARIOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/146",
      "@type": "co:Articulo",
      "identifier": "146",
      "name": "Artículo 146",
      "position": 146,
      "text": "Los  cargos  políticos  del Departamento  Ejecutivo  Municipal, empresas y  entes  autárquicos\nmunicipales, no regidos por el régimen de empleo público establecido por la presente Carta Orgánica, carecen de\nestabilidad, y al cesar en su cargo no tienen derecho a indemnización alguna ni a reclamar permanencia en el ámbito\nde la Municipalidad.\n\n",
      "co:inicioCaracter": 104308,
      "co:finCaracter": 104668,
      "co:inicioTexto": 104323,
      "co:finTexto": 104668,
      "co:caracteresTexto": 345,
      "co:marcadorArticulo": "Artículo  146: ",
      "co:encabezadoPrevioLiteral": "###### CARGOS POLÍTICOS\n",
      "co:inicioEncabezado": 104284,
      "co:finEncabezado": 104308,
      "co:epigrafe": "CARGOS POLÍTICOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/147",
      "@type": "co:Articulo",
      "identifier": "147",
      "name": "Artículo 147",
      "position": 147,
      "text": "En caso de licencia o impedimento de alguno de los Secretarios, el Intendente Municipal encargará a\notro Secretario el despacho correspondiente a su división, por un período no mayor de treinta (30) días o hasta que\naquél se reintegre a sus funciones o se designe un nuevo titular.\n\n",
      "co:inicioCaracter": 104698,
      "co:finCaracter": 104995,
      "co:inicioTexto": 104712,
      "co:finTexto": 104995,
      "co:caracteresTexto": 283,
      "co:marcadorArticulo": "Artículo 147: ",
      "co:encabezadoPrevioLiteral": "###### LICENCIA O IMPEDIMENTO\n",
      "co:inicioEncabezado": 104668,
      "co:finEncabezado": 104698,
      "co:epigrafe": "LICENCIA O IMPEDIMENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/148",
      "@type": "co:Articulo",
      "identifier": "148",
      "name": "Artículo 148",
      "position": 148,
      "text": "En caso de destitución del Intendente o de su muerte, dimisión, ausencia u otro impedimento, asume el\ncargo el Presidente del Concejo de Representantes, quien convocará en un plazo de treinta (30) días de producida la\nacefalía a elecciones extraordinarias para cubrir el cargo hasta completar el período, siempre que éste no fuera\ninferior a nueve (9) meses. El Concejo de Representantes deberá dictar una ordenanza que reglamente el supuesto de\nacefalía temporaria.\n",
      "co:inicioCaracter": 105019,
      "co:finCaracter": 105500,
      "co:inicioTexto": 105033,
      "co:finTexto": 105500,
      "co:caracteresTexto": 467,
      "co:marcadorArticulo": "Artículo 148: ",
      "co:encabezadoPrevioLiteral": "###### DE LAS ACEFALÍAS\n",
      "co:inicioEncabezado": 104995,
      "co:finEncabezado": 105019,
      "co:epigrafe": "DE LAS ACEFALÍAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/149",
      "@type": "co:Articulo",
      "identifier": "149",
      "name": "Artículo 149",
      "position": 149,
      "text": "El Asesor Letrado, a cargo de la Asesoría Letrada de la Municipalidad, es responsable del control de\nlegalidad de los actos jurídicos del Municipio y defiende, judicial o extrajudicialmente, su patrimonio e intereses.\nTiene a su cargo:\n1.     La tramitación de los juicios en los que es parte la Municipalidad de Villa Carlos Paz.\n\n\n2.     La facultad de emitir dictámenes que establezcan un sistema interno de precedentes obligatorios para la\nJurisprudencia Administrativa Municipal.\n\n",
      "co:inicioCaracter": 105563,
      "co:finCaracter": 106063,
      "co:inicioTexto": 105577,
      "co:finTexto": 106063,
      "co:caracteresTexto": 486,
      "co:marcadorArticulo": "Artículo 149: ",
      "co:encabezadoPrevioLiteral": "###### ASESORÍA LETRADA\n",
      "co:inicioEncabezado": 105539,
      "co:finEncabezado": 105563,
      "co:epigrafe": "ASESORÍA LETRADA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/12"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/12"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/150",
      "@type": "co:Articulo",
      "identifier": "150",
      "name": "Artículo 150",
      "position": 150,
      "text": "La Procuración del Tesoro Municipal, dependiente de  la Asesoría Letrada, representará a  la\nMunicipalidad de Villa Carlos Paz en todos los juicios en los que es parte actora.  El organismo estará a cargo del\nProcurador del Tesoro Municipal.\n\n",
      "co:inicioCaracter": 106102,
      "co:finCaracter": 106359,
      "co:inicioTexto": 106116,
      "co:finTexto": 106359,
      "co:caracteresTexto": 243,
      "co:marcadorArticulo": "Artículo 150: ",
      "co:encabezadoPrevioLiteral": "###### POCURACIÓN DEL TESORO MUNICIPAL\n",
      "co:inicioEncabezado": 106063,
      "co:finEncabezado": 106102,
      "co:epigrafe": "POCURACIÓN DEL TESORO MUNICIPAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/12"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/12"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/151",
      "@type": "co:Articulo",
      "identifier": "151",
      "name": "Artículo 151",
      "position": 151,
      "text": "El funcionario a cargo de la Asesoría Letrada y el de la Procuración del Tesoro Municipal, serán\ndesignados por el Intendente y deberán tener como mínimo treinta (30) años de edad y cinco (5) años de ejercicio en\nla abogacía.\nLa ordenanza determina sus funciones, atribuciones y remuneración.\nSon removidos por el Intendente.\n",
      "co:inicioCaracter": 106395,
      "co:finCaracter": 106735,
      "co:inicioTexto": 106409,
      "co:finTexto": 106735,
      "co:caracteresTexto": 326,
      "co:marcadorArticulo": "Artículo 151: ",
      "co:encabezadoPrevioLiteral": "###### DESIGNACIÓN - REGLAMENTACIÓN\n",
      "co:inicioEncabezado": 106359,
      "co:finEncabezado": 106395,
      "co:epigrafe": "DESIGNACIÓN - REGLAMENTACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/12"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/12"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/152",
      "@type": "co:Articulo",
      "identifier": "152",
      "name": "Artículo 152",
      "position": 152,
      "text": "El Tribunal de Cuentas Municipal está constituido por tres (3) Tribunos, elegidos de manera\ndirecta en los comicios ordinarios de autoridades municipales.\n\n",
      "co:inicioCaracter": 106840,
      "co:finCaracter": 107013,
      "co:inicioTexto": 106857,
      "co:finTexto": 107013,
      "co:caracteresTexto": 156,
      "co:marcadorArticulo": "Artículo 152:    ",
      "co:encabezadoPrevioLiteral": "###### INTEGRACIÓN\n",
      "co:inicioEncabezado": 106821,
      "co:finEncabezado": 106840,
      "co:epigrafe": "INTEGRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/153",
      "@type": "co:Articulo",
      "identifier": "153",
      "name": "Artículo 153",
      "position": 153,
      "text": "Los partidos políticos presentan tres (3) candidatos titulares y tres (3) suplentes, y los lugares se\ndistribuyen por el sistema D'Hondt.  En el caso de que la distribución proporcional otorgue los tres lugares al\npartido mayoritario, corresponden dos lugares a éste y el restante al partido que obtiene la primera minoría. Para la\nelección de los miembros del Tribunal de Cuentas el elector sufraga por una nómina distinta de la de Intendente y\nConcejales.\n\n",
      "co:inicioCaracter": 107062,
      "co:finCaracter": 107535,
      "co:inicioTexto": 107076,
      "co:finTexto": 107535,
      "co:caracteresTexto": 459,
      "co:marcadorArticulo": "Artículo 153: ",
      "co:encabezadoPrevioLiteral": "###### PRESENTACIÓN Y DISTRIBUCIÓN DE LOS CARGOS\n",
      "co:inicioEncabezado": 107013,
      "co:finEncabezado": 107062,
      "co:epigrafe": "PRESENTACIÓN Y DISTRIBUCIÓN DE LOS CARGOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/154",
      "@type": "co:Articulo",
      "identifier": "154",
      "name": "Artículo 154",
      "position": 154,
      "text": "Los Tribunos duran cuatro (4) años en sus funciones y cesan el mismo día en que expira ese plazo,\nsin que evento alguno que lo haya interrumpido sea motivo para que se complete más tarde.  Pueden ser reelectos\npor un período. Para poder ser nuevamente elegidos deberá transcurrir un período completo.\n\n",
      "co:inicioCaracter": 107564,
      "co:finCaracter": 107883,
      "co:inicioTexto": 107581,
      "co:finTexto": 107883,
      "co:caracteresTexto": 302,
      "co:marcadorArticulo": "Artículo 154:    ",
      "co:encabezadoPrevioLiteral": "###### DURACIÓN Y REELECCIÓN\n",
      "co:inicioEncabezado": 107535,
      "co:finEncabezado": 107564,
      "co:epigrafe": "DURACIÓN Y REELECCIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/155",
      "@type": "co:Articulo",
      "identifier": "155",
      "name": "Artículo 155",
      "position": 155,
      "text": "Para los Tribunos rigen los mismos requisitos, inhabilidades e incompatibilidades que para los\nmiembros del Concejo de Representantes. No pueden ser Tribunos el cónyuge  ni los parientes  hasta el tercer\ngrado inclusive de consanguinidad o afinidad del Intendente y Concejales.\n\n",
      "co:inicioCaracter": 107937,
      "co:finCaracter": 108233,
      "co:inicioTexto": 107954,
      "co:finTexto": 108233,
      "co:caracteresTexto": 279,
      "co:marcadorArticulo": "Artículo 155:    ",
      "co:encabezadoPrevioLiteral": "###### REQUISITOS, INHABILIDADES E INCOMPATIBILIDADES\n",
      "co:inicioEncabezado": 107883,
      "co:finEncabezado": 107937,
      "co:epigrafe": "REQUISITOS, INHABILIDADES E INCOMPATIBILIDADES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/156",
      "@type": "co:Articulo",
      "identifier": "156",
      "name": "Artículo 156",
      "position": 156,
      "text": "Los Tribunos perciben una remuneración igual a la de los Concejales.\n\n",
      "co:inicioCaracter": 108253,
      "co:finCaracter": 108337,
      "co:inicioTexto": 108267,
      "co:finTexto": 108337,
      "co:caracteresTexto": 70,
      "co:marcadorArticulo": "Artículo 156: ",
      "co:encabezadoPrevioLiteral": "###### REMUNERACIÓN\n",
      "co:inicioEncabezado": 108233,
      "co:finEncabezado": 108253,
      "co:epigrafe": "REMUNERACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/157",
      "@type": "co:Articulo",
      "identifier": "157",
      "name": "Artículo 157",
      "position": 157,
      "text": "Los Tribunos son removidos de sus cargos  mediante el procedimiento del Juicio Político. En caso de\ndestitución, renuncia, impedimento definitivo o fallecimiento,  el Tribuno es reemplazado por el candidato que\nsigue en el orden de la lista de la agrupación política correspondiente. Concluida la lista de titulares, se continúa con\nlos suplentes. Cuando agotados los suplentes no se alcanza a completar el número de tres (3) Tribunos, el\nDepartamento Ejecutivo convoca a elecciones extraordinarias para cubrir las vacantes hasta completar el período, si\nfaltaren más de nueve (9) meses para la finalización del mandato. Si  tal plazo fuere menor, el Concejo de\nRepresentantes, con mayoría agravada, designa de entre sus miembros quiénes integrarán el Tribunal de Cuentas.\n\n",
      "co:inicioCaracter": 108366,
      "co:finCaracter": 109154,
      "co:inicioTexto": 108380,
      "co:finTexto": 109154,
      "co:caracteresTexto": 774,
      "co:marcadorArticulo": "Artículo 157: ",
      "co:encabezadoPrevioLiteral": "###### REMOCIÓN Y REEMPLAZOS\n",
      "co:inicioEncabezado": 108337,
      "co:finEncabezado": 108366,
      "co:epigrafe": "REMOCIÓN Y REEMPLAZOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/158",
      "@type": "co:Articulo",
      "identifier": "158",
      "name": "Artículo 158",
      "position": 158,
      "text": "El Tribunal de Cuentas tiene autonomía funcional y se constituye por sí mismo. Sesiona con al\nmenos dos de sus miembros y adopta sus decisiones por simple mayoría. En caso de empate, el Presidente tiene\ndoble voto.\n      En las resoluciones que adopte el Tribunal de Cuentas sus miembros no pueden abstenerse.\n\n",
      "co:inicioCaracter": 109187,
      "co:finCaracter": 109512,
      "co:inicioTexto": 109201,
      "co:finTexto": 109512,
      "co:caracteresTexto": 311,
      "co:marcadorArticulo": "Artículo 158: ",
      "co:encabezadoPrevioLiteral": "###### FUNCIONAMIENTO Y QUÓRUM\n\n\n",
      "co:inicioEncabezado": 109154,
      "co:finEncabezado": 109187,
      "co:epigrafe": "FUNCIONAMIENTO Y QUÓRUM",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/159",
      "@type": "co:Articulo",
      "identifier": "159",
      "name": "Artículo 159",
      "position": 159,
      "text": "Anualmente el Cuerpo elige un Presidente que lo representa, quien puede ser reelecto. Si no se\nllega a acuerdo en la designación, se efectúa un sorteo entre sus miembros.\n\n",
      "co:inicioCaracter": 109531,
      "co:finCaracter": 109720,
      "co:inicioTexto": 109548,
      "co:finTexto": 109720,
      "co:caracteresTexto": 172,
      "co:marcadorArticulo": "Artículo 159:    ",
      "co:encabezadoPrevioLiteral": "###### PRESIDENCIA\n",
      "co:inicioEncabezado": 109512,
      "co:finEncabezado": 109531,
      "co:epigrafe": "PRESIDENCIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/160",
      "@type": "co:Articulo",
      "identifier": "160",
      "name": "Artículo 160",
      "position": 160,
      "text": "Ejerce el control económico, contable y de legalidad del gasto y la gestión financiera y patrimonial del\nMunicipio. No puede emitir juicios o valoraciones sobre criterios de oportunidad o conveniencia.\n        El Tribunal de Cuentas dispone de los medios, recursos y personal necesarios para el cumplimiento de sus\nfunciones, según lo dispuesto por su propio presupuesto,  el que, aprobado por el Concejo de Representantes, no\npuede ser objeto de modificación y/o rectificación que no sea dispuesta por iniciativa del propio Tribunal de\nCuentas.\n\n",
      "co:inicioCaracter": 109748,
      "co:finCaracter": 110309,
      "co:inicioTexto": 109762,
      "co:finTexto": 110309,
      "co:caracteresTexto": 547,
      "co:marcadorArticulo": "Artículo 160: ",
      "co:encabezadoPrevioLiteral": "###### COMPETENCIA y MEDIOS\n",
      "co:inicioEncabezado": 109720,
      "co:finEncabezado": 109748,
      "co:epigrafe": "COMPETENCIA y MEDIOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/161",
      "@type": "co:Articulo",
      "identifier": "161",
      "name": "Artículo 161",
      "position": 161,
      "text": "Son atribuciones y deberes del Tribunal de Cuentas:\n1. Fiscalizar las cuentas generales y especiales por medio de auditorías  de contenido económico o financiero, por\npropia iniciativa o a solicitud del Concejo de Representantes o del Departamento Ejecutivo. Para la realización de\nauditorías está facultado a contratar personal para tal fin o disponer que ellas sean externas.\n2. Visar, previo a su cumplimiento, todos los actos administrativos que comprometan gastos, tanto los originados en\nel Departamento Ejecutivo como en organismos descentralizados, autárquicos, empresas o sociedades del Estado, o\ncualquier otro ente que administre o gestione fondos públicos en forma total o parcial.\n3. Aprobar, luego de su cumplimiento, las órdenes de pago expedidas en legal forma.\n4. Observar, si correspondiere, las órdenes de pago ya cumplimentadas, en cuyo caso debe enviar los antecedentes al\nConcejo de Representantes en un plazo no mayor de cinco (5) días hábiles.\n5. Remitir al Concejo de Representantes el dictamen sobre la Cuenta General del Ejercicio, dentro de los cuarenta y\ncinco (45) días posteriores a la recepción.\n6. Fiscalizar el destino y cumplimiento de los recaudos legales respecto de los fondos o beneficios recibidos u\notorgados en carácter de subsidios o subvenciones.\n7. Fiscalizar las cuentas o gastos del Concejo de Representantes.\n8. Fiscalizar las operaciones financieras o patrimoniales de la Administración.\n9. Convocar  a  elecciones  extraordinarias cuando  estuvieren  acéfalos  el Concejo de  Representantes y  el\nDepartamento Ejecutivo.\n10. Instruir sumarios e investigaciones administrativas para determinar responsabilidades patrimoniales.\n11. Dictar su Reglamento Interno.\n12. Designar, promover y remover sus empleados de acuerdo a la legislación vigente.\n13. Controlar la recaudación de los recursos municipales, la inversión de los fondos y las operaciones financieras y\npatrimoniales de los organismos centralizados o descentralizados del Municipio.\n14. Elaborar y remitir el cálculo de gastos e inversiones del Cuerpo al Concejo de Representantes, para su\nincorporación al presupuesto general, antes del primero de septiembre de cada año.\n15. Actuar como órgano requirente ante los Tribunales de Justicia en los Juicios de Cuentas y de responsabilidad de\nlos funcionarios municipales, aun después de cesar en sus cargos y a todos los efectos, por extralimitación o\ncumplimiento irregular, de acuerdo al procedimiento establecido en la Ordenanza.\n16. Revisar y dictaminar los balances parciales y general del ejercicio del Municipio y de los organismos\nautárquicos, empresas, sociedades de economía mixta y entidades donde se comprometan intereses económicos\nmunicipales, de modo  tal que comprenda  la correspondencia de los ingresos y egresos con  las  respectivas\nprevisiones y ejecuciones presupuestarias.\n17. Aprobar o rechazar las cuentas de inversión de los fondos públicos.\n18. Toda otra función que el Concejo de Representantes le asigne por Ordenanza.\n\n",
      "co:inicioCaracter": 110344,
      "co:finCaracter": 113362,
      "co:inicioTexto": 110358,
      "co:finTexto": 113362,
      "co:caracteresTexto": 3004,
      "co:marcadorArticulo": "Artículo 161: ",
      "co:encabezadoPrevioLiteral": "###### ATRIBUCIONES Y OBLIGACIONES\n",
      "co:inicioEncabezado": 110309,
      "co:finEncabezado": 110344,
      "co:epigrafe": "ATRIBUCIONES Y OBLIGACIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/162",
      "@type": "co:Articulo",
      "identifier": "162",
      "name": "Artículo 162",
      "position": 162,
      "text": "El Tribunal de Cuentas puede requerir los datos e informes que necesite para cumplir su cometido, a\nlas oficinas, reparticiones, dependencias, instituciones o entidades municipales, provinciales y/o nacionales y entes\n\n\nprestatarios de servicios públicos, contratistas de obras públicas de competencia municipal y cualquier otro ente que\nadministre o gestione fondos públicos, sea en forma total o parcial, y exigir la presentación de libros, expedientes y\ndocumentos.\nLos informes requeridos  no pueden ser negados.\nAsimismo, debe responder a todos los pedidos de informes que  tanto  el Concejo de Representantes o  el\nDepartamento Ejecutivo le formulen sobre asuntos inherentes a su competencia.\n\n",
      "co:inicioCaracter": 113378,
      "co:finCaracter": 114092,
      "co:inicioTexto": 113392,
      "co:finTexto": 114092,
      "co:caracteresTexto": 700,
      "co:marcadorArticulo": "Artículo 162: ",
      "co:encabezadoPrevioLiteral": "###### INFORMES\n",
      "co:inicioEncabezado": 113362,
      "co:finEncabezado": 113378,
      "co:epigrafe": "INFORMES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/163",
      "@type": "co:Articulo",
      "identifier": "163",
      "name": "Artículo 163",
      "position": 163,
      "text": "La Ordenanza establece la forma de control preventivo, concomitante y posterior del Tribunal de\nCuentas.\n        El visado u observación de los actos sometidos a control se efectúa dentro de los diez (10) días corridos de\nhaberse abocado a su conocimiento. En caso de que el Tribunal formule observación, el Intendente puede insistir, en\nacuerdo de Secretarios. Si el Tribunal de Cuentas la mantiene, formula el visado con reserva dentro de un nuevo\nplazo de cinco (5) días corridos, contados desde que recibió  la insistencia del Departamento Ejecutivo, y remite los\nantecedentes al Concejo de Representantes en un término no mayor de cinco (5) días corridos, contados desde el\nvencimiento del plazo anterior.\n        Transcurridos los plazos de pronunciamiento sin que  el Tribunal de Cuentas se haya expedido,  el\nrequerimiento se tiene por visado.\n       La reiteración injustificada de aprobaciones fictas configura mal desempeño del cargo.\n       Los  visados  pueden  efectuarse  provisionalmente.  Queda  condicionado  su  perfeccionamiento  al\ncumplimiento de lo requerido por el Tribunal de Cuentas.\n        El Departamento Ejecutivo puede solicitar fundadamente el trámite urgente, en cuyo caso el Tribunal debe\nexpedirse obligatoriamente en el término de cuatro (4) días corridos, contados desde la recepción de la solicitud.\n       Ningún acto administrativo que comprometa un gasto será válido si no se ha seguido el procedimiento\nprevisto en esta Carta Orgánica.\n\n",
      "co:inicioCaracter": 114113,
      "co:finCaracter": 115606,
      "co:inicioTexto": 114127,
      "co:finTexto": 115606,
      "co:caracteresTexto": 1479,
      "co:marcadorArticulo": "Artículo 163: ",
      "co:encabezadoPrevioLiteral": "###### PROCEDIMIENTO\n",
      "co:inicioEncabezado": 114092,
      "co:finEncabezado": 114113,
      "co:epigrafe": "PROCEDIMIENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/164",
      "@type": "co:Articulo",
      "identifier": "164",
      "name": "Artículo 164",
      "position": 164,
      "text": "El Tribunal de Cuentas  puede, por mayoría simple, excluir del recinto o suspender temporariamente\nde su seno a cualquiera de sus miembros por desorden en el ejercicio y desempeño de sus funciones. También, por\nigual mayoría,  podrá excluir de su seno a cualquiera de ellos por razones de inhabilidad, incompatibilidad o\nincapacidad sobreviniente. Deberá en todos los casos asegurar la defensa del acusado y la resolución será fundada.\n",
      "co:inicioCaracter": 115652,
      "co:finCaracter": 116102,
      "co:inicioTexto": 115666,
      "co:finTexto": 116102,
      "co:caracteresTexto": 436,
      "co:marcadorArticulo": "Artículo 164: ",
      "co:encabezadoPrevioLiteral": "###### CORRECCIÓN Y EXCLUSIÓN DE SUS MIEMBROS\n",
      "co:inicioEncabezado": 115606,
      "co:finEncabezado": 115652,
      "co:epigrafe": "CORRECCIÓN Y EXCLUSIÓN DE SUS MIEMBROS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/165",
      "@type": "co:Articulo",
      "identifier": "165",
      "name": "Artículo 165",
      "position": 165,
      "text": "Los Jueces Administrativos de Faltas deben ser abogados con cinco (5) años de ejercicio de la\nprofesión y reunir los requisitos y las exigencias establecidas para los miembros del Concejo de Representantes. Les\nalcanzan las inhabilidades e incompatibilidades previstas para aquéllos. Mientras ejercen sus funciones no pueden\nrealizar actividad política partidaria ni ejercer su profesión.\n\n",
      "co:inicioCaracter": 116196,
      "co:finCaracter": 116603,
      "co:inicioTexto": 116213,
      "co:finTexto": 116603,
      "co:caracteresTexto": 390,
      "co:marcadorArticulo": "Artículo 165:    ",
      "co:encabezadoPrevioLiteral": "###### REQUISITOS E INCOMPATIBILIDADES\n",
      "co:inicioEncabezado": 116157,
      "co:finEncabezado": 116196,
      "co:epigrafe": "REQUISITOS E INCOMPATIBILIDADES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/166",
      "@type": "co:Articulo",
      "identifier": "166",
      "name": "Artículo 166",
      "position": 166,
      "text": "La Ordenanza establece el procedimiento ante los Jueces Administrativos de Faltas, el que se\ndesarrolla respetando los principios y garantías reconocidos por la Constitución Nacional, Tratados Internacionales\ncon jerarquía constitucional, la Constitución Provincial y esta Carta Orgánica.\n\n",
      "co:inicioCaracter": 116624,
      "co:finCaracter": 116928,
      "co:inicioTexto": 116638,
      "co:finTexto": 116928,
      "co:caracteresTexto": 290,
      "co:marcadorArticulo": "Artículo 166: ",
      "co:encabezadoPrevioLiteral": "###### PROCEDIMIENTO\n",
      "co:inicioEncabezado": 116603,
      "co:finEncabezado": 116624,
      "co:epigrafe": "PROCEDIMIENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/167",
      "@type": "co:Articulo",
      "identifier": "167",
      "name": "Artículo 167",
      "position": 167,
      "text": "Los Jueces Administrativos de Faltas elaboran el presupuesto de gastos del Tribunal y lo remiten\nal Concejo de Representantes para su incorporación al proyecto de Presupuesto General de Gastos y Cálculo de\nRecursos.\n\n",
      "co:inicioCaracter": 116947,
      "co:finCaracter": 117181,
      "co:inicioTexto": 116964,
      "co:finTexto": 117181,
      "co:caracteresTexto": 217,
      "co:marcadorArticulo": "Artículo 167:    ",
      "co:encabezadoPrevioLiteral": "###### PRESUPUESTO\n",
      "co:inicioEncabezado": 116928,
      "co:finEncabezado": 116947,
      "co:epigrafe": "PRESUPUESTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/168",
      "@type": "co:Articulo",
      "identifier": "168",
      "name": "Artículo 168",
      "position": 168,
      "text": "El Consejo Municipal de Concursos está integrado por un letrado designado por el Departamento\nEjecutivo, un representante abogado propuesto por cada bloque político del Concejo de Representantes y un\nrepresentante letrado del Colegio de Abogados de Villa Carlos Paz, y se constituye al solo efecto del concurso. Sus\nmiembros son designados mediante el sistema que determina la Ordenanza pertinente, pueden ser reelegidos y por el\ncumplimiento de sus funciones no perciben remuneración alguna.\n\n\nAl Consejo Municipal de Concursos le corresponde proponer al Departamento Ejecutivo los candidatos a ocupar los\ncargos de la Justicia Administrativa de Faltas y del Defensor de Oficio, previa sustanciación de concursos de títulos,\nantecedentes y oposición.\n\n",
      "co:inicioCaracter": 117219,
      "co:finCaracter": 117986,
      "co:inicioTexto": 117233,
      "co:finTexto": 117986,
      "co:caracteresTexto": 753,
      "co:marcadorArticulo": "Artículo 168: ",
      "co:encabezadoPrevioLiteral": "###### CONSEJO MUNICIPAL DE CONCURSOS\n",
      "co:inicioEncabezado": 117181,
      "co:finEncabezado": 117219,
      "co:epigrafe": "CONSEJO MUNICIPAL DE CONCURSOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/169",
      "@type": "co:Articulo",
      "identifier": "169",
      "name": "Artículo 169",
      "position": 169,
      "text": "Créase en la órbita del Tribunal Administrativo de Faltas, la figura del Defensor de Oficio, con los\nmismos requisitos e inhabilidades establecidas para los Jueces Administrativos de Faltas, siendo elegido de la misma\nmanera. Tiene a su cargo el asesoramiento y defensa de los administrados en las tramitaciones ante el Tribunal\nAdministrativo de Faltas y en los eventuales recursos administrativos que deban interponerse.\n\n",
      "co:inicioCaracter": 118012,
      "co:finCaracter": 118450,
      "co:inicioTexto": 118026,
      "co:finTexto": 118450,
      "co:caracteresTexto": 424,
      "co:marcadorArticulo": "Artículo 169: ",
      "co:encabezadoPrevioLiteral": "###### DEFENSOR DE OFICIO\n",
      "co:inicioEncabezado": 117986,
      "co:finEncabezado": 118012,
      "co:epigrafe": "DEFENSOR DE OFICIO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/170",
      "@type": "co:Articulo",
      "identifier": "170",
      "name": "Artículo 170",
      "position": 170,
      "text": "Los recursos contra las resoluciones del Tribunal Administrativo de Faltas se sustanciarán ante el\nIntendente. Deberá crearse un sistema interno de precedentes obligatorios y acceso público para la Jurisprudencia\nAdministrativa Municipal.\n",
      "co:inicioCaracter": 118466,
      "co:finCaracter": 118719,
      "co:inicioTexto": 118480,
      "co:finTexto": 118719,
      "co:caracteresTexto": 239,
      "co:marcadorArticulo": "Artículo 170: ",
      "co:encabezadoPrevioLiteral": "###### RECURSOS\n",
      "co:inicioEncabezado": 118450,
      "co:finEncabezado": 118466,
      "co:epigrafe": "RECURSOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/14"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/171",
      "@type": "co:Articulo",
      "identifier": "171",
      "name": "Artículo 171",
      "position": 171,
      "text": "La Defensoría del Pueblo es un organismo independiente que actúa con plena autonomía funcional,\nsin recibir instrucciones de otra autoridad. Su misión es la defensa y protección de los derechos humanos y demás\nderechos, garantías e intereses tutelados en la Constitución Nacional, Constitución Provincial, esta Carta Orgánica,\nleyes y ordenanzas, ante hechos, actos u omisiones de la administración pública municipal. Supervisa la eficacia de\nla prestación de los servicios públicos y la aplicación de las ordenanzas y demás disposiciones.\nTendrá a su cargo, en el ámbito del ejido municipal, la defensa de los derechos de la niña, el niño y el adolescente y\nvelará por la protección y promoción de sus derechos, consagrados en la Constitución Nacional y en la Convención\nsobre los Derechos del Niño, leyes nacionales y provinciales.\n\n",
      "co:inicioCaracter": 118809,
      "co:finCaracter": 119658,
      "co:inicioTexto": 118823,
      "co:finTexto": 119658,
      "co:caracteresTexto": 835,
      "co:marcadorArticulo": "Artículo 171: ",
      "co:encabezadoPrevioLiteral": "###### FINES\n",
      "co:inicioEncabezado": 118796,
      "co:finEncabezado": 118809,
      "co:epigrafe": "FINES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/172",
      "@type": "co:Articulo",
      "identifier": "172",
      "name": "Artículo 172",
      "position": 172,
      "text": "La Defensoría del Pueblo está a cargo del Defensor del Pueblo y constituida  por  el Defensor del\nPueblo Adjunto y por los funcionarios y personal que la Ordenanza establece.\n\n",
      "co:inicioCaracter": 119678,
      "co:finCaracter": 119868,
      "co:inicioTexto": 119692,
      "co:finTexto": 119868,
      "co:caracteresTexto": 176,
      "co:marcadorArticulo": "Artículo 172: ",
      "co:encabezadoPrevioLiteral": "###### CONSTITUCIÓN\n",
      "co:inicioEncabezado": 119658,
      "co:finEncabezado": 119678,
      "co:epigrafe": "CONSTITUCIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/173",
      "@type": "co:Articulo",
      "identifier": "173",
      "name": "Artículo 173",
      "position": 173,
      "text": "El Defensor del Pueblo es elegido en elección popular a simple pluralidad de sufragios. La elección se\nrealiza en la mitad del período de las autoridades municipales, su mandato dura cuatro (4) años y puede ser reelecto\nde manera indefinida. En el mismo acto electoral se eligen un Defensor del Pueblo Adjunto y un suplente para cada\nuno de ellos.\n\n",
      "co:inicioCaracter": 119908,
      "co:finCaracter": 120271,
      "co:inicioTexto": 119922,
      "co:finTexto": 120271,
      "co:caracteresTexto": 349,
      "co:marcadorArticulo": "Artículo 173: ",
      "co:encabezadoPrevioLiteral": " ###### ELECCIÓN Y DURACIÓN DEL MANDATO\n",
      "co:inicioEncabezado": 119868,
      "co:finEncabezado": 119908,
      "co:epigrafe": "ELECCIÓN Y DURACIÓN DEL MANDATO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/174",
      "@type": "co:Articulo",
      "identifier": "174",
      "name": "Artículo 174",
      "position": 174,
      "text": "El Defensor del Pueblo y su Adjunto deben ser mayores de cuarenta (40) años y tener residencia\nestable y continua de quince (15) años en Villa Carlos Paz. Los alcanzan los otros requisitos, inhabilidades e\nincompatibilidades previstos para los Concejales.\n\n",
      "co:inicioCaracter": 120326,
      "co:finCaracter": 120597,
      "co:inicioTexto": 120340,
      "co:finTexto": 120597,
      "co:caracteresTexto": 257,
      "co:marcadorArticulo": "Artículo 174: ",
      "co:encabezadoPrevioLiteral": "###### REQUISITOS, INCOMPATIBILIDADES E INHABILIDADES.\n",
      "co:inicioEncabezado": 120271,
      "co:finEncabezado": 120326,
      "co:epigrafe": "REQUISITOS, INCOMPATIBILIDADES E INHABILIDADES.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/175",
      "@type": "co:Articulo",
      "identifier": "175",
      "name": "Artículo 175",
      "position": 175,
      "text": "A partir de su elección, les está prohibida la realización de cualquier actividad político partidaria. Ni el\nDefensor del Pueblo ni su Adjunto pueden postularse para ocupar cargos electivos en las elecciones municipales\ninmediatas posteriores a la conclusión de sus mandatos, cualquiera fuera la causa.\n\n",
      "co:inicioCaracter": 120618,
      "co:finCaracter": 120936,
      "co:inicioTexto": 120632,
      "co:finTexto": 120936,
      "co:caracteresTexto": 304,
      "co:marcadorArticulo": "Artículo 175: ",
      "co:encabezadoPrevioLiteral": "###### PROHIBICIONES\n",
      "co:inicioEncabezado": 120597,
      "co:finEncabezado": 120618,
      "co:epigrafe": "PROHIBICIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/176",
      "@type": "co:Articulo",
      "identifier": "176",
      "name": "Artículo 176",
      "position": 176,
      "text": "La remuneración del Defensor del Pueblo es igual a la del Intendente y la de su Adjunto será\ndeterminada por la Ordenanza pertinente.\n\n",
      "co:inicioCaracter": 120957,
      "co:finCaracter": 121106,
      "co:inicioTexto": 120971,
      "co:finTexto": 121106,
      "co:caracteresTexto": 135,
      "co:marcadorArticulo": "Artículo 176: ",
      "co:encabezadoPrevioLiteral": " ###### REMUNERACIÓN\n",
      "co:inicioEncabezado": 120936,
      "co:finEncabezado": 120957,
      "co:epigrafe": "REMUNERACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/177",
      "@type": "co:Articulo",
      "identifier": "177",
      "name": "Artículo 177",
      "position": 177,
      "text": "El Defensor del Pueblo y su Adjunto son removidos mediante revocatoria popular o Juicio Político.\n\n",
      "co:inicioCaracter": 121122,
      "co:finCaracter": 121235,
      "co:inicioTexto": 121136,
      "co:finTexto": 121235,
      "co:caracteresTexto": 99,
      "co:marcadorArticulo": "Artículo 177: ",
      "co:encabezadoPrevioLiteral": "###### REMOCIÓN\n",
      "co:inicioEncabezado": 121106,
      "co:finEncabezado": 121122,
      "co:epigrafe": "REMOCIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/178",
      "@type": "co:Articulo",
      "identifier": "178",
      "name": "Artículo 178",
      "position": 178,
      "text": "En caso de renuncia, fallecimiento o remoción del Defensor del Pueblo, por cualquier causa, es\n\n\nreemplazado por el Defensor del Pueblo Adjunto hasta la finalización del mandato. En caso de que el alejamiento\ndefinitivo sea de ambos, serán reemplazados por sus respectivos suplentes.\n\n",
      "co:inicioCaracter": 121252,
      "co:finCaracter": 121551,
      "co:inicioTexto": 121266,
      "co:finTexto": 121551,
      "co:caracteresTexto": 285,
      "co:marcadorArticulo": "Artículo 178: ",
      "co:encabezadoPrevioLiteral": "###### REEMPLAZO\n",
      "co:inicioEncabezado": 121235,
      "co:finEncabezado": 121252,
      "co:epigrafe": "REEMPLAZO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/179",
      "@type": "co:Articulo",
      "identifier": "179",
      "name": "Artículo 179",
      "position": 179,
      "text": "El Defensor del Pueblo tiene las siguientes atribuciones y deberes:\n1.       Realizar investigaciones en  el marco de las competencias y finalidades que  le establece esta Carta\nOrgánica, en salvaguarda de los intereses de los habitantes del Municipio; de oficio, en casos de presuntos abusos,\ndesviación de poder e irregularidades notorios; a petición de cualquier habitante, sobre la base de denuncias que éste\nformule. Todas las dependencias municipales se encuentran obligadas a prestar colaboración para esta tarea, y no\npuede negársele el acceso a expedientes, archivos o medios de información alguno.\n2.      Promover las acciones necesarias para la protección de los intereses difusos o colectivos relativos a las\nniñas, los niños y los adolescentes.\n3.      Tiene legitimación procesal y facultad de iniciativa legislativa.\n4.       Interponer acción judicial en contra de actos o hechos que afecten intereses difusos y derechos colectivos\nde los habitantes del Municipio.\n5.       Fiscalizar el Libro de Reclamos que en forma obligatoria debe habilitarse en las dependencias municipales\ny receptar denuncias y reclamos de los particulares, los que en ningún caso pueden ser objeto de tasas o gravámenes.\n6.       Presentar anualmente una memoria de lo actuado y un informe al Concejo de Representantes, el que con\nasistencia del Intendente y sus Secretarios, lo escucha en sesión pública, la que será anunciada con treinta (30) días\nde anticipación para promover la asistencia del pueblo y sus organizaciones en general. La memoria y el informe es\npublicado en el Boletín Oficial Municipal.\n7.       Elaborar y remitir al Concejo de Representantes el presupuesto de gastos e inversiones de su gestión para\nsu inclusión en el Presupuesto General de Gastos y Cálculo de Recursos del ejercicio.\n8.      Designar y remover al personal que la Ordenanza establece.\n9.      Responder en tiempo y forma los informes que le requiere el Concejo de Representantes, el Departamento\nEjecutivo y el Tribunal de Cuentas.\n10.      Solicitar la comparecencia personal de los presuntos responsables, testigos, denunciantes y cualquier\nparticular o funcionario municipal que puedan proporcionar información sobre los hechos que se investigan.\n11.     Informar  a  la  opinión  pública y a  los organismos  municipales competentes  sobre  los hechos o\ncircunstancias que a su criterio merezcan publicidad.\n12.      Participar con voz pero sin voto en las sesiones del Concejo de Representantes cuando se trate de proyectos\npresentados a su instancia o en temas de su competencia.\n13.     Actuar como instancia de mediación vecinal.\n14.     Los pedidos de informes deberán ser contestados dentro de los sesenta (60) días de comunicados. La falta\nde respuesta configura mal desempeño a los fines de esta Carta Orgánica.\n\n",
      "co:inicioCaracter": 121581,
      "co:finCaracter": 124405,
      "co:inicioTexto": 121596,
      "co:finTexto": 124405,
      "co:caracteresTexto": 2809,
      "co:marcadorArticulo": "Artículo 179:  ",
      "co:encabezadoPrevioLiteral": "###### ATRIBUCIONES Y DEBERES\n",
      "co:inicioEncabezado": 121551,
      "co:finEncabezado": 121581,
      "co:epigrafe": "ATRIBUCIONES Y DEBERES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/180",
      "@type": "co:Articulo",
      "identifier": "180",
      "name": "Artículo 180",
      "position": 180,
      "text": "En ejercicio de sus atribuciones y deberes y conforme con su competencia y finalidad, el Defensor del\nPueblo puede formular  juicios, los que materializa en reclamos, sugerencias, recomendaciones o propuestas\ndirigidas a los órganos de gobierno y de control que, según su criterio, deban conocerlos.\n\n",
      "co:inicioCaracter": 124439,
      "co:finCaracter": 124754,
      "co:inicioTexto": 124453,
      "co:finTexto": 124754,
      "co:caracteresTexto": 301,
      "co:marcadorArticulo": "Artículo 180: ",
      "co:encabezadoPrevioLiteral": " ###### EJERCICIO DE LA ACTIVIDAD\n",
      "co:inicioEncabezado": 124405,
      "co:finEncabezado": 124439,
      "co:epigrafe": "EJERCICIO DE LA ACTIVIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/181",
      "@type": "co:Articulo",
      "identifier": "181",
      "name": "Artículo 181",
      "position": 181,
      "text": "La Ordenanza reglamenta las funciones, deberes y atribuciones  de la Defensoría del Pueblo, del\nDefensor del Pueblo y de su Adjunto. Se aplican los principios de informalismo, gratuidad, impulso de oficio,\nsumariedad y accesibilidad. El presupuesto municipal asegura el equipamiento, emolumentos, recursos y el personal\npara el cumplimiento de sus funciones.\n",
      "co:inicioCaracter": 124797,
      "co:finCaracter": 125170,
      "co:inicioTexto": 124811,
      "co:finTexto": 125170,
      "co:caracteresTexto": 359,
      "co:marcadorArticulo": "Artículo 181: ",
      "co:encabezadoPrevioLiteral": "###### REGLAMENTACIÓN   Ver Ordenanza 4976\n",
      "co:inicioEncabezado": 124754,
      "co:finEncabezado": 124797,
      "co:epigrafe": "REGLAMENTACIÓN   Ver Ordenanza 4976",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/15"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/182",
      "@type": "co:Articulo",
      "identifier": "182",
      "name": "Artículo 182",
      "position": 182,
      "text": "Créase un Ente de Control de Servicios Públicos, con el objetivo de ejercer el poder de policía y\ncontrol en la contratación, adjudicación y prestación de todos los servicios públicos  de la ciudad de Villa Carlos\nPaz, cualquiera fuere la modalidad de prestación, tenga el prestador carácter público (estatal o no estatal) o privado.\nEl Ente se crea como organismo desconcentrado y  tendrá como marco regulatorio  esta Carta Orgánica, los\ncontratos y las Ordenanzas vigentes. Su funcionamiento se basa en los principios de receptividad, eficiencia,\nimparcialidad, legalidad, publicidad y transparencia de las prestaciones. Una Ordenanza especial regulará  el\n\n\nfuncionamiento, organización, procedimientos y atribuciones del Ente, asegurando la participación de los usuarios\ncon el alcance que allí se establezca.\n\n",
      "co:inicioCaracter": 125274,
      "co:finCaracter": 126103,
      "co:inicioTexto": 125288,
      "co:finTexto": 126103,
      "co:caracteresTexto": 815,
      "co:marcadorArticulo": "Artículo 182: ",
      "co:encabezadoPrevioLiteral": "###### ENTE DE CONTROL DE SERVICIOS PÚBLICOS\n",
      "co:inicioEncabezado": 125229,
      "co:finEncabezado": 125274,
      "co:epigrafe": "ENTE DE CONTROL DE SERVICIOS PÚBLICOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/16"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/16"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/183",
      "@type": "co:Articulo",
      "identifier": "183",
      "name": "Artículo 183",
      "position": 183,
      "text": "El Ente de Control tendrá un organismo de conducción que se integrará con tres Directores: un\nprofesional de  la  Ingeniería o  Arquitectura, un profesional  del Derecho y un profesional de  las Ciencias\nEconómicas;  los  dos  primeros  serán  designados  por  concursos de  antecedentes y  oposición convocados\nconjuntamente por el Departamento Ejecutivo Municipal y el Concejo de Representantes, y el tercero por el\nDepartamento Ejecutivo Municipal con acuerdo del Concejo de Representantes. Regirán para ellos las inhabilidades\ne incompatibilidades previstas por esta Carta Orgánica para los Concejales. Además, es incompatible con el cargo de\nDirector del Ente haber integrado en los últimos cinco años, como directivo o empleado, alguna de las empresas\nsujetas al control del Ente. La ordenanza regula los requisitos, duración, remuneración y remoción del Directorio.\n",
      "co:inicioCaracter": 126122,
      "co:finCaracter": 127009,
      "co:inicioTexto": 126136,
      "co:finTexto": 127009,
      "co:caracteresTexto": 873,
      "co:marcadorArticulo": "Artículo 183: ",
      "co:encabezadoPrevioLiteral": "###### INTEGRACIÓN\n",
      "co:inicioEncabezado": 126103,
      "co:finEncabezado": 126122,
      "co:epigrafe": "INTEGRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/16"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/16"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/184",
      "@type": "co:Articulo",
      "identifier": "184",
      "name": "Artículo 184",
      "position": 184,
      "text": "El Intendente, los Concejales, los miembros del Tribunal de Cuentas, el Defensor del Pueblo y el\nDefensor del Pueblo Adjunto pueden ser denunciados ante el Concejo de Representantes  por cualquier Concejal o\nelector  de la Ciudad en pleno goce de su capacidad, por mal desempeño de sus funciones, seria irregularidad,\ncomisión de delitos en el ejercicio de sus funciones o delitos dolosos comunes.\n\n",
      "co:inicioCaracter": 127172,
      "co:finCaracter": 127585,
      "co:inicioTexto": 127186,
      "co:finTexto": 127585,
      "co:caracteresTexto": 399,
      "co:marcadorArticulo": "Artículo 184: ",
      "co:encabezadoPrevioLiteral": "###### DENUNCIA\n",
      "co:inicioEncabezado": 127156,
      "co:finEncabezado": 127172,
      "co:epigrafe": "DENUNCIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/185",
      "@type": "co:Articulo",
      "identifier": "185",
      "name": "Artículo 185",
      "position": 185,
      "text": "Todos los años, en su primera sesión, el Concejo de Representantes se divide por sorteo  en dos salas\nde igual número de miembros, a los fines de la tramitación del Juicio Político. La Sala acusadora tiene a su cargo la\ninvestigación y acusación y la Sala de Juzgamiento es la encargada del conocimiento de la acusación, eligiendo\nambas a su presidente de uno de sus miembros. En caso de que el denunciante o el denunciado sea Concejal, deberá\napartarse de la Sala que integra.\n\n",
      "co:inicioCaracter": 127610,
      "co:finCaracter": 128103,
      "co:inicioTexto": 127624,
      "co:finTexto": 128103,
      "co:caracteresTexto": 479,
      "co:marcadorArticulo": "Artículo 185: ",
      "co:encabezadoPrevioLiteral": "###### DIVISIÓN EN SALAS\n",
      "co:inicioEncabezado": 127585,
      "co:finEncabezado": 127610,
      "co:epigrafe": "DIVISIÓN EN SALAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/186",
      "@type": "co:Articulo",
      "identifier": "186",
      "name": "Artículo 186",
      "position": 186,
      "text": "La Sala Acusadora practica las investigaciones relativas a la denuncia recibida y requiere del voto\nfavorable de la mayoría agravada para presentar acusación, lo que debe hacer por ante la Sala de Juzgamiento,\ndentro del término perentorio de cuarenta y cinco (45) días de recibida la denuncia. La Sala Juzgadora oye  al\nacusado en sesión especial, debiendo garantizar:\n1. Convocar a la sesión con cinco días hábiles de anticipación, como mínimo,  con notificación, citación y\nemplazamiento al acusado por medios fehacientes, en la que debe entregarle copias o actas autenticadas de la\ndenuncia formulada, de la resolución de la Sala Acusadora y de la prueba obrante en las actuaciones.\n2. Dar difusión a la sesión prevista en el inciso anterior, con el mismo término de anticipación allí establecido, por\nlos medios con que cuenta el Municipio.\n3. Asegurar en ella la defensa del acusado, para lo cual éste puede ofrecer todas las pruebas que hagan a su derecho.\nPuede concurrir acompañado de letrado.\n4. Disponer los cuartos intermedios que fueren necesarios para recibir las pruebas o adoptar resoluciones.\n5. Resolver la causa en un plazo no mayor de sesenta (60) días.\n\n",
      "co:inicioCaracter": 128125,
      "co:finCaracter": 129314,
      "co:inicioTexto": 128139,
      "co:finTexto": 129314,
      "co:caracteresTexto": 1175,
      "co:marcadorArticulo": "Artículo 186: ",
      "co:encabezadoPrevioLiteral": "###### PROCEDIMIENTO.\n",
      "co:inicioEncabezado": 128103,
      "co:finEncabezado": 128125,
      "co:epigrafe": "PROCEDIMIENTO.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/187",
      "@type": "co:Articulo",
      "identifier": "187",
      "name": "Artículo 187",
      "position": 187,
      "text": "La inasistencia injustificada a estas Sesiones por parte de los Concejales será sancionada con una\nmulta igual a la quinta parte de sus dietas. En caso de reincidencia, en una segunda citación se duplicará el monto de\nla multa.\n\n\n",
      "co:inicioCaracter": 129353,
      "co:finCaracter": 129597,
      "co:inicioTexto": 129367,
      "co:finTexto": 129597,
      "co:caracteresTexto": 230,
      "co:marcadorArticulo": "Artículo 187: ",
      "co:encabezadoPrevioLiteral": "###### INASISTENCIA DE LOS CONCEJALES.\n",
      "co:inicioEncabezado": 129314,
      "co:finEncabezado": 129353,
      "co:epigrafe": "INASISTENCIA DE LOS CONCEJALES.",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/188",
      "@type": "co:Articulo",
      "identifier": "188",
      "name": "Artículo 188",
      "position": 188,
      "text": "En la sesión especial, la Sala Juzgadora, por mayoría agravada, resuelve si el acusado es responsable\npolíticamente por las causales que se le imputan. Tal resolución debe ser escrita, con fundamentación lógica y legal\ny es irrecurrible. La votación es nominal, registrándose en el acta el voto de cada  Concejal sobre cada uno de los\ncargos que contenga el acta de acusación.\n\n",
      "co:inicioCaracter": 129615,
      "co:finCaracter": 130007,
      "co:inicioTexto": 129629,
      "co:finTexto": 130007,
      "co:caracteresTexto": 378,
      "co:marcadorArticulo": "Artículo 188: ",
      "co:encabezadoPrevioLiteral": "###### RESOLUCIÓN\n",
      "co:inicioEncabezado": 129597,
      "co:finEncabezado": 129615,
      "co:epigrafe": "RESOLUCIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/189",
      "@type": "co:Articulo",
      "identifier": "189",
      "name": "Artículo 189",
      "position": 189,
      "text": "En caso de que la Sala Juzgadora se pronuncie por la remoción de los funcionarios sometidos a Juicio\nPolítico, se convoca al electorado para que resuelva si corresponde la destitución. A tal efecto, el Presidente del\nConcejo de Representantes convoca al referéndum respectivo, el que debe realizarse en un plazo no mayor de\ncuarenta y cinco (45) días. En tal acto el sufragio es obligatorio.\nEs destituido el funcionario si se manifiesta en este sentido la mayoría absoluta de los votos válidos emitidos y\ncuando se trate del Intendente, es de aplicación el supuesto de acefalía.\n\n",
      "co:inicioCaracter": 130025,
      "co:finCaracter": 130620,
      "co:inicioTexto": 130039,
      "co:finTexto": 130620,
      "co:caracteresTexto": 581,
      "co:marcadorArticulo": "Artículo 189: ",
      "co:encabezadoPrevioLiteral": "###### REFERÉNDUM\n",
      "co:inicioEncabezado": 130007,
      "co:finEncabezado": 130025,
      "co:epigrafe": "REFERÉNDUM",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/190",
      "@type": "co:Articulo",
      "identifier": "190",
      "name": "Artículo 190",
      "position": 190,
      "text": "Si se promueve el procedimiento determinado por los artículos  precedentes, el electorado no puede\nejercer el derecho de revocatoria previsto en la presente Carta Orgánica hasta que no finalice aquél y viceversa.\n\n",
      "co:inicioCaracter": 130656,
      "co:finCaracter": 130884,
      "co:inicioTexto": 130670,
      "co:finTexto": 130884,
      "co:caracteresTexto": 214,
      "co:marcadorArticulo": "Artículo 190: ",
      "co:encabezadoPrevioLiteral": "###### PROHIBICIÓN DE SIMULTANEIDAD\n",
      "co:inicioEncabezado": 130620,
      "co:finEncabezado": 130656,
      "co:epigrafe": "PROHIBICIÓN DE SIMULTANEIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/191",
      "@type": "co:Articulo",
      "identifier": "191",
      "name": "Artículo 191",
      "position": 191,
      "text": "Cuando la autoridad judicial atribuya al Intendente, Concejales, miembros del Tribunal de Cuentas o\nDefensor del Pueblo, la comisión de un delito, y obrare en los actuados requerimiento firme de elevación a juicio, el\nConcejo de Representantes, previo valorar  la incidencia funcional del hecho imputado, puede suspender  al\nfuncionario de que se trate con el voto de la mayoría agravada del Cuerpo. Si transcurren seis meses de suspensión y\nen la causa no hubiere sentencia firme y definitiva, el funcionario reasume sus funciones si su situación personal lo\npermite, sin perjuicio de que la posterior sentencia condenatoria hiciere procedente el trámite de su destitución.\nEl sobreseimiento o absolución del funcionario provoca la restitución de pleno derecho, con la totalidad de sus\nfacultades y percepción de los haberes caídos.\nEl Concejo de Representantes debe adoptar estas decisiones en la sesión siguiente al conocimiento de la resolución\njudicial.\nEn caso de mediar privación de la libertad, la suspensión puede ordenarse desde que la prisión preventiva queda\nfirme.\n",
      "co:inicioCaracter": 130916,
      "co:finCaracter": 132008,
      "co:inicioTexto": 130930,
      "co:finTexto": 132008,
      "co:caracteresTexto": 1078,
      "co:marcadorArticulo": "Artículo 191: ",
      "co:encabezadoPrevioLiteral": "###### SUSPENSIÓN Y DESTITUCIÓN\n",
      "co:inicioEncabezado": 130884,
      "co:finEncabezado": 130916,
      "co:epigrafe": "SUSPENSIÓN Y DESTITUCIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/8"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/192",
      "@type": "co:Articulo",
      "identifier": "192",
      "name": "Artículo 192",
      "position": 192,
      "text": "El Intendente, los Concejales,  miembros del Tribunal de Cuentas y Defensor del Pueblo  no pueden\nabandonar de manera permanente la jurisdicción del Municipio, hasta después de ciento ochenta  días corridos de\nterminadas sus funciones, salvo expresa autorización otorgada por  el Concejo de Representantes  , por estar\nsometidos a Juicio de Residencia. Se considera abandono al cambio de residencia real y efectiva fuera del ejido\nmunicipal, excluyéndose los traslados temporarios que no impliquen dicho cambio.\n\n",
      "co:inicioCaracter": 132111,
      "co:finCaracter": 132638,
      "co:inicioTexto": 132125,
      "co:finTexto": 132638,
      "co:caracteresTexto": 513,
      "co:marcadorArticulo": "Artículo 192: ",
      "co:encabezadoPrevioLiteral": "###### JUICIO DE RESIDENCIA\n",
      "co:inicioEncabezado": 132083,
      "co:finEncabezado": 132111,
      "co:epigrafe": "JUICIO DE RESIDENCIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/193",
      "@type": "co:Articulo",
      "identifier": "193",
      "name": "Artículo 193",
      "position": 193,
      "text": "El Concejo de Representantes, por mayoría agravada,  remueve al Intendente  en el caso de\nincapacidad física o psíquica sobrevivientes. Para que la remoción proceda deberá tener carácter permanente y estar\ndebidamente acreditada.\n",
      "co:inicioCaracter": 132670,
      "co:finCaracter": 132914,
      "co:inicioTexto": 132684,
      "co:finTexto": 132914,
      "co:caracteresTexto": 230,
      "co:marcadorArticulo": "Artículo 193: ",
      "co:encabezadoPrevioLiteral": "###### REMOCIÓN POR INCAPACIDAD\n",
      "co:inicioEncabezado": 132638,
      "co:finEncabezado": 132670,
      "co:epigrafe": "REMOCIÓN POR INCAPACIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/9"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/2"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/5"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/9"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/194",
      "@type": "co:Articulo",
      "identifier": "194",
      "name": "Artículo 194",
      "position": 194,
      "text": "Los electores tienen el derecho de Iniciativa Popular para presentar proyectos de ordenanza. El\nConcejo de Representantes  debe tratarlos dentro de los sesenta (60) días corridos, contados desde su presentación.\nNo pueden ser objeto de Iniciativa Popular las siguientes materias:\n1. Reforma de la Carta Orgánica.\n2. Celebración de convenios y acuerdos intermunicipales e interjurisdiccionales.\n3.  Creación y organización de Secretarías del Departamento Ejecutivo.\n4.  Presupuesto.\n5.  Creación de  Tributos.\n6.  Régimen electoral.\n7.  Partidos Políticos.\n8. Todo asunto que, importando un gasto, no prevea los recursos correspondientes para su atención.\nLa ordenanza reglamenta las condiciones para el ejercicio de este derecho y asegura la gratuidad de la certificación\nde las firmas cuando se efectúe ante la Junta Electoral o siguiendo otros procedimientos que ella  prevea.\nToda iniciativa debe acreditar el aval de por lo menos el diez por ciento  del padrón electoral  actualizado.\n\n\n",
      "co:inicioCaracter": 133180,
      "co:finCaracter": 134185,
      "co:inicioTexto": 133194,
      "co:finTexto": 134185,
      "co:caracteresTexto": 991,
      "co:marcadorArticulo": "Artículo 194: ",
      "co:encabezadoPrevioLiteral": "###### INICIATIVA POPULAR\n",
      "co:inicioEncabezado": 133154,
      "co:finEncabezado": 133180,
      "co:epigrafe": "INICIATIVA POPULAR",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/17"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/10"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/17"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/195",
      "@type": "co:Articulo",
      "identifier": "195",
      "name": "Artículo 195",
      "position": 195,
      "text": "El Concejo de Representantes  o el Departamento Ejecutivo pueden convocar a Consulta Popular no\nvinculante. El voto no es obligatorio. La ordenanza de convocatoria no puede ser vetada.\nEl Concejo de Representantes, con el voto de la mayoría absoluta, reglamenta las materias y procedimientos\nreferidos a ella.\n",
      "co:inicioCaracter": 134209,
      "co:finCaracter": 134533,
      "co:inicioTexto": 134223,
      "co:finTexto": 134533,
      "co:caracteresTexto": 310,
      "co:marcadorArticulo": "Artículo 195: ",
      "co:encabezadoPrevioLiteral": "###### CONSULTA POPULAR\n",
      "co:inicioEncabezado": 134185,
      "co:finEncabezado": 134209,
      "co:epigrafe": "CONSULTA POPULAR",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/17"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/10"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/17"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/196",
      "@type": "co:Articulo",
      "identifier": "196",
      "name": "Artículo 196",
      "position": 196,
      "text": "El Concejo de Representantes, por mayoría agravada, puede someter a referéndum un proyecto de\nOrdenanza. El sufragio  es obligatorio y su convocatoria no puede ser vetada. La aprobación por el electorado, por\nsimple pluralidad de sufragios, lo convierte en Ordenanza si lo  emite al menos el treinta y cinco (35) por ciento del\npadrón electoral municipal. En ese caso la Ordenanza no puede ser vetada.\nEl Intendente puede someter a referéndum un proyecto de ordenanza que el Concejo de Representantes haya\nrechazado dos veces. También puede hacerlo cuando se trate de una ordenanza vetada por el Departamento\nEjecutivo y el Concejo  de Representantes  haya insistido en su sanción.\nEl electorado, por solicitud de al menos el cinco (5) por ciento de los integrantes del padrón electoral municipal,\npuede someter a referéndum facultativo una ordenanza, siempre que el pedido se formule dentro de los treinta días\nhábiles de haber sido promulgada. La petición debe formularse ante la Junta Electoral Municipal.\n\n",
      "co:inicioCaracter": 134603,
      "co:finCaracter": 135627,
      "co:inicioTexto": 134617,
      "co:finTexto": 135627,
      "co:caracteresTexto": 1010,
      "co:marcadorArticulo": "Artículo 196: ",
      "co:encabezadoPrevioLiteral": "###### REFERÉNDUM FACULTATIVO\n",
      "co:inicioEncabezado": 134573,
      "co:finEncabezado": 134603,
      "co:epigrafe": "REFERÉNDUM FACULTATIVO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/18"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/10"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/18"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/197",
      "@type": "co:Articulo",
      "identifier": "197",
      "name": "Artículo 197",
      "position": 197,
      "text": "Además de los casos previstos en esta Carta Orgánica, deben someterse a referéndum obligatorio los\nproyectos de ordenanza que tienen origen en el derecho de iniciativa popular, que hayan  sido presentados por no\nmenos del diez (10) por ciento del padrón electoral  municipal  y que no fueran tratados por el Concejo de\nRepresentantes  dentro del término de sesenta (60) días corridos  a contar desde su presentación, o cuando,\nsancionada por el Concejo de Representantes, es vetada por el Departamento Ejecutivo y el Concejo no hubiera\ninsistido.\n",
      "co:inicioCaracter": 135657,
      "co:finCaracter": 136218,
      "co:inicioTexto": 135671,
      "co:finTexto": 136218,
      "co:caracteresTexto": 547,
      "co:marcadorArticulo": "Artículo 197: ",
      "co:encabezadoPrevioLiteral": "###### REFERÉNDUM OBLIGATORIO\n",
      "co:inicioEncabezado": 135627,
      "co:finEncabezado": 135657,
      "co:epigrafe": "REFERÉNDUM OBLIGATORIO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/18"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/10"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/18"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/198",
      "@type": "co:Articulo",
      "identifier": "198",
      "name": "Artículo 198",
      "position": 198,
      "text": "La Revocatoria puede ser promovida por no menos del cinco (5) por ciento del padrón electoral\nmunicipal para revocar los mandatos de las autoridades municipales electivas. El número de voluntades debe\nacreditarse de acuerdo a los mecanismos establecidos por la Junta Electoral Municipal  y lograrse en el término de\ntreinta (30)  días corridos  contados a partir de la primera certificación.\nPara que la revocatoria prospere es necesaria la mayoría absoluta de los votos válidos emitidos. La participación del\nelectorado es obligatoria y para su validez debe sufragar no menos del treinta y cinco (35) por ciento del padrón\nelectoral municipal actualizado.\nEl requerimiento de revocatoria de mandato debe estar fundado en las siguientes causas:\n1.     Mal desempeño del cargo o falta grave.\n2.      Comisión de delito en cumplimiento de sus funciones.\nProducida la destitución, cesan en sus funciones automáticamente y son reemplazados de acuerdo al procedimiento\nestablecido en esta Carta Orgánica.\nSi por la revocatoria debe convocarse a elecciones, no pueden ser candidatos las autoridades removidas. Los electos\ncompletan el mandato.\nLas autoridades municipales pueden ser sometidas a este procedimiento luego de transcurrido un  (1) año en el\ndesempeño de sus mandatos y siempre que no faltaren menos de nueve (9) meses para su expiración.\nNo puede intentarse una nueva revocatoria contra la misma autoridad si no mediare por lo menos el término de un\n(1) año entre una y otra.\nLa solicitud de revocatoria se presenta ante la Junta Electoral Municipal  o mediante otros mecanismos que prevea\nla ordenanza. Es fundada y no puede basarse en vicios relativos a la elección de aquellos cuya destitución se\npretende. Presentada la solicitud en debida forma, la Junta Electoral procederá a convocar a elecciones en un plazo\nno mayor de sesenta (60) días.\nLos fundamentos de la solicitud y la eventual respuesta de las autoridades afectadas se hacen públicos junto con la\nconvocatoria al acto eleccionario.\n",
      "co:inicioCaracter": 136280,
      "co:finCaracter": 138299,
      "co:inicioTexto": 136294,
      "co:finTexto": 138299,
      "co:caracteresTexto": 2005,
      "co:marcadorArticulo": "Artículo 198: ",
      "co:encabezadoPrevioLiteral": "###### REVOCATORIA\n",
      "co:inicioEncabezado": 136261,
      "co:finEncabezado": 136280,
      "co:epigrafe": "REVOCATORIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/19"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/10"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/19"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/199",
      "@type": "co:Articulo",
      "identifier": "199",
      "name": "Artículo 199",
      "position": 199,
      "text": "Los Centros Vecinales son  asociaciones del pueblo, libres y  sin fines de lucro,   que            se\nconstituyen  en los barrios de la ciudad de Villa Carlos Paz con el fin de lograr una mejor calidad de vida de los\nvecinos y fortalecer los principios de solidaridad y colaboración.\n\n",
      "co:inicioCaracter": 138390,
      "co:finCaracter": 138689,
      "co:inicioTexto": 138404,
      "co:finTexto": 138689,
      "co:caracteresTexto": 285,
      "co:marcadorArticulo": "Artículo 199: ",
      "co:encabezadoPrevioLiteral": "###### CENTROS VECINALES\n",
      "co:inicioEncabezado": 138365,
      "co:finEncabezado": 138390,
      "co:epigrafe": "CENTROS VECINALES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/200",
      "@type": "co:Articulo",
      "identifier": "200",
      "name": "Artículo 200",
      "position": 200,
      "text": "El Municipio establece el régimen jurídico de los Centros Vecinales y los requisitos exigibles para su\ncreación y reconocimiento, a través del organismo municipal competente, que fiscaliza su actuación. El Concejo de\nRepresentantes dicta las normas necesarias para el funcionamiento institucional y administrativo, en el marco de un\nMunicipio participativo y descentralizado\n\n",
      "co:inicioCaracter": 138711,
      "co:finCaracter": 139101,
      "co:inicioTexto": 138725,
      "co:finTexto": 139101,
      "co:caracteresTexto": 376,
      "co:marcadorArticulo": "Artículo 200: ",
      "co:encabezadoPrevioLiteral": "###### REGLAMENTACIÓN\n",
      "co:inicioEncabezado": 138689,
      "co:finEncabezado": 138711,
      "co:epigrafe": "REGLAMENTACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/201",
      "@type": "co:Articulo",
      "identifier": "201",
      "name": "Artículo 201",
      "position": 201,
      "text": "Una Ordenanza especial crea un Consejo Económico-Social y Laboral, integrado por los cuerpos y\norganizaciones intermedias  empresariales, gremiales y  sindicales. Tal Ordenanza  establece  las funciones y\natribuciones del Consejo y sus relaciones con el Municipio.\n\n",
      "co:inicioCaracter": 139173,
      "co:finCaracter": 139453,
      "co:inicioTexto": 139187,
      "co:finTexto": 139453,
      "co:caracteresTexto": 266,
      "co:marcadorArticulo": "Artículo 201: ",
      "co:encabezadoPrevioLiteral": "###### CONSEJO ECONÓMICO-SOCIAL Y LABORAL  (Ordenanza anterior 3986/02)\n",
      "co:inicioEncabezado": 139101,
      "co:finEncabezado": 139173,
      "co:epigrafe": "CONSEJO ECONÓMICO-SOCIAL Y LABORAL  (Ordenanza anterior 3986/02)",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/202",
      "@type": "co:Articulo",
      "identifier": "202",
      "name": "Artículo 202",
      "position": 202,
      "text": "Los habitantes u organizaciones no gubernamentales, en Audiencia   Pública, proponen a  la\nadministración la adopción de determinadas medidas para satisfacer sus necesidades vecinales o recibir información\nde los actos políticos y administrativos. La Audiencia se realiza en forma verbal, en un solo acto y con temario\nprevio, debiendo  garantizarse amplia publicidad de  la  convocatoria. Puede  ser  solicitada por  habitantes u\norganizaciones no gubernamentales y convocada a instancia del Concejo de Representantes o del Departamento\nEjecutivo. La ordenanza reglamenta su funcionamiento.\n\n\n",
      "co:inicioCaracter": 139478,
      "co:finCaracter": 140086,
      "co:inicioTexto": 139492,
      "co:finTexto": 140086,
      "co:caracteresTexto": 594,
      "co:marcadorArticulo": "Artículo 202: ",
      "co:encabezadoPrevioLiteral": "###### AUDIENCIA PÚBLICA\n",
      "co:inicioEncabezado": 139453,
      "co:finEncabezado": 139478,
      "co:epigrafe": "AUDIENCIA PÚBLICA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/203",
      "@type": "co:Articulo",
      "identifier": "203",
      "name": "Artículo 203",
      "position": 203,
      "text": "Cinco (5) días antes de realizarse cualquier Audiencia Pública, incluidas las previstas en esta Carta\nOrgánica para la sanción de ordenanzas en doble lectura, y habiendo sido formalmente convocadas, se debe poner a\ndisposición de la comunidad la información del tema. Quienes decidan efectuar propuestas, deberán registrarlas y\npresentarlas,  por escrito y con fundamento,  cuarenta y ocho (48) horas antes del día fijado para la realización de\nla Audiencia. En ella sólo se tratarán los temas objeto de la convocatoria. Se labrará un acta en la que constarán las\nopiniones de los participantes, de los  miembros del Concejo de Representantes y/o del Intendente. En el caso de los\nconcejales, estos deberán   fundar sus eventuales negativas al momento de su votación.\n\n",
      "co:inicioCaracter": 140104,
      "co:finCaracter": 140887,
      "co:inicioTexto": 140118,
      "co:finTexto": 140887,
      "co:caracteresTexto": 769,
      "co:marcadorArticulo": "Artículo 203: ",
      "co:encabezadoPrevioLiteral": "###### FORMALIDAD\n",
      "co:inicioEncabezado": 140086,
      "co:finEncabezado": 140104,
      "co:epigrafe": "FORMALIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/204",
      "@type": "co:Articulo",
      "identifier": "204",
      "name": "Artículo 204",
      "position": 204,
      "text": "Durante el período de sesiones ordinarias del Concejo de Representantes, toda institución legalmente\nconstituida o grupo de ciudadanos no inferior a veinte (20) miembros, a través de la persona que designe y que tenga\ndomicilio real en la Ciudad de Villa Carlos Paz, podrán proponer proyectos de interés general o sectorial, por medio\nde la Banca del Ciudadano.\n",
      "co:inicioCaracter": 140914,
      "co:finCaracter": 141290,
      "co:inicioTexto": 140928,
      "co:finTexto": 141290,
      "co:caracteresTexto": 362,
      "co:marcadorArticulo": "Artículo 204: ",
      "co:encabezadoPrevioLiteral": "###### BANCA DEL CIUDADANO\n",
      "co:inicioEncabezado": 140887,
      "co:finEncabezado": 140914,
      "co:epigrafe": "BANCA DEL CIUDADANO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/6"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/11"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/205",
      "@type": "co:Articulo",
      "identifier": "205",
      "name": "Artículo 205",
      "position": 205,
      "text": "El ejercicio del derecho electoral en el Municipio de Villa Carlos Paz se regirá por las disposiciones\nde esta Carta Orgánica, el Código Electoral Municipal,  y demás normas aplicables, subsidiariamente por las leyes\nelectorales y de partidos políticos provinciales y nacionales en vigencia, en la Constitución de la Provincia y en la\nConstitución Nacional.\n\n",
      "co:inicioCaracter": 141504,
      "co:finCaracter": 141877,
      "co:inicioTexto": 141518,
      "co:finTexto": 141877,
      "co:caracteresTexto": 359,
      "co:marcadorArticulo": "Artículo 205: ",
      "co:encabezadoPrevioLiteral": "###### NORMAS APLICABLES\n",
      "co:inicioEncabezado": 141479,
      "co:finEncabezado": 141504,
      "co:epigrafe": "NORMAS APLICABLES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/206",
      "@type": "co:Articulo",
      "identifier": "206",
      "name": "Artículo 206",
      "position": 206,
      "text": "El Cuerpo Electoral Municipal se compone:\n1. De los argentinos mayores de dieciocho (18) años, con domicilio en el Municipio registrado en el documento que\nacredite su identidad.\n2. De los extranjeros mayores de dieciocho (18) años, que tengan dos (2) años de residencia continua e inmediata en\nel Municipio y posean Documento Nacional de Identidad para extranjeros, al tiempo de su inscripción en el Padrón\nCívico Municipal.\n\n",
      "co:inicioCaracter": 141896,
      "co:finCaracter": 142337,
      "co:inicioTexto": 141910,
      "co:finTexto": 142337,
      "co:caracteresTexto": 427,
      "co:marcadorArticulo": "Artículo 206: ",
      "co:encabezadoPrevioLiteral": "###### INTEGRACIÓN\n",
      "co:inicioEncabezado": 141877,
      "co:finEncabezado": 141896,
      "co:epigrafe": "INTEGRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/207",
      "@type": "co:Articulo",
      "identifier": "207",
      "name": "Artículo 207",
      "position": 207,
      "text": "La Junta Electoral Municipal confecciona el padrón electoral municipal de Villa Carlos Paz. Los\nelectores mencionados en el inciso 1) del artículo precedente son los que surgen de citado padrón. Hasta tanto se\nconfeccione, se utiliza el padrón vigente en las últimas elecciones generales debidamente actualizado por la Junta\nElectoral Municipal. Los mencionados en el inciso 2) deben estar inscriptos en el padrón especial para extranjeros\nque a tal efecto confecciona dicha Junta.\n\n",
      "co:inicioCaracter": 142361,
      "co:finCaracter": 142858,
      "co:inicioTexto": 142375,
      "co:finTexto": 142858,
      "co:caracteresTexto": 483,
      "co:marcadorArticulo": "Artículo 207: ",
      "co:encabezadoPrevioLiteral": "###### PADRÓN ELECTORAL\n",
      "co:inicioEncabezado": 142337,
      "co:finEncabezado": 142361,
      "co:epigrafe": "PADRÓN ELECTORAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/208",
      "@type": "co:Articulo",
      "identifier": "208",
      "name": "Artículo 208",
      "position": 208,
      "text": "Se prohíben los mecanismos de sumatoria de votos a través de  boletas de distintas agrupaciones\npolíticas.\n",
      "co:inicioCaracter": 142887,
      "co:finCaracter": 143008,
      "co:inicioTexto": 142901,
      "co:finTexto": 143008,
      "co:caracteresTexto": 107,
      "co:marcadorArticulo": "Artículo 208: ",
      "co:encabezadoPrevioLiteral": "###### DISPOSICIÓN ELECTORAL\n",
      "co:inicioEncabezado": 142858,
      "co:finEncabezado": 142887,
      "co:epigrafe": "DISPOSICIÓN ELECTORAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/20"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/209",
      "@type": "co:Articulo",
      "identifier": "209",
      "name": "Artículo 209",
      "position": 209,
      "text": "La Junta Electoral Municipal es un organismo de carácter permanente. Se compone de tres (3)\nmiembros y se integra con Jueces de 1º instancia, miembros del Ministerio Público y/o Asesores letrados judiciales\nde la Provincia, con asiento en la Ciudad de Villa Carlos Paz. Un convenio entre el Municipio y la Provincia\nestablece los mecanismos para la constitución y funcionamiento de la Junta Electoral Municipal.\n\n",
      "co:inicioCaracter": 143077,
      "co:finCaracter": 143504,
      "co:inicioTexto": 143091,
      "co:finTexto": 143504,
      "co:caracteresTexto": 413,
      "co:marcadorArticulo": "Artículo 209: ",
      "co:encabezadoPrevioLiteral": "###### INTEGRACIÓN\n\n\n",
      "co:inicioEncabezado": 143056,
      "co:finEncabezado": 143077,
      "co:epigrafe": "INTEGRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/210",
      "@type": "co:Articulo",
      "identifier": "210",
      "name": "Artículo 210",
      "position": 210,
      "text": "No pueden ser miembros de  la Junta Electoral Municipal los candidatos a cargos electivos\nmunicipales o quienes tengan con ellos algunos de los vínculos siguientes: ascendientes o descendientes, cónyuge,\nparientes colaterales dentro del segundo grado de consanguinidad o segundo de afinidad; las personas que convivan\ncon ellos y las que por cualquier otro motivo comprometan la imparcialidad de sus funciones.  El miembro\ninvolucrado en una de estas situaciones se aparta temporariamente de sus funciones y es reemplazado.\n\n",
      "co:inicioCaracter": 143530,
      "co:finCaracter": 144070,
      "co:inicioTexto": 143545,
      "co:finTexto": 144070,
      "co:caracteresTexto": 525,
      "co:marcadorArticulo": "Artículo  210: ",
      "co:encabezadoPrevioLiteral": "###### INCOMPATIBILIDADES\n",
      "co:inicioEncabezado": 143504,
      "co:finEncabezado": 143530,
      "co:epigrafe": "INCOMPATIBILIDADES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/211",
      "@type": "co:Articulo",
      "identifier": "211",
      "name": "Artículo 211",
      "position": 211,
      "text": "Son atribuciones y deberes de la Junta Electoral Municipal:\n1. La aplicación de la normativa municipal electoral y la de los partidos políticos.\n2. La convocatoria a elecciones cuando no la hagan las autoridades municipales dentro del plazo legal.\n3. La oficialización y el registro de las listas de candidatos y la aprobación de la boleta electoral.\n4. La organización y dirección de los comicios municipales, ordinarios o extraordinarios; la realización del\nescrutinio definitivo, la aprobación de los resultados y la proclamación de los candidatos electos.\n5.  La resolución de todos los conflictos que se planteen con motivo del acto electoral.\n6. El conocimiento de los casos de excusación o recusación de los miembros integrantes de la Junta Electoral\nMunicipal y la decisión sobre dichos casos.\n7. El requerimiento a las autoridades municipales de los medios necesarios para el cumplimiento de su cometido.\n8. Otorgar la personería a las agrupaciones políticas municipales con arreglo a lo establecido en esta Carta Orgánica,\ny llevar un registro actualizado de tales agrupaciones.\n9. Confeccionar, actualizar y depurar el padrón electoral municipal.\n10. Gestionar los medios para que los ciudadanos que ejerzan los derechos políticos de iniciativa, referéndum o\nrevocatoria, cuenten con un procedimiento que asegure  la legalidad, legitimidad, transparencia, gratuidad y\naccesibilidad en el ejercicio de aquéllos, habilitando como mínimo (10) diez lugares públicos que permitan una justa\ndistribución geográfica a los efectos de garantizar al ciudadano el principio de accesibilidad, en los cuales los\nelectores pueden refrendar la solicitud de los derechos políticos arriba mencionados, quedando en ese mismo acto\nautentificada su firma por aquellos agentes oficiales designados por la Junta Electoral Municipal.\n11. Justificar el incumplimiento del deber de votar.\n12. Todas las otras funciones que establece esta Carta Orgánica y el Código Electoral Municipal.\nLa Junta Electoral Municipal cuenta con la colaboración del Registro Civil de la Ciudad, de acuerdo a lo que\nestablezca el Código Electoral  y las Ordenanzas que en su consecuencia se dictan.\n\n",
      "co:inicioCaracter": 144100,
      "co:finCaracter": 146279,
      "co:inicioTexto": 144114,
      "co:finTexto": 146279,
      "co:caracteresTexto": 2165,
      "co:marcadorArticulo": "Artículo 211: ",
      "co:encabezadoPrevioLiteral": "###### ATRIBUCIONES Y DEBERES\n",
      "co:inicioEncabezado": 144070,
      "co:finEncabezado": 144100,
      "co:epigrafe": "ATRIBUCIONES Y DEBERES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/212",
      "@type": "co:Articulo",
      "identifier": "212",
      "name": "Artículo 212",
      "position": 212,
      "text": "Los electores, candidatos y apoderados de los partidos políticos pueden interponer recurso de\nreconsideración contra las resoluciones de la Junta Electoral Municipal, el que debe ser deducido dentro de las\nveinticuatro (24) horas de la notificación del acto impugnado. Denegado el recurso, procede la apelación ante el\nJuez Electoral Provincial, que debe ser interpuesta dentro del plazo de cuarenta y ocho (48) horas a contar desde la\nnotificación de la denegación. La Junta Electoral Municipal debe elevarle inmediatamente un informe de la\nresolución recurrida, junto con las actuaciones, documentos y demás antecedentes del caso.\n\n",
      "co:inicioCaracter": 146295,
      "co:finCaracter": 146943,
      "co:inicioTexto": 146309,
      "co:finTexto": 146943,
      "co:caracteresTexto": 634,
      "co:marcadorArticulo": "Artículo 212: ",
      "co:encabezadoPrevioLiteral": "###### RECURSOS\n",
      "co:inicioEncabezado": 146279,
      "co:finEncabezado": 146295,
      "co:epigrafe": "RECURSOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/213",
      "@type": "co:Articulo",
      "identifier": "213",
      "name": "Artículo 213",
      "position": 213,
      "text": "El Código Electoral Municipal reglamenta el funcionamiento de la Junta Electoral Municipal.\n",
      "co:inicioCaracter": 146965,
      "co:finCaracter": 147071,
      "co:inicioTexto": 146979,
      "co:finTexto": 147071,
      "co:caracteresTexto": 92,
      "co:marcadorArticulo": "Artículo 213: ",
      "co:encabezadoPrevioLiteral": "###### FUNCIONAMIENTO\n",
      "co:inicioEncabezado": 146943,
      "co:finEncabezado": 146965,
      "co:epigrafe": "FUNCIONAMIENTO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/21"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/214",
      "@type": "co:Articulo",
      "identifier": "214",
      "name": "Artículo 214",
      "position": 214,
      "text": "El candidato a Intendente Municipal no puede ser simultáneamente candidato a  Concejal ni a\nmiembro del Tribunal de Cuentas.\n\n",
      "co:inicioCaracter": 147139,
      "co:finCaracter": 147279,
      "co:inicioTexto": 147153,
      "co:finTexto": 147279,
      "co:caracteresTexto": 126,
      "co:marcadorArticulo": "Artículo 214: ",
      "co:encabezadoPrevioLiteral": "###### CANDIDATURA A INTENDENTE\n",
      "co:inicioEncabezado": 147107,
      "co:finEncabezado": 147139,
      "co:epigrafe": "CANDIDATURA A INTENDENTE",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/215",
      "@type": "co:Articulo",
      "identifier": "215",
      "name": "Artículo 215",
      "position": 215,
      "text": "Las  listas de Concejales, miembros del Tribunal de Cuentas y Convencionales Constituyentes\n\n\nMunicipales deben estar integradas por un cincuenta por ciento (50%) de cada género. Las listas no pueden contener\ndos candidatos consecutivos de un mismo género.\n\n",
      "co:inicioCaracter": 147306,
      "co:finCaracter": 147578,
      "co:inicioTexto": 147320,
      "co:finTexto": 147578,
      "co:caracteresTexto": 258,
      "co:marcadorArticulo": "Artículo 215: ",
      "co:encabezadoPrevioLiteral": "###### LISTA DE CANDIDATOS\n",
      "co:inicioEncabezado": 147279,
      "co:finEncabezado": 147306,
      "co:epigrafe": "LISTA DE CANDIDATOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/216",
      "@type": "co:Articulo",
      "identifier": "216",
      "name": "Artículo 216",
      "position": 216,
      "text": "Toda agrupación política que intervenga en la elección debe proclamar y registrar, juntamente con la\nnómina de candidatos a Concejales y miembros del Tribunal de Cuentas titulares, una lista de igual cantidad de\nsuplentes para todos los cargos. Es obligatorio presentar listas de candidatos para todas las categorías de cargos.\n\n",
      "co:inicioCaracter": 147597,
      "co:finCaracter": 147940,
      "co:inicioTexto": 147611,
      "co:finTexto": 147940,
      "co:caracteresTexto": 329,
      "co:marcadorArticulo": "Artículo 216: ",
      "co:encabezadoPrevioLiteral": "###### INTEGRACIÓN\n",
      "co:inicioEncabezado": 147578,
      "co:finEncabezado": 147597,
      "co:epigrafe": "INTEGRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/217",
      "@type": "co:Articulo",
      "identifier": "217",
      "name": "Artículo 217",
      "position": 217,
      "text": "Para cubrir las vacantes que se producen, ingresan primero y por el orden de la lista los candidatos\ntitulares del partido que corresponda que no hubiesen sido incorporados y, luego de ellos, los suplentes proclamados\ncomo tales que les sigan en el orden. Se respeta el género y los que ingresan completan el mandato del titular.\n",
      "co:inicioCaracter": 147969,
      "co:finCaracter": 148313,
      "co:inicioTexto": 147983,
      "co:finTexto": 148313,
      "co:caracteresTexto": 330,
      "co:marcadorArticulo": "Artículo 217: ",
      "co:encabezadoPrevioLiteral": "###### COBERTURA DE VACANTES\n",
      "co:inicioEncabezado": 147940,
      "co:finEncabezado": 147969,
      "co:epigrafe": "COBERTURA DE VACANTES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/22"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/218",
      "@type": "co:Articulo",
      "identifier": "218",
      "name": "Artículo 218",
      "position": 218,
      "text": "La distribución de las bancas en el Concejo de Representantes se efectúa de la siguiente manera:\n1. Participan las listas que logren un mínimo del tres (3) por ciento de los votos emitidos.\n2. Con las listas que hayan alcanzado el mínimo establecido en el inciso anterior se sigue el siguiente procedimiento:\nEl total de los votos obtenidos por cada lista se divide por uno, por dos, por tres, y así sucesivamente, hasta llegar al\nnúmero total de cargos a distribuir.\nLos cocientes resultantes, con independencia de la lista de que provengan, son ordenados de mayor a menor en igual\nnúmero de los  cargos a cubrir.\nSi hubiere dos o más cocientes iguales, se los ordena en relación directa con el total de los votos obtenidos por las\nrespectivas listas y si éstas hubiesen logrado igual número de votos el ordenamiento resulta de un sorteo público que\na tal fin debe practicar la Junta Electoral Municipal.\nA cada lista le corresponden tantos cargos como veces sus cocientes figuren en el ordenamiento arriba indicado.\n\n",
      "co:inicioCaracter": 148397,
      "co:finCaracter": 149430,
      "co:inicioTexto": 148411,
      "co:finTexto": 149430,
      "co:caracteresTexto": 1019,
      "co:marcadorArticulo": "Artículo 218: ",
      "co:encabezadoPrevioLiteral": "###### SISTEMA ELECTORAL\n",
      "co:inicioEncabezado": 148372,
      "co:finEncabezado": 148397,
      "co:epigrafe": "SISTEMA ELECTORAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/23"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/23"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/219",
      "@type": "co:Articulo",
      "identifier": "219",
      "name": "Artículo 219",
      "position": 219,
      "text": "Si de la aplicación del sistema descripto surge que el partido que ha obtenido mayoría de votos no\nllega a ocupar más de la mitad de las bancas, se observa el siguiente procedimiento:\n1)   Corresponden  al partido que obtenga mayor cantidad de votos  tantas bancas como  el número entero\ninmediatamente superior a la mitad aritmética del total de bancas.\n2)  Las bancas restantes se distribuyen entre los otros partidos que hayan alcanzado el mínimo previsto en el inciso\n1 del artículo 218, conforme con el procedimiento descripto en el inciso 2 del citado artículo.\n3)  Si ninguno de los partidos de la minoría hubiere alcanzado el porcentaje mínimo previsto en el inciso 1 del\nartículo 218, le corresponde una banca al partido que siga, en cantidad de votos, al que haya obtenido la mayoría.\n",
      "co:inicioCaracter": 149460,
      "co:finCaracter": 150269,
      "co:inicioTexto": 149474,
      "co:finTexto": 150269,
      "co:caracteresTexto": 795,
      "co:marcadorArticulo": "Artículo 219: ",
      "co:encabezadoPrevioLiteral": "###### ASIGNACIÓN DE MAYORÍAS\n",
      "co:inicioEncabezado": 149430,
      "co:finEncabezado": 149460,
      "co:epigrafe": "ASIGNACIÓN DE MAYORÍAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/23"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/23"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/220",
      "@type": "co:Articulo",
      "identifier": "220",
      "name": "Artículo 220",
      "position": 220,
      "text": "Las elecciones ordinarias para la renovación del Concejo de Representantes y del Intendente se\nrealizan el último domingo de Junio del año correspondiente, efectuándose la transmisión del mando y la asunción\nde los electos el segundo domingo de Agosto siguiente. La elección del Defensor del Pueblo y del Defensor del\nPueblo Adjunto se realiza el último domingo de Junio correspondiente a la mitad del período de aquéllos y su\nasunción el siguiente segundo domingo de Agosto. Las elecciones extraordinarias se efectúan el día establecido en\nla convocatoria.\n\n",
      "co:inicioCaracter": 150315,
      "co:finCaracter": 150888,
      "co:inicioTexto": 150329,
      "co:finTexto": 150888,
      "co:caracteresTexto": 559,
      "co:marcadorArticulo": "Artículo 220: ",
      "co:encabezadoPrevioLiteral": "###### FECHAS\n",
      "co:inicioEncabezado": 150301,
      "co:finEncabezado": 150315,
      "co:epigrafe": "FECHAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/24"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/24"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/221",
      "@type": "co:Articulo",
      "identifier": "221",
      "name": "Artículo 221",
      "position": 221,
      "text": "El decreto de convocatoria a toda elección municipal debe dictarse con una antelación mínima de\nnoventa (90) días previos a la fecha establecida.\n\n",
      "co:inicioCaracter": 150919,
      "co:finCaracter": 151081,
      "co:inicioTexto": 150934,
      "co:finTexto": 151081,
      "co:caracteresTexto": 147,
      "co:marcadorArticulo": "Artículo  221: ",
      "co:encabezadoPrevioLiteral": "###### DECRETO DE CONVOCATORIA\n",
      "co:inicioEncabezado": 150888,
      "co:finEncabezado": 150919,
      "co:epigrafe": "DECRETO DE CONVOCATORIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/24"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/24"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/222",
      "@type": "co:Articulo",
      "identifier": "222",
      "name": "Artículo 222",
      "position": 222,
      "text": "Son de aplicación supletoria del Código Electoral Municipal, las leyes y códigos de la Provincia de\nCórdoba y de la Nación, en ese orden.\n",
      "co:inicioCaracter": 151102,
      "co:finCaracter": 151254,
      "co:inicioTexto": 151116,
      "co:finTexto": 151254,
      "co:caracteresTexto": 138,
      "co:marcadorArticulo": "Artículo 222: ",
      "co:encabezadoPrevioLiteral": "###### SUPLETORIEDAD\n",
      "co:inicioEncabezado": 151081,
      "co:finEncabezado": 151102,
      "co:epigrafe": "SUPLETORIEDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/24"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/12"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/24"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/223",
      "@type": "co:Articulo",
      "identifier": "223",
      "name": "Artículo 223",
      "position": 223,
      "text": "Los partidos políticos con personería reconocida en el orden nacional, provincial o municipal, vigente\nal momento de la convocatoria a elecciones municipales, son reconocidos por la Junta Electoral Municipal, con solo\nacreditar tal circunstancia.\n\n",
      "co:inicioCaracter": 151318,
      "co:finCaracter": 151580,
      "co:inicioTexto": 151332,
      "co:finTexto": 151580,
      "co:caracteresTexto": 248,
      "co:marcadorArticulo": "Artículo 223: ",
      "co:encabezadoPrevioLiteral": "###### PERSONERÍA\n",
      "co:inicioEncabezado": 151300,
      "co:finEncabezado": 151318,
      "co:epigrafe": "PERSONERÍA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/224",
      "@type": "co:Articulo",
      "identifier": "224",
      "name": "Artículo 224",
      "position": 224,
      "text": "La personería política municipal es otorgada por la Junta Electoral Municipal a las agrupaciones que\nlo soliciten y que reúnan los siguientes requisitos:\n1) Acta de constitución y denominación de la agrupación.\n2) Acreditar un número de afiliados superior al uno (1) por ciento del padrón electoral municipal.\n3) Declaración de principios.\n4) Estatuto que obligue a una pública rendición de cuentas sobre el origen y destino de los fondos partidarios y\nasegure una organización interna democrática.\nActúan supletoriamente las leyes de partidos políticos provinciales y nacionales, en ese orden.\n\n",
      "co:inicioCaracter": 151598,
      "co:finCaracter": 152208,
      "co:inicioTexto": 151612,
      "co:finTexto": 152208,
      "co:caracteresTexto": 596,
      "co:marcadorArticulo": "Artículo 224: ",
      "co:encabezadoPrevioLiteral": "###### REQUISITOS\n",
      "co:inicioEncabezado": 151580,
      "co:finEncabezado": 151598,
      "co:epigrafe": "REQUISITOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/225",
      "@type": "co:Articulo",
      "identifier": "225",
      "name": "Artículo 225",
      "position": 225,
      "text": "Los partidos políticos que participan en elecciones municipales deben dar a publicidad todos los\ngastos de campaña dentro de los treinta (30) días posteriores a los comicios  y presentar un informe a la Junta\nElectoral Municipal, cuyo acceso debe ser público.\n\n",
      "co:inicioCaracter": 152246,
      "co:finCaracter": 152521,
      "co:inicioTexto": 152260,
      "co:finTexto": 152521,
      "co:caracteresTexto": 261,
      "co:marcadorArticulo": "Artículo 225: ",
      "co:encabezadoPrevioLiteral": "###### FINANCIAMIENTO DE LAS CAMPAÑAS\n",
      "co:inicioEncabezado": 152208,
      "co:finEncabezado": 152246,
      "co:epigrafe": "FINANCIAMIENTO DE LAS CAMPAÑAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/226",
      "@type": "co:Articulo",
      "identifier": "226",
      "name": "Artículo 226",
      "position": 226,
      "text": "Una vez acreditado el total de los requisitos por parte de las agrupaciones políticas que solicitan\nreconocimiento, la Junta Electoral Municipal debe cumplir los trámites que fija el Código Electoral Municipal y\nresolver la solicitud en un plazo máximo de treinta (30) días hábiles. La falta de resolución en tal plazo otorga\nautomáticamente la personería a la agrupación política solicitante.\n\n",
      "co:inicioCaracter": 152536,
      "co:finCaracter": 152945,
      "co:inicioTexto": 152550,
      "co:finTexto": 152945,
      "co:caracteresTexto": 395,
      "co:marcadorArticulo": "Artículo 226: ",
      "co:encabezadoPrevioLiteral": "###### TRÁMITE\n",
      "co:inicioEncabezado": 152521,
      "co:finEncabezado": 152536,
      "co:epigrafe": "TRÁMITE",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/227",
      "@type": "co:Articulo",
      "identifier": "227",
      "name": "Artículo 227",
      "position": 227,
      "text": "Los partidos  políticos que intervienen en elecciones ordinarias de renovación de autoridades\nmunicipales, deben presentar, junto con las listas de candidatos, una síntesis de su programa de gobierno, que deberá\nser publicada por la Junta Electoral en medios de comunicación masivos de la Ciudad. Esta publicación se reitera\ntres (3) meses antes de la finalización de los mandatos, pero limitada a los partidos políticos que hubieren tenido\nrepresentación en el Concejo de Representantes o el Tribunal de Cuentas.\n\n",
      "co:inicioCaracter": 152973,
      "co:finCaracter": 153502,
      "co:inicioTexto": 152987,
      "co:finTexto": 153502,
      "co:caracteresTexto": 515,
      "co:marcadorArticulo": "Artículo 227: ",
      "co:encabezadoPrevioLiteral": "###### PROGRAMA DE GOBIERNO\n",
      "co:inicioEncabezado": 152945,
      "co:finEncabezado": 152973,
      "co:epigrafe": "PROGRAMA DE GOBIERNO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/228",
      "@type": "co:Articulo",
      "identifier": "228",
      "name": "Artículo 228",
      "position": 228,
      "text": "Una Ordenanza especial crea el Consejo de Partidos Políticos, integrado con delegados titulares y\nsuplentes de los partidos políticos que participaron, por sí solos o en alianzas electorales, en los últimos comicios\nmunicipales.\n\n",
      "co:inicioCaracter": 153572,
      "co:finCaracter": 153816,
      "co:inicioTexto": 153586,
      "co:finTexto": 153816,
      "co:caracteresTexto": 230,
      "co:marcadorArticulo": "Artículo 228: ",
      "co:encabezadoPrevioLiteral": "###### CONSEJO DE PARTIDOS POLÍTICOS  Reglamentado por Ordenanza 4928\n",
      "co:inicioEncabezado": 153502,
      "co:finEncabezado": 153572,
      "co:epigrafe": "CONSEJO DE PARTIDOS POLÍTICOS  Reglamentado por Ordenanza 4928",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/229",
      "@type": "co:Articulo",
      "identifier": "229",
      "name": "Artículo 229",
      "position": 229,
      "text": "Son funciones y atribuciones del Consejo de Partidos Políticos:\n1)      Crear su reglamento de funcionamiento, con los requisitos y limitaciones que fije la Ordenanza.\n2)      Asesorar sobre cualquier tema a solicitud del Concejo de Representantes, Departamento Ejecutivo o Junta\nElectoral Municipal.\n3)      Elevar opiniones, sugerencias y/o solicitudes a cualquier organismo político municipal.\nEl Concejo de Representantes debe enviar al Consejo de Partidos Políticos, con la mayor antelación posible a su\ntratamiento, copia de los proyectos de ordenanza que de alguna manera afecten o involucren a los Partidos Políticos.\n",
      "co:inicioCaracter": 153848,
      "co:finCaracter": 154488,
      "co:inicioTexto": 153862,
      "co:finTexto": 154488,
      "co:caracteresTexto": 626,
      "co:marcadorArticulo": "Artículo 229: ",
      "co:encabezadoPrevioLiteral": "###### FUNCIONES Y ATRIBUCIONES\n",
      "co:inicioEncabezado": 153816,
      "co:finEncabezado": 153848,
      "co:epigrafe": "FUNCIONES Y ATRIBUCIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/3"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/titulo/7"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/seccion/13"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/230",
      "@type": "co:Articulo",
      "identifier": "230",
      "name": "Artículo 230",
      "position": 230,
      "text": "Esta Carta Orgánica puede ser reformada, total o parcialmente, por una Convención convocada al\nefecto. La necesidad de la reforma debe ser declarada en Ordenanza del Concejo de Representantes por mayoría\nextraordinaria durante los primeros cinco (5) años de vigencia de esta Carta Orgánica, y por mayoría agravada\nposteriormente. Esta Ordenanza especifica los puntos a reformar y debe ser tratada en doble lectura, no pudiendo ser\nel plazo entre la primera y segunda lectura menor a sesenta (60) días corridos. Durante este período, es obligación\ndel Concejo de Representantes publicar con la mayor difusión las motivaciones de la necesidad de la reforma y la\nrealización de la mayor cantidad posible de audiencias con todos los sectores intermedios de la población. La\nOrdenanza que declara la necesidad de la reforma no puede ser vetada por el Departamento Ejecutivo.\n\n",
      "co:inicioCaracter": 154591,
      "co:finCaracter": 155476,
      "co:inicioTexto": 154605,
      "co:finTexto": 155476,
      "co:caracteresTexto": 871,
      "co:marcadorArticulo": "Artículo 230: ",
      "co:encabezadoPrevioLiteral": "###### REQUISITOS\n",
      "co:inicioEncabezado": 154573,
      "co:finEncabezado": 154591,
      "co:epigrafe": "REQUISITOS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/231",
      "@type": "co:Articulo",
      "identifier": "231",
      "name": "Artículo 231",
      "position": 231,
      "text": "Promulgada la Ordenanza, el Intendente convoca a elecciones de Convencionales Constituyentes\nMunicipales. Dicha convocatoria debe especificar:\n1)       Si la reforma es total o parcial y, en este último caso, establecerá los artículos que podrán ser motivo de\nreforma.\n2)     La fecha del acto electoral, que no puede coincidir con cualquier otra elección nacional, provincial o\nmunicipal. Dicha elección debe realizarse dentro de los sesenta (60) días posteriores a la promulgación de la\nOrdenanza de reforma.\n3)     La partida presupuestaria para los gastos de funcionamiento de la Convención.\n4)      El plazo en el que deberá expedirse la Convención, que en ningún caso puede ser superior a ciento ochenta\n(180) días.\n\n",
      "co:inicioCaracter": 155496,
      "co:finCaracter": 156233,
      "co:inicioTexto": 155510,
      "co:finTexto": 156233,
      "co:caracteresTexto": 723,
      "co:marcadorArticulo": "Artículo 231: ",
      "co:encabezadoPrevioLiteral": "###### CONVOCATORIA\n",
      "co:inicioEncabezado": 155476,
      "co:finEncabezado": 155496,
      "co:epigrafe": "CONVOCATORIA",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/232",
      "@type": "co:Articulo",
      "identifier": "232",
      "name": "Artículo 232",
      "position": 232,
      "text": "La Convención Municipal  para  la reforma  se compone de un número de Convencionales\nConstituyentes igual al doble de los miembros del Concejo de Representantes.\n\n",
      "co:inicioCaracter": 156252,
      "co:finCaracter": 156429,
      "co:inicioTexto": 156266,
      "co:finTexto": 156429,
      "co:caracteresTexto": 163,
      "co:marcadorArticulo": "Artículo 232: ",
      "co:encabezadoPrevioLiteral": "###### INTEGRACIÓN\n",
      "co:inicioEncabezado": 156233,
      "co:finEncabezado": 156252,
      "co:epigrafe": "INTEGRACIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/233",
      "@type": "co:Articulo",
      "identifier": "233",
      "name": "Artículo 233",
      "position": 233,
      "text": "Los partidos políticos reconocidos en la Junta Electoral Municipal presentan una lista de candidatos\ntitulares igual al  número total de convencionales a elegir, y un número de suplentes igual a la mitad del número\ntotal. La incorporación a la Convención se hace por el sistema D'Hondt, con todas las listas que hubieren obtenido\nun mínimo del dos (2) por ciento del total de votos emitidos.\n\n",
      "co:inicioCaracter": 156464,
      "co:finCaracter": 156871,
      "co:inicioTexto": 156478,
      "co:finTexto": 156871,
      "co:caracteresTexto": 393,
      "co:marcadorArticulo": "Artículo 233: ",
      "co:encabezadoPrevioLiteral": "###### REPRESENTACIÓN PROPORCIONAL\n",
      "co:inicioEncabezado": 156429,
      "co:finEncabezado": 156464,
      "co:epigrafe": "REPRESENTACIÓN PROPORCIONAL",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/234",
      "@type": "co:Articulo",
      "identifier": "234",
      "name": "Artículo 234",
      "position": 234,
      "text": "Para ser Convencional municipal rigen los mismos requisitos, inhabilidades e incompatibilidades\nestablecidas en esta Carta Orgánica para ser Concejal.\n",
      "co:inicioCaracter": 156906,
      "co:finCaracter": 157071,
      "co:inicioTexto": 156920,
      "co:finTexto": 157071,
      "co:caracteresTexto": 151,
      "co:marcadorArticulo": "Artículo 234: ",
      "co:encabezadoPrevioLiteral": "###### CONDICIONES DE ELEGIBILIDAD\n",
      "co:inicioEncabezado": 156871,
      "co:finEncabezado": 156906,
      "co:epigrafe": "CONDICIONES DE ELEGIBILIDAD",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/25"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/235",
      "@type": "co:Articulo",
      "identifier": "235",
      "name": "Artículo 235",
      "position": 235,
      "text": "La reforma de hasta dos artículos de esta Carta Orgánica puede ser producida por Ordenanza de\nEnmienda, dictada por el Concejo de Representantes con mayoría extraordinaria. Esta Ordenanza no puede ser\nvetada por el Departamento Ejecutivo.\n\n",
      "co:inicioCaracter": 157132,
      "co:finCaracter": 157386,
      "co:inicioTexto": 157146,
      "co:finTexto": 157386,
      "co:caracteresTexto": 240,
      "co:marcadorArticulo": "Artículo 235: ",
      "co:encabezadoPrevioLiteral": "###### CONDICIONES\n",
      "co:inicioEncabezado": 157113,
      "co:finEncabezado": 157132,
      "co:epigrafe": "CONDICIONES",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/236",
      "@type": "co:Articulo",
      "identifier": "236",
      "name": "Artículo 236",
      "position": 236,
      "text": "La Reforma por Enmienda adquiere validez y vigencia si recibe el voto afirmativo de la mayoría\nabsoluta de los sufragios válidamente emitidos en un Referéndum Popular obligatorio, que debe ser realizado dentro\nde los noventa (90) días posteriores a la aprobación de la Ordenanza de Enmienda.\n\n",
      "co:inicioCaracter": 157416,
      "co:finCaracter": 157723,
      "co:inicioTexto": 157430,
      "co:finTexto": 157723,
      "co:caracteresTexto": 293,
      "co:marcadorArticulo": "Artículo 236: ",
      "co:encabezadoPrevioLiteral": "###### REFERÉNDUM OBLIGATORIO\n",
      "co:inicioEncabezado": 157386,
      "co:finEncabezado": 157416,
      "co:epigrafe": "REFERÉNDUM OBLIGATORIO",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/237",
      "@type": "co:Articulo",
      "identifier": "237",
      "name": "Artículo 237",
      "position": 237,
      "text": "No pueden aprobarse Ordenanzas de Enmiendas sin que medie un intervalo mínimo de dos (2) años\n\n\nentre una y otra, salvo que una circunstancia excepcional, así calificada por mayoría extraordinaria del Concejo de\nRepresentantes  obligue a una urgencia en la reforma.\n\n",
      "co:inicioCaracter": 157752,
      "co:finCaracter": 158033,
      "co:inicioTexto": 157766,
      "co:finTexto": 158033,
      "co:caracteresTexto": 267,
      "co:marcadorArticulo": "Artículo 237: ",
      "co:encabezadoPrevioLiteral": "###### PLAZO ENTRE ENMIENDAS\n",
      "co:inicioEncabezado": 157723,
      "co:finEncabezado": 157752,
      "co:epigrafe": "PLAZO ENTRE ENMIENDAS",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
        }
      ]
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/articulo/238",
      "@type": "co:Articulo",
      "identifier": "238",
      "name": "Artículo 238",
      "position": 238,
      "text": "No pueden someterse a reforma por enmienda las siguientes partes de esta Carta Orgánica:\na)      El Preámbulo.\nb)     La declaración de principios, derechos y deberes.\nc)      Los artículos de esta Sección de la Carta Orgánica.\n\n",
      "co:inicioCaracter": 158052,
      "co:finCaracter": 158295,
      "co:inicioTexto": 158066,
      "co:finTexto": 158295,
      "co:caracteresTexto": 229,
      "co:marcadorArticulo": "Artículo 238: ",
      "co:encabezadoPrevioLiteral": "###### PROHIBICIÓN\n",
      "co:inicioEncabezado": 158033,
      "co:finEncabezado": 158052,
      "co:epigrafe": "PROHIBICIÓN",
      "isPartOf": {
        "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
      },
      "co:jerarquia": [
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/parte/4"
        },
        {
          "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/capitulo/26"
        }
      ]
    }
  ],
  "co:disposicionesComplementarias": [
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-complementaria/1",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-complementaria",
      "name": "PRIMERA",
      "position": 1,
      "text": "En caso de producirse una reforma de la Constitución de la Provincia de Córdoba que abarque artículos\nreferidos al régimen municipal, deberá convocarse a reforma de la Carta Orgánica Municipal para su adecuación a\nlas nuevas normas, dentro de los seis (6) meses posteriores a la Reforma provincial.\n\n",
      "co:inicioCaracter": 158329,
      "co:finCaracter": 158638,
      "co:marcadorDisposicion": "PRIMERA: ",
      "co:caracteresTexto": 300
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-complementaria/2",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-complementaria",
      "name": "SEGUNDA",
      "position": 2,
      "text": "A partir de la entrada en vigencia de esta Carta Orgánica no es aplicable para la Ciudad de Villa Carlos\nPaz la Ley Nº 8102, salvo en los aspectos no contemplados en esta Carta Orgánica y en los que actúe como\nlegislación supletoria. Las ordenanzas existentes que se opongan a la letra y el espíritu de esta Carta Orgánica\ndeberán ser reformadas o derogadas, sin perjuicio de los derechos adquiridos.\n\n",
      "co:inicioCaracter": 158638,
      "co:finCaracter": 159049,
      "co:marcadorDisposicion": "SEGUNDA: ",
      "co:caracteresTexto": 402
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-complementaria/3",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-complementaria",
      "name": "TERCERA",
      "position": 3,
      "text": "Los plazos establecidos en esta Carta Orgánica se interpretan como días corridos, salvo que se disponga\nexpresamente que son días hábiles administrativos.\n\n",
      "co:inicioCaracter": 159049,
      "co:finCaracter": 159214,
      "co:marcadorDisposicion": "TERCERA: ",
      "co:caracteresTexto": 156
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-complementaria/4",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-complementaria",
      "name": "CUARTA",
      "position": 4,
      "text": "Cuando el cómputo de los dos tercios (2/3) o cuatro quintos (4/5) arroje una fracción, se estará al número\nentero siguiente si ella supera los cincuenta centésimos (0,50); si no superare esa cifra, se computará como dos\ntercios (2/3) o cuatro quintos (4/5) al número entero inferior.\n\n",
      "co:inicioCaracter": 159214,
      "co:finCaracter": 159507,
      "co:marcadorDisposicion": "CUARTA: ",
      "co:caracteresTexto": 285
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-complementaria/5",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-complementaria",
      "name": "QUINTA",
      "position": 5,
      "text": "Todas las acciones u omisiones de los funcionarios municipales, electos o no, que en esta Carta Orgánica\nhan sido calificadas como falta grave o seria irregularidad son consideradas como mal desempeño del cargo y como\ntal son causa suficiente para iniciar el Juicio Político o la Revocatoria del mandato.\n\n",
      "co:inicioCaracter": 159507,
      "co:finCaracter": 159821,
      "co:marcadorDisposicion": "QUINTA: ",
      "co:caracteresTexto": 306
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-complementaria/6",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-complementaria",
      "name": "SEXTA",
      "position": 6,
      "text": "Se establece el 27 de noviembre como día de la Carta Orgánica Municipal.\n\n",
      "co:inicioCaracter": 159821,
      "co:finCaracter": 159902,
      "co:marcadorDisposicion": "SEXTA: ",
      "co:caracteresTexto": 74
    }
  ],
  "co:disposicionesTransitorias": [
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/1",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "PRIMERA",
      "position": 1,
      "text": "Esta Carta Orgánica entra en vigencia inmediatamente después de su sanción y promulgación. Los\nmiembros de la Convención Constituyente juran inmediatamente después de su sanción. De la misma manera\nprestarán juramento las autoridades electas.\n\n",
      "co:inicioCaracter": 159933,
      "co:finCaracter": 160186,
      "co:marcadorDisposicion": "PRIMERA: ",
      "co:caracteresTexto": 244
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/2",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "SEGUNDA",
      "position": 2,
      "text": "Todos los Códigos, Ordenanzas o Reglamentos que esta Carta Orgánica ordena dictar, deberán ser\npromulgados  durante el primer año de vigencia, excepto cuando aquella establezca plazos diferentes.\n\n",
      "co:inicioCaracter": 160186,
      "co:finCaracter": 160392,
      "co:marcadorDisposicion": "SEGUNDA: ",
      "co:caracteresTexto": 197
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/3",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "TERCERA",
      "position": 3,
      "text": "La reconducción selectiva del presupuesto establecida en el artículo 91 resultará aplicable a partir del 1\nde enero de 2009.\n\n",
      "co:inicioCaracter": 160392,
      "co:finCaracter": 160527,
      "co:marcadorDisposicion": "TERCERA: ",
      "co:caracteresTexto": 126
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/4",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "CUARTA",
      "position": 4,
      "text": "La ordenanza de presupuesto participativo deberá ser sancionada antes del 1 de junio de 2008.\n\n",
      "co:inicioCaracter": 160527,
      "co:finCaracter": 160630,
      "co:marcadorDisposicion": "CUARTA: ",
      "co:caracteresTexto": 95
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/5",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "QUINTA",
      "position": 5,
      "text": "Dentro del año posterior a la aprobación de la presente, el Concejo de Representantes debe convocar a la\nelaboración del Plan Estratégico de Desarrollo.\n\n",
      "co:inicioCaracter": 160630,
      "co:finCaracter": 160792,
      "co:marcadorDisposicion": "QUINTA: ",
      "co:caracteresTexto": 154
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/6",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "SEXTA",
      "position": 6,
      "text": "Hasta tanto se dicten las ordenanzas reglamentarias de esta Carta Orgánica, subsisten los actuales\nregímenes legales, en tanto sean compatibles con ella.\n\n",
      "co:inicioCaracter": 160792,
      "co:finCaracter": 160954,
      "co:marcadorDisposicion": "SEXTA: ",
      "co:caracteresTexto": 155
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/7",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "SÉPTIMA",
      "position": 7,
      "text": "La primera elección del Defensor del Pueblo se realizará en el mes de Octubre de 2008, debiendo asumir\nantes de la finalización de ese año. Su mandato dura hasta el segundo domingo de Agosto del año  2013.\n\n\n",
      "co:inicioCaracter": 160954,
      "co:finCaracter": 161171,
      "co:marcadorDisposicion": "SÉPTIMA: ",
      "co:caracteresTexto": 208
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/8",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "OCTAVA",
      "position": 8,
      "text": "El llamado a elección para el próximo período electoral, posterior al de Diciembre 2007 a Diciembre\n2011, deberá expresar que los mandatos se extenderán de Diciembre de 2011 al segundo domingo de Agosto de\n2015.\n\n",
      "co:inicioCaracter": 161171,
      "co:finCaracter": 161392,
      "co:marcadorDisposicion": "OCTAVA: ",
      "co:caracteresTexto": 213
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/9",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "NOVENA",
      "position": 9,
      "text": "Los mandatos de los Concejales, Intendente y Miembros del Tribunal de Cuentas del período 2003-2007\nson  considerados como primer período a los fines de la reelección.\n\n",
      "co:inicioCaracter": 161392,
      "co:finCaracter": 161569,
      "co:marcadorDisposicion": "NOVENA: ",
      "co:caracteresTexto": 169
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/10",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "DÉCIMA",
      "position": 10,
      "text": "Facúltase a la Presidencia de esta Convención Constituyente Municipal a ejecutar actos administrativos\npropios de este Cuerpo, con posterioridad al día 27 de Noviembre de 2007.\n\n",
      "co:inicioCaracter": 161569,
      "co:finCaracter": 161755,
      "co:marcadorDisposicion": "DÉCIMA: ",
      "co:caracteresTexto": 178
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/11",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "DECIMOPRIMERA",
      "position": 11,
      "text": "Es obligación del Gobierno Municipal dar la más amplia y pronta difusión a esta Carta\nOrgánica, especialmente en las instituciones educativas. El no cumplimiento de esta obligación será considerado mal\ndesempeño del cargo.\n\n",
      "co:inicioCaracter": 161755,
      "co:finCaracter": 161994,
      "co:marcadorDisposicion": "DECIMOPRIMERA: ",
      "co:caracteresTexto": 224
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/12",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "DECIMOSEGUNDA",
      "position": 12,
      "text": "Esta Carta Orgánica, firmada por la Presidenta de la Convención Constituyente Municipal,\nlos Vicepresidentes,  los Convencionales que deseen hacerlo y las Secretarias, deberá remitirse, junto a todos los\ndocumentos producidos por este Cuerpo, al Archivo Municipal para su preservación. Igualmente se envían copias\nautenticadas al Intendente, al Concejo de Representantes y al Tribunal de Cuentas,  para su cumplimiento y\ndifusión, como así también otro testimonio certificado al Gobierno de la Provincia de Córdoba.\n\n",
      "co:inicioCaracter": 161994,
      "co:finCaracter": 162526,
      "co:marcadorDisposicion": "DECIMOSEGUNDA: ",
      "co:caracteresTexto": 517
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/13",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "DECIMOTERCERA",
      "position": 13,
      "text": "La Convención Constituyente Municipal convoca al pueblo de la Ciudad de Villa Carlos Paz\na jurar esta Carta Orgánica el día 25 de Mayo de 2008.\n\n",
      "co:inicioCaracter": 162526,
      "co:finCaracter": 162686,
      "co:marcadorDisposicion": "DECIMOTERCERA: ",
      "co:caracteresTexto": 145
    },
    {
      "@id": "urn:ar:villa-carlos-paz:carta-organica:2007/disposicion-transitoria/14",
      "@type": "co:Disposicion",
      "co:claseDisposicion": "disposicion-transitoria",
      "name": "DECIMOCUARTA",
      "position": 14,
      "text": "Acatando  la voluntad  popular,  prestados y  recibidos  los juramentos y cumplidas  las\ncomunicaciones y actos propios del Cuerpo, esta Convención queda disuelta.\n\nDADA EN LA SALA DE SESIONES DE LA CONVENCIÓN MUNICIPAL, EN LA CIUDAD DE VILLA\nCARLOS PAZ, A LOS VEINTISIETE DÍAS DEL MES DE NOVIEMBRE DEL AÑO DOS MIL SIETE.\n",
      "co:inicioCaracter": 162686,
      "co:finCaracter": 163022,
      "co:marcadorDisposicion": "DECIMOCUARTA: ",
      "co:caracteresTexto": 322
    }
  ],
